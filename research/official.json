  "milestones": [
    {
      "date": "2024-07",
      "title": "The reveal",
      "text": "At Marvel Studios' Hall H panel at San Diego Comic-Con, Kevin Feige announced that the Russo brothers would direct Avengers: Doomsday and Avengers: Secret Wars. Robert Downey Jr. stepped out from a line of green-cloaked figures as Victor von Doom. The film was then dated May 2026.",
      "source": "S_SDCC24"
    },
    {
      "date": "2025-03-26",
      "title": "The roll call",
      "text": "With no warning, Marvel Studios began a livestream that revealed the cast one director's chair at a time for more than five hours. It named 27 cast members and marked the start of production. Marvel called it its biggest livestream ever.",
      "source": "S_LIVE"
    },
    {
      "date": "2025-12-23",
      "title": "Steve Rogers will return",
      "text": "The first teaser revealed Chris Evans returning as Steve Rogers.",
      "source": "S_TEASERS"
    },
    {
      "date": "2025-12-30",
      "title": "Thor will return",
      "text": "The second teaser spotlighted Chris Hemsworth as Thor.",
      "source": "S_TEASERS"
    },
    {
      "date": "2026-01-06",
      "title": "The X-Men will return",
      "text": "The third teaser featured Patrick Stewart as Professor X, Ian McKellen as Magneto and James Marsden as Cyclops.",
      "source": "S_TEASERS"
    },
    {
      "date": "2026-01-13",
      "title": "Wakanda and the Fantastic Four",
      "text": "The fourth teaser featured Letitia Wright as Shuri, Winston Duke as M'Baku, Tenoch Huerta Mejia as Namor and Ebon Moss-Bachrach as the Thing.",
      "source": "S_TEASERS"
    },
    {
      "date": "2026-07-20",
      "title": "The official trailer",
      "text": "Marvel Studios released the official trailer and opened Infinity Vision ticket sales for December 18.",
      "source": "S_TRAILER"
    },
    {
      "date": "2026-07-25",
      "title": "Hall H, again",
      "text": "The cast returned to Hall H at San Diego Comic-Con. The whole hall wore Doom masks and capes and turned green as Downey spoke.",
      "source": "S_SDCC26"
    },
    {
      "date": "2026-08-14",
      "title": "A special look",
      "text": "At D23, Downey, Chris Evans and Hayley Atwell unveiled a special look. Marvel confirmed that Evans and Atwell return as Steve Rogers and Peggy Carter.",
      "source": "S_D23"
    },
    {
      "date": "2026-12-18",
      "title": "Doomsday",
      "text": "Avengers: Doomsday opens in theaters.",
      "source": "S_FILM"
    }
  ],

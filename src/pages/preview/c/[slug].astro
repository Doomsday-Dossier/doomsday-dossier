  @media (max-width: 600px) { .dd-line li, .log li { grid-template-columns: 1fr; gap: 4px; } }
  .next-file { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: var(--s-5); padding: var(--s-9) 0 var(--s-8); background: var(--gunmetal); }
  .nf { display: grid; gap: 8px; padding: var(--s-6); border: 1px solid var(--iron); text-decoration: none; transition: border-color var(--d-s); }

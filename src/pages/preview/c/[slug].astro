---
// A classified file, design system v2: one template for all 29 characters (Doom's file was the approved
// showcase). Chapters: hero (the subject in front of their name), the file opening, the subject (particle
// figure with callouts), exhibits, origin, the comics record, sightings on screen, what Marvel confirmed,
// and the next file.
import Dossier from '../../../layouts/Dossier.astro';
import '../../../styles/faces';
import { DESIGN, getResearch, castFor, publishedOrder, TEAMS, OFFICIAL, SRC, Citer, u, fmtDate, heroName } from '../../../data/site';
import { PHOTO_CREDIT } from '../../../data/photos';
import { accentOf, photos2For, pick2, srcset2, figureFor, anchorsFor } from '../../../data/v2';

const VS = import.meta.glob('../../../../research/versus/*.json', { eager: true, import: 'default' }) as Record<string, any>;

export function getStaticPaths() {
  return publishedOrder().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: string };
const d = DESIGN[slug];
const r = getResearch(slug)!;
const c = castFor(slug)!;
const vs = VS[`../../../../research/versus/${slug}.json`];
const team = TEAMS.find((t) => t.id === c.team)!;
const order = publishedOrder();
const no = order.indexOf(slug) + 1;
const next = order[no % order.length];
const isDoom = slug === 'victor-von-doom';
const accent = accentOf(slug);
const ph = photos2For(slug);
const fa = r.origin.firstAppearance;
const name = heroName(slug).toUpperCase();
const pad = (n: number) => String(n).padStart(2, '0');
const sup = (nums: number[], anchor: string) => nums.map((n) => `<sup class="cite"><a href="#${anchor}">${n}</a></sup>`).join('');
const EVENT: Record<string, string> = { S_SDCC24: 'Comic-Con 2024', S_TEASERS: 'a Doomsday teaser', S_TRAILER: 'the official trailer', S_SDCC26: 'Comic-Con 2026', S_D23: 'D23 2026', S_LIVE: 'the March 2025 cast reveal' };
const named = !!(c.character && c.roleSource);

// I. the file sheet: Marvel's confirmation and the first appearance
const cFile = new Citer();
const nRole = cFile.cite([SRC[named ? c.roleSource! : 'S_LIVE']])[0];
const roleLine = named ? `${c.actor}, named by Marvel as ${c.character}` : `Marvel lists ${c.actor} in the cast; the role is not yet named`;
const faNum = fa.issue.replace('#', '');
const faSrc = r.origin.sources.find((x) => x.label.includes(fa.title.split(':')[0]) && new RegExp(`(\\b|#)${faNum}\\b`).test(x.label)) ?? r.origin.sources[0];
const nFa = cFile.cite([faSrc])[0];
const nFilm = cFile.cite([SRC.S_FILM])[0];
const nAbil = vs.abilities[0] ? cFile.cite(vs.abilities[0].sources)[0] : null;
const aliasLine = isDoom ? `${r.alias} · Monarch of Latveria` : r.alias && r.alias.toUpperCase() !== name ? `${r.alias} · ${team.name}` : team.name;
const stampBig = isDoom ? 'Adversary' : named ? 'Named' : 'In the cast';
const stampSmall = named ? `Role named by Marvel · ${EVENT[c.roleSource!] ?? 'Marvel'}` : 'Marvel cast list · March 2025';

// II. the subject: callouts pinned to points on the lead photo (u, v from its top-left), and key traits
const cSub = new Citer();
const A = anchorsFor(slug);
const sdcc26 = OFFICIAL.milestones.find((m) => m.source === 'S_SDCC26');
const ab = vs.abilities as { name: string; detail: string; sources: { label: string; url: string }[] }[];
const callouts = (isDoom ? [
  { u: 0.5, v: 0.5, k: 'The mask', t: 'Forged by the monks who trained him, and pressed to his face before it had cooled.', n: cSub.cite([r.origin.sources[0], r.origin.sources[3]]) },
  { u: 0.53, v: 0.62, k: 'Beneath it', t: 'A scar from his own exploding machine at State University, which his pride turned into ruin.', n: cSub.cite([r.origin.sources[0]]) },
  { u: 0.36, v: 0.42, k: 'The green', t: sdcc26 ? 'His cloak colour: at Comic-Con 2026 Marvel turned all of Hall H green, in Doom masks and capes.' : 'His cloak colour since the comics began.', n: sdcc26 ? cSub.cite([SRC.S_SDCC26]) : cSub.cite([r.origin.sources[1]]) },
  { u: 0.71, v: 0.88, k: 'The armour', t: ab[2].detail, n: cSub.cite(ab[2].sources) },
] : [
  { u: A[0][0], v: A[0][1], k: 'First seen', t: `${fa.title} ${fa.issue}, cover date ${fa.coverDate}. Created by ${r.origin.creators.join(' and ')}.`, n: cSub.cite([faSrc]) },
  ab[0] && { u: A[1][0], v: A[1][1], k: ab[0].name, t: ab[0].detail, n: cSub.cite(ab[0].sources) },
  ab[1] && { u: A[2][0], v: A[2][1], k: ab[1].name, t: ab[1].detail, n: cSub.cite(ab[1].sources) },
  vs.powerOrigins[0] && { u: A[3][0], v: A[3][1], k: 'Power source', t: vs.powerOrigins[0].detail, n: cSub.cite(vs.powerOrigins[0].sources) },
]).filter(Boolean) as { u: number; v: number; k: string; t: string; n: number[] }[];
const grid = vs.powerGrid?.values as Record<string, number> | null;
const gridLabels: Record<string, string> = { intelligence: 'Intelligence', strength: 'Strength', speed: 'Speed', durability: 'Durability', energyProjection: 'Energy projection', fightingSkills: 'Fighting skills' };
const nGrid = grid && vs.powerGrid.source ? cSub.cite([vs.powerGrid.source])[0] : null;
const abilities = ab.map((a) => ({ ...a, n: cSub.cite(a.sources) }));

// III to V: origin, the comics record, sightings on screen
const cOrigin = new Citer(); const originNums = cOrigin.cite(r.origin.sources);
const cComics = new Citer(); const comics = r.comics.map((e) => ({ ...e, nums: cComics.cite(e.sources) }));
const cScreen = new Citer(); const screen = [...r.screen].sort((a, b) => a.year - b.year).map((s) => ({ ...s, nums: cScreen.cite(s.sources) }));
const keyRows = isDoom
  ? [{ k: 'Real name', v: r.name }, { k: 'Alias', v: r.alias }, { k: 'Rules', v: 'Latveria, from Doomstadt', n: originNums.slice(0, 1) }]
  : [{ k: 'Real name', v: r.name }, { k: 'Alias', v: r.alias }, { k: 'Team', v: team.name }, { k: 'In Doomsday', v: c.actor }];

// VI: only what Marvel confirmed
const cDoom = new Citer();
const dFilm = cDoom.cite([SRC.S_FILM])[0];
const dRole = named ? cDoom.cite([SRC[c.roleSource!]])[0] : null;
const surname = c.actor.replace(/ Jr\.$/, '').split(' ').slice(-1)[0];
const wordRe = new RegExp(`\\b${surname}\\b`);
const mentions = OFFICIAL.milestones.filter((m) => m.text.includes(c.actor) || (c.character && m.text.includes(c.character)) || wordRe.test(m.text)).map((m) => ({ ...m, num: cDoom.cite([SRC[m.source]])[0] }));
const lastScreen = [...r.screen].filter((x) => x.actor.startsWith(c.actor)).sort((a, b) => b.year - a.year)[0];

// photos (HD and cut-outs) and the figure
const lead = ph[0], p2 = ph[1], p3 = ph[2];
const figure = figureFor(slug);
const lensSrc = lead ? pick2(lead.full, 1920) : '';
const heroCut = lead && lead.cut.length ? lead.cut : null;
// the name on the hero: two balanced lines when it has several words, sized by the longer line
const heroLines = (() => { const w = name.split(' '); let best = [name]; for (let i = 1; i < w.length; i++) { const l = [w.slice(0, i).join(' '), w.slice(i).join(' ')]; if (best.length === 1 || Math.max(...l.map((x) => x.length)) < Math.max(...best.map((x) => x.length))) best = l; } return best; })();
const longest = Math.max(...heroLines.map((l) => l.length));
const nextPh = photos2For(next)[0];
const files = order.map((x, i) => ({ slug: x, no: i + 1, name: heroName(x).toUpperCase(), accent: accentOf(x) }));
const styleVars = `--sig:${d.font};--sig-w:${d.fontWeight};--forged:${isDoom ? '#5c5f58' : accent};--longest:${longest}`;
---
<Dossier title={`${name}: classified file (design preview)`} description={`Design preview: the classified file on ${heroName(slug)}, opened.`} page="file" accent={accent} styleVars={styleVars}>
  <div class="tint" data-tint aria-hidden="true"></div>
  <article class="file" data-file data-slug={slug} data-scene={d.scene} data-fig={JSON.stringify(figure)} data-lens={lensSrc}>

    <!-- 0. THE SUBJECT, IN FRONT OF THEIR NAME (Obsidian, Lena Varga) -->
    <section class="hero" data-hero aria-label={`${name}, file ${pad(no)}`}>
      <div class="hero-stage">
        <div class="hero-flood" data-flood aria-hidden="true"></div>
        <div class="hero-top t-label">
          <span class="t-accent" data-hin>File {pad(no)} / {order.length}</span>
          <span data-hin>{team.name}</span>
          <span class="t-ash" data-hin>{named ? 'Role named by Marvel' : 'In the cast'}</span>
        </div>
        <p class="hero-name" data-hero-name data-fit aria-hidden="true">{heroLines.map((l) => <Fragment><span class="hw">{l}</span>{' '}</Fragment>)}</p>
        {lead && <div class={heroCut ? 'hero-subj' : 'hero-subj soft'}>{heroCut
          ? <img class="hero-cut" data-hero-cut style={`translate:${Math.round((0.5 - (lead.head?.[0] ?? 0.5)) * 1000) / 10}% 0`} src={pick2(heroCut, 1280)} srcset={srcset2(heroCut)} sizes="(min-width: 900px) 60vw, 100vw" width={lead.w} height={lead.h} alt="" fetchpriority="high" decoding="async" />
          : <img class="hero-cut hero-soft" data-hero-cut src={pick2(lead.full, 1280)} srcset={srcset2(lead.full)} sizes="100vw" width={lead.w} height={lead.h} alt="" fetchpriority="high" decoding="async" style={`object-position:${lead.focusM}`} />}</div>}
        <div class="hero-foot">
          <p class="t-label t-ash" data-hin>{aliasLine}</p>
          <p class="t-label hero-cue" data-hin>Scroll to open the file</p>
        </div>
      </div>
    </section>

    <!-- I. THE FILE OPENS -->
    <section class="open" data-open aria-labelledby="f-name">
      <div class="open-stage">
        <div class="folder" data-folder>
          <div class="sheet" data-sheet>
            <div class="sheet-head t-micro">
              <span>Latverian state archive</span><span>File {pad(no)} / {order.length}</span><span class="t-accent">Clearance: Omega</span>
            </div>
            <p class="t-label t-ash sheet-k">Subject</p>
            <h1 id="f-name" class="sig-name" data-fit>{name}</h1>
            <p class="t-label t-accent sheet-alias">{aliasLine}</p>
            <ul class="traits sheet-rows">
              <li><span class="k">In Doomsday</span><span class="v"><span class="redact">{roleLine}<Fragment set:html={sup([nRole], 'src-file')} /><span class="bar" data-bar></span></span></span></li>
              <li><span class="k">First appearance</span><span class="v"><span class="redact">{fa.title} {fa.issue}, cover date {fa.coverDate}<Fragment set:html={sup([nFa], 'src-file')} /><span class="bar" data-bar></span></span></span></li>
              <li><span class="k">Created by</span><span class="v"><span class="redact">{r.origin.creators.join(' and ')}<Fragment set:html={sup([nFa], 'src-file')} /><span class="bar" data-bar></span></span></span></li>
              <li><span class="k">Abilities</span><span class="v"><span class="redact">{ab.slice(0, 3).map((a) => a.name).join(' · ')}{nAbil && <Fragment set:html={sup([nAbil], 'src-file')} />}<span class="bar" data-bar></span></span></span></li>
              <li><span class="k">Status</span><span class="v"><span class="redact">Confirmed for Avengers: Doomsday, in theaters {fmtDate(OFFICIAL.film.releaseDate)}<Fragment set:html={sup([nFilm], 'src-file')} /><span class="bar" data-bar></span></span></span></li>
            </ul>
          </div>
          {[p2, p3].filter(Boolean).map((p, i) => <figure class={`print fp${i + 1}`} data-print><img src={pick2(p!.full, 640)} srcset={srcset2(p!.full)} sizes="(min-width: 900px) 20vw, 34vw" alt={`${heroName(slug)}, exhibit ${pad(no)}-${i ? 'C' : 'B'}`} width={p!.w} height={p!.h} loading="lazy" style={`object-position:${p!.focusM}`} /><figcaption>Exhibit {pad(no)}-{i ? 'C' : 'B'}</figcaption></figure>)}
          <div class="stamp-at"><span class="stamp" data-stamp><b>{stampBig}</b><small>{stampSmall}</small></span></div>
          <div class="cover" data-cover aria-hidden="true">
            <div class="cover-face">
              <span class="cover-tab t-label">File {pad(no)}</span>
              <div class="cover-top t-micro"><span>Property of the Latverian state</span><span>Do not remove from the archive</span></div>
              <p class="cover-name">{name}</p>
              <div class="cover-bottom">
                <span class="t-label t-accent">Top secret &middot; Omega</span>
                <span class="t-micro t-ash">{team.name} &middot; {r.alias}</span>
              </div>
              <i class="rivet r1"></i><i class="rivet r2"></i><i class="rivet r3"></i><i class="rivet r4"></i>
            </div>
            <div class="cover-back"></div>
          </div>
        </div>
        <p class="open-hint t-label t-ash" data-hint>Scroll to open the file</p>
      </div>
      <details class="sources wrap file-src" id="src-file"><summary>File sources ({cFile.list.length})</summary>
        <ol>{cFile.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
      </details>
    </section>

    <!-- II. THE SUBJECT -->
    <section class="subject" data-subject aria-labelledby="sub-h">
      <div class="sub-pin" data-sub-pin><div class="sub-stage">
        <div class="fig-space" data-fig-space aria-hidden="true"></div>
        <header class="sub-head">
          <p class="t-label t-accent">II &middot; The subject</p>
          <h2 id="sub-h" class="t-title chap" data-fit data-rise>Under the hood</h2>
        </header>
        <ol class="callouts" data-callouts>
          {callouts.map((k, i) => (
            <li class="callout" data-callout data-u={k.u} data-v={k.v}>
              <i class="lead" data-lead aria-hidden="true"></i>
              <span class="t-micro t-accent">0{i + 1} &middot; {k.k}</span>
              <span class="cal-t"><Fragment set:html={k.t + sup(k.n, 'src-sub')} /></span>
            </li>
          ))}
        </ol>
        <aside class="key" data-key aria-label="Key traits">
          <p class="t-label t-ash">Key traits</p>
          <ul class="traits">
            {keyRows.map((k) => <li><span class="k">{k.k}</span><span class="v">{k.v}{k.n && <Fragment set:html={sup(k.n, 'src-origin')} />}</span></li>)}
          </ul>
          {grid ? (
            <>
              <p class="t-label t-ash key-k">Power grid, 1 to 7{nGrid && <Fragment set:html={sup([nGrid], 'src-sub')} />}</p>
              <ul class="grid-bars">
                {Object.entries(grid).map(([k, v]) => (
                  <li><span class="t-micro">{gridLabels[k] ?? k}</span><span class="gb" aria-label={`${v} of 7`}><i data-bar-w style={`--v:${v / 7}`}></i></span><b class="t-type">{v}</b></li>
                ))}
              </ul>
              <p class="t-micro t-ash grid-note">Comics stats, as published on Marvel.com&rsquo;s Marvel Universe wiki.</p>
            </>
          ) : (
            <p class="t-label t-ash key-k">Not rated in the Handbook</p>
          )}
        </aside>
        <div class="lens" data-lens-el aria-hidden="true"><i></i></div>
      </div></div>
      <div class="wrap sub-more">
        <h3 class="t-label t-accent">Abilities on file</h3>
        <ul class="abil">
          {abilities.map((a) => <li data-reveal><b class="t-title">{a.name}</b><span><Fragment set:html={a.detail + sup(a.n, 'src-sub')} /></span></li>)}
        </ul>
        <details class="sources" id="src-sub"><summary>Subject sources ({cSub.list.length})</summary>
          <ol>{cSub.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
        </details>
      </div>
    </section>

    <!-- EXHIBITS (Oyla): the prints come toward you as you scroll -->
    {ph.length > 0 && (
      <section class="exhibits wrap" data-exhibits aria-labelledby="ex-h">
        <p class="t-label t-accent">Exhibits</p>
        <h2 id="ex-h" class="t-title chap" data-fit data-rise>{ph.length} prints on file</h2>
        <div class="ex-grid">
          {ph.map((p, i) => (
            <figure class={`ex ex${i + 1}`} data-ex>
              <div class="ex-frame"><img src={pick2(p.full, 1280)} srcset={srcset2(p.full)} sizes="(min-width: 900px) 46vw, 92vw" width={p.w} height={p.h} alt={`${heroName(slug)}, exhibit ${pad(no)}-${'ABC'[i]}`} loading="lazy" decoding="async" style={`object-position:${p.focusM}`} /></div>
              <figcaption class="t-micro"><span class="t-accent">Exhibit {pad(no)}-{'ABC'[i]}</span><span class="t-ash">{p.hd ? 'Enhanced print' : 'Original print'} &middot; {p.w} &times; {p.h}</span></figcaption>
            </figure>
          ))}
        </div>
        <p class="t-micro t-ash ex-credit">{PHOTO_CREDIT}</p>
      </section>
    )}

    <!-- III. ORIGIN -->
    <section class="chapter-sec wrap" aria-labelledby="or-h">
      <p class="t-label t-accent">III &middot; Origin</p>
      <h2 id="or-h" class="t-title chap" data-fit data-rise>Where it began</h2>
      <div class="or-grid">
        <aside class="fa" data-reveal>
          <p class="t-micro t-ash">First appearance</p>
          <p class="fa-t t-title">{fa.title} {fa.issue}</p>
          <p class="t-label">Cover date {fa.coverDate}</p>
          <p class="t-micro t-ash" style="margin-top:18px">Created by</p>
          <p class="t-label">{r.origin.creators.join(', ')}</p>
        </aside>
        <div class="prose">
          {r.origin.summary.map((p, i) => <p data-reveal set:html={p + (i === r.origin.summary.length - 1 ? sup(originNums, 'src-origin') : '')} />)}
        </div>
      </div>
      <details class="sources" id="src-origin"><summary>Origin sources ({cOrigin.list.length})</summary>
        <ol>{cOrigin.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
      </details>
    </section>

    <!-- IV. THE COMICS RECORD -->
    <section class="chapter-sec wrap" aria-labelledby="rec-h">
      <p class="t-label t-accent">IV &middot; The comics record</p>
      <h2 id="rec-h" class="t-title chap" data-fit data-rise>{comics.length} reports, {comics[0].years.slice(0, 4)} to {comics[comics.length - 1].years.slice(-4)}</h2>
      <ol class="reports">
        {comics.map((e, i) => (
          <li class="report" data-report>
            <div class="rep-years t-title">{e.years}</div>
            <div class="rep-body">
              <p class="t-micro t-accent">Report {pad(i + 1)} &middot; {e.era}</p>
              <h3 class="rep-t">{e.title}</h3>
              <p set:html={e.summary + sup(e.nums, 'src-comics')} />
              <p class="t-micro t-ash rep-k">Key issues: {e.keyIssues.join(' · ')}</p>
            </div>
          </li>
        ))}
      </ol>
      <details class="sources" id="src-comics"><summary>Comics sources ({cComics.list.length})</summary>
        <ol>{cComics.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
      </details>
    </section>

    <!-- V. SIGHTINGS ON SCREEN -->
    <section class="chapter-sec wrap" aria-labelledby="sig-h">
      <p class="t-label t-accent">V &middot; Sightings on screen</p>
      <h2 id="sig-h" class="t-title chap" data-fit data-rise>{screen.length} live-action sightings</h2>
      <ol class="log">
        {screen.map((s) => (
          <li data-reveal>
            <span class="log-y t-title">{s.year}</span>
            <span class="log-main">
              <span class="log-tags t-micro"><span class="tag">{s.continuity}</span>{s.cameo && <span class="tag">Cameo</span>}</span>
              <b class="log-t">{s.title}</b>
              <span class="t-micro t-ash">Performer: {s.actor}</span>
              <span class="log-s" set:html={s.summary + sup(s.nums, 'src-screen')} />
            </span>
          </li>
        ))}
      </ol>
      <details class="sources" id="src-screen"><summary>Screen sources ({cScreen.list.length})</summary>
        <ol>{cScreen.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
      </details>
    </section>

    <!-- VI. CONFIRMED FOR DOOMSDAY -->
    <section class="chapter-sec wrap doom-sec" aria-labelledby="dd-h">
      <p class="t-label t-accent">VI &middot; In Avengers: Doomsday</p>
      <h2 id="dd-h" class="t-title chap" data-fit data-rise>What Marvel has confirmed</h2>
      <p class="t-ash">Only what Marvel has announced. No rumours, no leaks, no guesses.</p>
      <div class="dd-grid">
        <div data-reveal><p class="t-micro t-ash">Cast</p><p class="dd-big t-title">{c.actor}</p><p set:html={`Marvel lists ${c.actor} in the cast.${sup([dFilm], 'src-doom')}`} /></div>
        {named ? (
          <div data-reveal><p class="t-micro t-ash">Role</p><p class="dd-big t-title">{c.character}</p><p set:html={`Named by Marvel in ${EVENT[c.roleSource!] ?? 'an announcement'}.${sup([dRole!], 'src-doom')}`} /></div>
        ) : (
          <div data-reveal><p class="t-micro t-ash">Role</p><p class="dd-big t-title">Not yet named</p><p>Marvel has not said which character {c.actor} plays.{lastScreen && c.lastRole && <> For context only: the most recent released role for {c.actor} was {c.lastRole} in {lastScreen.title} ({lastScreen.year}).</>}</p></div>
        )}
        <div data-reveal><p class="t-micro t-ash">Release</p><p class="dd-big t-title">{fmtDate(OFFICIAL.film.releaseDate)}</p><p class="t-type dd-count" data-mini-count>00d 00h 00m 00s</p></div>
      </div>
      <ol class="dd-line">
        {mentions.map((m) => <li data-reveal><span class="t-micro t-accent">{fmtDate(m.date)}</span><span><b>{m.title}.</b> <Fragment set:html={m.text + sup([m.num], 'src-doom')} /></span></li>)}
      </ol>
      <details class="sources" id="src-doom"><summary>Marvel sources ({cDoom.list.length})</summary>
        <ol>{cDoom.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
      </details>
    </section>

    <nav class="voyage" data-voyage aria-label="Other files" style={`--na:${accentOf(next)}`}>
      <div class="voy-stage">
        {nextPh && <img class="voy-bg" src={pick2(nextPh.full, 1920)} srcset={srcset2(nextPh.full)} sizes="100vw" width={nextPh.w} height={nextPh.h} alt="" loading="lazy" decoding="async" style={`object-position:${nextPh.focus}`} data-voy-bg />}
        <ol class="voy-list t-micro" aria-label="All files">
          {files.map((f) => <li class={f.slug === slug ? 'here' : f.slug === next ? 'next' : ''} style={`--fa:${f.accent}`}><a href={u(`/preview/c/${f.slug}/`)} aria-current={f.slug === slug ? 'page' : undefined}><i></i>{f.name}</a></li>)}
        </ol>
        <a class="voy-window" href={u(`/preview/c/${next}/`)} data-voy-window>
          {nextPh && <img src={pick2(nextPh.cut.length ? nextPh.cut : nextPh.full, 1280)} alt="" loading="lazy" decoding="async" style={`object-position:${nextPh.focusM}`} class={nextPh.cut.length ? 'cut' : ''} />}
          <span class="voy-cap t-micro">Next file &middot; {pad((no % order.length) + 1)}</span>
        </a>
        <div class="voy-name">
          <p class="t-label t-ash">Open the next file</p>
          <a class="voy-big t-title" href={u(`/preview/c/${next}/`)} data-fit>{heroName(next).toUpperCase()}</a>
          <a class="t-label voy-back" href={u('/preview/')}>&larr; Back to the archive</a>
        </div>
      </div>
      <p class="t-micro t-ash credit wrap">{PHOTO_CREDIT}</p>
    </nav>
  </article>
</Dossier>

<style>

  /* 0. hero: the subject in front of their name */
  .hero { position: relative; height: 190vh; }
  .hero-stage { position: sticky; top: 0; height: 100svh; overflow: hidden; display: grid; place-items: center; }
  .hero-flood { position: absolute; left: 50%; top: 55%; width: 160vmax; height: 160vmax; margin: -80vmax 0 0 -80vmax; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 46%, #0d1012) 0%, color-mix(in srgb, var(--accent) 22%, #0d1012) 38%, #0d1012 70%); transform: scale(1); }
  .hero-top { position: absolute; left: var(--margin); right: var(--margin); top: calc(var(--header-h) + 8px); display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; z-index: 3; }
  .hero-name { position: absolute; left: var(--margin); right: var(--margin); top: 50%; transform: translateY(-58%); margin: 0; text-align: center; font-family: var(--sig); font-weight: var(--sig-w); text-transform: uppercase; line-height: 0.86; letter-spacing: 0.01em; color: color-mix(in srgb, var(--bone) 92%, var(--accent)); font-size: min(30vw, calc((100vw - 2 * var(--margin)) / (var(--longest) * 0.72))); z-index: 1; }
  .hero-name .hw { display: block; }
  .hero-subj { position: absolute; inset: 0; z-index: 2; display: flex; justify-content: center; align-items: flex-end; pointer-events: none; }
  .hero-cut { flex: none; height: min(92svh, 120vw); width: auto; max-width: none; transform-origin: 50% 100%; }
  .hero-subj.soft .hero-cut { width: 100%; height: 100%; object-fit: cover; -webkit-mask-image: radial-gradient(ellipse at 50% 45%, #000 35%, transparent 72%); mask-image: radial-gradient(ellipse at 50% 45%, #000 35%, transparent 72%); }
  .hero-foot { position: absolute; left: var(--margin); right: var(--margin); bottom: var(--s-6); display: flex; justify-content: space-between; align-items: end; gap: 12px; flex-wrap: wrap; z-index: 3; }
  .hero-foot p { margin: 0; text-shadow: 0 1px 12px rgba(0, 0, 0, 0.8); }
  .hero-cue { color: var(--accent); }
  @media (max-width: 760px) { .hero-cut { height: 78svh; } .hero-subj.soft .hero-cut { height: 100%; } .hero-name { top: 27%; } }

  /* exhibits: the prints grow toward you as you scroll */
  .exhibits { position: relative; z-index: 2; padding: var(--s-10) 0 var(--s-8); background: var(--gunmetal); }
  .ex-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s-6); margin-top: var(--s-7); align-items: start; }
  .ex { margin: 0; }
  .ex1 { grid-column: 1 / -1; }
  .ex3 { margin-top: var(--s-9); }
  .ex-frame { overflow: hidden; border: 1px solid var(--iron); background: var(--gunmetal-2); }
  .ex-frame img { width: 100%; height: auto; transform-origin: 50% 50%; will-change: transform; }
  .ex figcaption { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-top: 10px; }
  .ex-credit { margin: var(--s-5) 0 0; }
  @media (max-width: 700px) { .ex-grid { grid-template-columns: minmax(0, 1fr); } .ex3 { margin-top: 0; } }

  /* next file: a window into the next world */
  .voyage { position: relative; z-index: 2; background: var(--gunmetal); }
  .voy-stage { position: relative; height: 100svh; min-height: 620px; overflow: hidden; display: grid; place-items: center; }
  .voy-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.38; filter: saturate(0.8); transform: scale(1.08); }
  .voy-stage::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 50%, transparent 20%, #0d1012 85%), linear-gradient(to right, rgba(13, 16, 18, 0.85), transparent 40%); pointer-events: none; }
  .voy-list { position: absolute; z-index: 2; left: var(--margin); top: 50%; transform: translateY(-50%); list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, auto); gap: 0 20px; }
  .voy-list a { display: flex; align-items: center; gap: 10px; padding: 3px 0; text-decoration: none; color: var(--ash); transition: color var(--d-s); }
  .voy-list a i { width: 6px; height: 6px; border-radius: 50%; border: 1px solid var(--fa); }
  .voy-list a:hover, .voy-list .next a { color: var(--bone); }
  .voy-list .here a { color: var(--accent); }
  .voy-list .here a i, .voy-list .next a i { background: var(--fa); }
  .voy-window { position: relative; z-index: 2; width: min(34vw, 420px); aspect-ratio: 4 / 5; border-radius: 40px; overflow: hidden; border: 1px solid color-mix(in srgb, var(--na) 60%, transparent); box-shadow: 0 0 0 10px rgba(13, 16, 18, 0.5); background: radial-gradient(circle at 50% 70%, color-mix(in srgb, var(--na) 45%, #0d1012), #0d1012 75%); display: block; }
  .voy-window img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); transition: transform 0.9s var(--e-reveal); }
  .voy-window img.cut { object-fit: contain; object-position: 50% 100% !important; inset: auto 0 0 0; height: 92%; }
  .voy-window:hover img { transform: scale(1.2); }
  .voy-cap { position: absolute; left: 16px; bottom: 14px; z-index: 2; color: var(--bone); }
  .voy-name { position: absolute; z-index: 2; right: var(--margin); bottom: var(--s-7); text-align: right; display: grid; gap: 8px; max-width: 46vw; }
  .voy-name p { margin: 0; }
  .voy-big { font-size: var(--t-1); font-weight: 900; text-decoration: none; color: var(--bone); line-height: 0.86; }
  .voy-big:hover { color: var(--na); }
  .voy-back { color: var(--ash); text-decoration: none; }
  .credit { padding: var(--s-5) 0 var(--s-7); margin: 0; }
  @media (max-width: 760px) {
    .voy-stage { height: auto; min-height: 0; padding: var(--s-9) var(--margin) var(--s-7); display: grid; gap: var(--s-6); place-items: start center; }
    .voy-window { width: 70vw; }
    .voy-list { position: relative; left: 0; top: 0; transform: none; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px 14px; max-height: none; width: 100%; order: 3; }
    .voy-name { position: relative; right: 0; bottom: 0; text-align: left; max-width: 100%; width: 100%; }
  }
  .tint { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 40%, color-mix(in srgb, var(--forged) 38%, #0d1012), #0d1012 75%); opacity: 0; }
  .file { position: relative; }
  .sig-name { font-family: var(--sig); font-weight: var(--sig-w); text-transform: uppercase; letter-spacing: 0.02em; line-height: 0.92; margin: 0; font-size: clamp(40px, 6.4vw, 104px); }

  /* I. the folder */
  .open { position: relative; height: 340vh; }
  .open-stage { position: sticky; top: 0; height: 100svh; display: grid; place-items: center; perspective: 1800px; padding-top: calc(var(--header-h) - 10px); overflow-x: clip; }
  .folder { position: relative; width: min(1080px, 90vw); height: min(80svh, 680px); transform-style: preserve-3d; }
  @media (min-width: 761px) and (max-height: 860px) {
    /* short laptop screens: a tighter sheet so every fact fits */
    .sig-name { font-size: clamp(36px, 4.6vw, 76px); }
    .sheet { gap: 6px; padding-top: 22px; }
    .sheet-head { padding-bottom: 8px; margin-bottom: 4px; }
    .sheet-rows li { padding: 7px 0; }
  }
  .sheet { position: absolute; inset: 0; background: linear-gradient(160deg, #1a1f22, #121618 70%); border: 1px solid var(--iron-2); border-radius: var(--r); padding: clamp(18px, 3vw, 40px); padding-right: clamp(18px, 37%, 400px); display: grid; align-content: start; gap: 10px; overflow: hidden; }
  .sheet::before { content: ''; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(transparent 0 31px, rgba(231, 228, 220, 0.035) 31px 32px); }
  .sheet-head { display: flex; flex-wrap: wrap; gap: 6px 22px; color: var(--ash); padding-bottom: 12px; border-bottom: 1px solid var(--iron-2); margin-bottom: 10px; }
  .sheet-k { margin: 6px 0 0; }
  .sheet-alias { margin: 0 0 8px; }
  .sheet-rows .v { font-size: clamp(14px, 1.2vw, 17px); }
  .sheet-rows .redact { display: block; }
  .print { position: absolute; width: clamp(130px, 20vw, 250px); aspect-ratio: 4 / 3; }
  .print img { aspect-ratio: 4 / 3; height: auto; }
  .fp1 { right: 3%; top: 7%; }
  .fp2 { right: 9%; top: 44%; }
  .stamp-at { position: absolute; right: 6%; bottom: 7%; }
  .stamp { font-size: clamp(14px, 1.6vw, 22px); }
  .stamp b { font-size: 1.5em; letter-spacing: 0.12em; }
  .stamp small { font-size: 0.5em; letter-spacing: 0.14em; }
  .cover { position: absolute; inset: -6px; transform-origin: 50% 0%; transform-style: preserve-3d; }

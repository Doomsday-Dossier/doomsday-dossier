  .tag { border: 1px solid var(--accent-soft); color: var(--accent); padding: 2px 8px; border-radius: 99px; }
  .log-s { color: var(--ash); max-width: 70ch; font-size: 15px; }
  .dd-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: var(--s-6); margin: var(--s-7) 0; }
  .dd-grid > div { border-top: 1px solid var(--accent); padding-top: var(--s-4); }
  .dd-grid p { margin: 0 0 6px; }
  .dd-big { font-size: var(--t-3); font-weight: 800; }
  .dd-count { color: var(--accent); font-size: 20px; }

---
import Dossier from '../../layouts/Dossier.astro';
import Photo from '../../components/Photo.astro';
import '../../styles/faces';
import { DESIGN, getResearch, publishedOrder, OFFICIAL, SRC, heroName, u, fmtDate } from '../../data/site';
import { photosFor, PHOTO_CREDIT } from '../../data/photos';
import { accentOf, photos2For, pick2 } from '../../data/v2';

type Src = { label: string; url: string };
type Who = { slug: string; actor?: string; cameo?: boolean; first?: boolean };
type Frame = { id: string; kind: 'debut' | 'screen' | 'era' | 'news' | 'release'; year: number; sort: number; title: string; sub: string; cont?: string; who: Who[]; text?: string; sources: Src[]; eraOf?: string };

const MONTHS = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];
const monthOf = (s: string) => { const i = MONTHS.findIndex((m) => s.toLowerCase().includes(m)); return i < 0 ? 6 : i + 1; };
const key = (t: string) => t.toLowerCase().replace(/[^a-z0-9]/g, '');
const issue = (s: string) => (s.startsWith('#') ? s : `#${s}`);

const slugs = publishedOrder();
const frames: Frame[] = [];
const screens = new Map<string, Frame>();
const firstScreen = new Map<string, string>();

for (const slug of slugs) {
  const r = getResearch(slug)!;
  const fa = r.origin.firstAppearance;
  const y = Number((fa.coverDate.match(/\d{4}/) || ['0'])[0]);
  frames.push({ id: `debut-${slug}`, kind: 'debut', year: y, sort: y * 1000 + monthOf(fa.coverDate) * 10, title: `${fa.title} ${issue(fa.issue)}`, sub: `${heroName(slug)} first appears`, who: [{ slug }], text: `Cover date ${fa.coverDate}. Created by ${r.origin.creators.join(', ')}.`, sources: r.origin.sources.slice(0, 2) });
  for (const e of r.comics) {
    const ey = Number((e.years.match(/\d{4}/) || ['0'])[0]);
    frames.push({ id: `era-${slug}-${key(e.title)}`, kind: 'era', year: ey, sort: ey * 1000 + 5, title: e.title, sub: `${heroName(slug)} in the comics, ${e.years}`, who: [{ slug }], text: e.summary.replace(/<[^>]+>/g, ''), sources: e.sources, eraOf: slug });
  }
  const mine = [...r.screen].sort((a, b) => a.year - b.year);
  for (const e of mine) {
    const k = key(e.title) + e.year;
    if (!screens.has(k)) screens.set(k, { id: `screen-${k}`, kind: 'screen', year: e.year, sort: e.year * 1000 + 600, title: e.title, sub: '', cont: e.continuity, who: [], sources: [] });
    const f = screens.get(k)!;
    const first = !firstScreen.has(slug);
    if (first) firstScreen.set(slug, k);
    f.who.push({ slug, actor: e.actor, cameo: e.cameo, first });
    for (const s of e.sources) if (!f.sources.some((x) => x.url === s.url)) f.sources.push(s);
  }
}
for (const f of screens.values()) { f.sub = `${f.who.length} of the Doomsday characters`; frames.push(f); }
for (const m of OFFICIAL.milestones) {
  const [yy, mm] = m.date.split('-').map(Number);
  const isRelease = m.date === OFFICIAL.film.releaseDate;
  frames.push({ id: `news-${m.date}`, kind: isRelease ? 'release' : 'news', year: yy, sort: yy * 1000 + (mm || 6) * 10 + 8, title: m.title, sub: isRelease ? 'In theaters' : `Marvel, ${fmtDate(m.date)}`, who: [], text: m.text.replace(/<[^>]+>/g, ''), sources: SRC[m.source] ? [SRC[m.source]] : [] });
}
frames.sort((a, b) => a.sort - b.sort || a.title.localeCompare(b.title));
const main = frames.filter((f) => f.kind !== 'era');
const years = [...new Set(main.map((f) => f.year))];
const decades = [...new Set(main.map((f) => Math.floor(f.year / 10) * 10))];
const counts = { screen: screens.size, debut: slugs.length, news: OFFICIAL.milestones.length };
const face = (slug: string) => photosFor(slug)[0];
// the decade hero: who debuted in each decade, and how much happened on screen and at Marvel
const decadeInfo = decades.map((d) => {
  const inD = main.filter((f) => Math.floor(f.year / 10) * 10 === d);
  const debuts = inD.filter((f) => f.kind === 'debut').map((f) => f.who[0].slug);
  // a decade with no debut shows someone from its screen titles (Doom for the 2020s, the decade of Doomsday)
  const onScreen = inD.filter((f) => f.kind === 'screen').flatMap((f) => f.who.map((w) => w.slug));
  const hasCut = (x: string) => !!photos2For(x)[0]?.cut.length;
  const lead = debuts.find(hasCut) ?? (d >= 2020 ? 'victor-von-doom' : onScreen.find(hasCut)) ?? null;
  const lp = lead ? photos2For(lead)[0] : null;
  return { d, debuts: debuts.map((x) => heroName(x).toUpperCase()), screens: inD.filter((f) => f.kind === 'screen').length, news: inD.filter((f) => f.kind === 'news' || f.kind === 'release').length,
    lead, accent: lead ? accentOf(lead) : '#1fd47a', img: lp ? pick2(lp.cut, 1280) : null, head: lp?.head?.[0] ?? 0.5 };
});
---
<Dossier title="Timeline (design preview)" page="timeline" description="Every live-action film and series and every comics debut of the Avengers: Doomsday characters, on one film strip, ending on 18 December 2026." >
  <section class="vg" data-voyage-decades style={`--n:${decadeInfo.length}`} aria-label="The decades">
    <div class="vg-stage">
      <p class="t-label t-accent vg-k">Timeline &middot; {years[0]} to {years[years.length - 1]}</p>
      <ol class="vg-list t-micro">
        {decadeInfo.map((x, i) => <li data-vg-dot style={`--a:${x.accent}`}><button type="button" data-vg-go={x.d}><i></i>{x.d}s</button></li>)}
      </ol>
      {decadeInfo.map((x, i) => (
        <div class="vg-slide" data-vg-slide style={`--a:${x.accent}`} aria-hidden={i ? 'true' : undefined}>
          <p class="vg-year t-title" aria-hidden="true">{x.d}s</p>
          <div class="vg-window">
            {x.img && <img src={x.img} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" style={`translate:${Math.round((0.5 - x.head) * 1000) / 10}% 0`} />}
          </div>
          <dl class="vg-data">
            <div><dt class="t-micro t-ash">First appearances</dt><dd>{x.debuts.length ? x.debuts.join(', ') : 'None'}</dd></div>
            <div><dt class="t-micro t-ash">Live-action titles</dt><dd>{x.screens}</dd></div>
            <div><dt class="t-micro t-ash">Marvel announcements</dt><dd>{x.news}</dd></div>
          </dl>
        </div>
      ))}
      <p class="vg-cue t-micro t-ash">Scroll through the decades &middot; or jump to one</p>
    </div>
  </section>
  <section class="tlx" data-timeline-page>
    <div class="wrap tlx-head">
      <p class="label" data-hero-in>Timeline &middot; {years[0]} to {years[years.length - 1]}</p>
      <h1 class="display tlx-title" data-split="words" data-split-on="load">Every road to Doomsday</h1>
      <p class="tlx-copy" data-hero-in>{counts.screen} live-action films and series, {counts.debut} comics debuts and {counts.news - 1} Marvel announcements, on one strip of film. Drag it, scroll it or scrub the years below. Fling it fast and the film burns.</p>
      <div class="tlx-controls" data-hero-in>
        <div class="tlx-chips" role="group" aria-label="Show">
          <button type="button" data-kind="all" aria-pressed="true">All</button>
          <button type="button" data-kind="screen" aria-pressed="false">On screen <span>{counts.screen}</span></button>
          <button type="button" data-kind="debut" aria-pressed="false">Comics debuts <span>{counts.debut}</span></button>
          <button type="button" data-kind="news" aria-pressed="false">Marvel news <span>{counts.news}</span></button>
        </div>
        <label class="tlx-follow">
          <span class="label">Follow</span>
          <select data-follow>
            <option value="">Everyone</option>
            {slugs.map((s) => <option value={s}>{heroName(s)}</option>)}
          </select>
        </label>
      </div>
    </div>

    <div class="reel" data-reel>
      <p class="reel-year" aria-hidden="true"><span data-year-out>{years[0]}</span></p>
      <div class="strip" data-cursor="Drag" data-strip tabindex="0" aria-label="Timeline film strip. Use the arrow keys to move one frame." data-lenis-prevent>
        <ol class="frames">
          {frames.map((f) => (
            <li class={`frame k-${f.kind}`} data-frame data-id={f.id} data-kind={f.kind === 'release' ? 'news' : f.kind} data-year={f.year} data-who={f.who.map((w) => w.slug).join(' ')} data-era-of={f.eraOf} hidden={f.kind === 'era'}>
              <div class="frame-in">
                <p class="fr-top"><span class="fr-year">{f.year}</span>{f.cont ? <span class="fr-tag" data-cont={f.cont}>{f.cont}</span> : <span class="fr-tag" data-kindtag={f.kind}>{f.kind === 'debut' ? 'Comics debut' : f.kind === 'era' ? 'Comics era' : f.kind === 'release' ? 'Release' : 'Marvel news'}</span>}</p>
                <h2 class="fr-title">{f.title}</h2>
                <p class="fr-sub">{f.sub}</p>
                {f.who.length > 0 && <p class="fr-names">{f.who.map((w) => heroName(w.slug)).join(' · ')}</p>}
                {f.who.length > 0 && (
                  <ul class="fr-faces">
                    {f.who.slice(0, 9).map((w) => face(w.slug) && (
                      <li class={w.first ? 'first' : ''} style={`--a:${DESIGN[w.slug].accent}`} title={heroName(w.slug)}><Photo photo={face(w.slug)!} alt={heroName(w.slug)} sizes="44px" /></li>
                    ))}
                    {f.who.length > 9 && <li class="more">+{f.who.length - 9}</li>}
                  </ul>
                )}
                {f.who.some((w) => w.first) && <p class="fr-first">First on screen: {f.who.filter((w) => w.first).map((w) => heroName(w.slug)).join(', ')}</p>}
              </div>
              <div class="fr-detail" data-detail hidden>
                <p class="dt-kind">{f.cont ? `${f.cont} · ${f.year}` : f.sub}</p>
                <h3 class="dt-title">{f.title}</h3>
                {f.text && <p class="dt-text">{f.text}</p>}
                {f.kind === 'screen' && (
                  <ul class="dt-who">
                    {f.who.map((w) => <li><a href={u(`/c/${w.slug}/`)} style={`--a:${DESIGN[w.slug].accent}`}>{heroName(w.slug)}</a> <span>{/^uncredited$/i.test(w.actor || '') ? 'performer uncredited' : `played by ${w.actor}`}{w.cameo ? ', cameo' : ''}{w.first ? ', first time on screen' : ''}</span></li>)}
                  </ul>
                )}
                {f.kind !== 'screen' && f.who.length > 0 && <p class="dt-link"><a href={u(`/c/${f.who[0].slug}/`)}>Open the {heroName(f.who[0].slug)} dossier &rarr;</a></p>}
                {f.sources.length > 0 && <p class="dt-src">Sources: {f.sources.slice(0, 4).map((s, i) => <>{i > 0 && ' · '}<a href={s.url} target="_blank" rel="noopener">{s.label}</a></>)}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="burn" aria-hidden="true"></div>
      <div class="scrub" data-scrub>
        <div class="scrub-track" data-track>
          {decades.map((d) => <span class="tick" data-decade={d}>{d}s</span>)}
          <i class="playhead" data-playhead></i>
        </div>
        <div class="scrub-btns">
          <button type="button" data-step="-1" aria-label="Previous frame">&larr;</button>
          <button type="button" data-step="1" aria-label="Next frame">&rarr;</button>
        </div>
      </div>
    </div>

    <div class="wrap">
      <article class="detail" data-detail-out aria-live="polite"></article>
      <p class="tlx-note">Titles are released live-action films and series in which an actor played one of these characters, tagged by continuity: MCU (Marvel Studios), FOX (20th Century Fox) or OTHER. Archive footage, photos and animation are left out. Comics history comes from the Marvel Fandom wiki; screen history from the Marvel Cinematic Universe Wiki and the films; news from Marvel.</p>
    </div>
  </section>
  <p class="wrap t-micro t-ash" style="padding: var(--s-6) 0 var(--s-7)">{PHOTO_CREDIT}</p>
</Dossier>

<style>
  .vg { position: relative; height: calc(var(--n) * 55vh + 100vh); }
  .vg-stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .vg-k { position: absolute; left: var(--margin); top: calc(var(--header-h) + 12px); margin: 0; z-index: 3; }
  .vg-list { position: absolute; z-index: 3; left: var(--margin); top: 50%; transform: translateY(-50%); list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .vg-list button { display: flex; align-items: center; gap: 10px; padding: 4px 0; color: var(--ash); min-height: 28px; }
  .vg-list i { width: 7px; height: 7px; border-radius: 50%; border: 1px solid var(--a); transition: background 0.3s, transform 0.3s; }
  .vg-list li.on button { color: var(--bone); }
  .vg-list li.on i { background: var(--a); transform: scale(1.4); }
  .vg-slide { position: absolute; inset: 0; display: grid; place-items: center; visibility: hidden; background: radial-gradient(ellipse at 55% 55%, color-mix(in srgb, var(--a) 34%, #0d1012), #0d1012 70%); }
  .vg-slide:first-of-type { visibility: visible; }
  .vg-year { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); text-align: center; margin: 0; font-size: min(30vw, 420px); font-weight: 900; color: rgba(231, 228, 220, 0.09); line-height: 0.8; }
  .vg-window { position: relative; width: min(30vw, 380px); aspect-ratio: 4 / 5; border-radius: 40px; overflow: hidden; border: 1px solid color-mix(in srgb, var(--a) 60%, transparent); box-shadow: 0 0 0 10px rgba(13, 16, 18, 0.45); background: radial-gradient(circle at 50% 70%, color-mix(in srgb, var(--a) 50%, #0d1012), #0d1012 78%); }
  .vg-window img { position: absolute; left: 0; right: 0; bottom: 0; margin: 0 auto; height: 96%; width: auto; max-width: none; }
  .vg-data { position: absolute; right: var(--margin); bottom: var(--s-8); margin: 0; display: grid; gap: var(--s-4); max-width: 30ch; text-align: right; }
  .vg-data dd { margin: 4px 0 0; font-family: var(--f-title); font-weight: 800; font-size: 22px; text-transform: uppercase; line-height: 1.05; }
  .vg-cue { position: absolute; left: 0; right: 0; bottom: 14px; text-align: center; margin: 0; z-index: 3; }
  @media (max-width: 760px) {
    .vg-list { top: calc(var(--header-h) + 40px); transform: none; grid-auto-flow: column; gap: 10px; }
    .vg-list button { font-size: 0; gap: 0; min-height: 24px; }
    .vg-window { width: 62vw; margin-top: -12svh; }
    .vg-data { left: var(--margin); right: var(--margin); bottom: var(--s-6); max-width: none; text-align: left; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
    .vg-data div:first-child { grid-column: 1 / -1; }
    .vg-data dd { font-size: 17px; }
    .vg-cue { display: none; }
  }
  html.rm .vg { display: none; }
  .tlx { padding: calc(var(--header-h) + 60px) 0 80px; overflow-x: clip; }
  .tlx-head { display: grid; gap: 18px; }
  .tlx-title { font-size: min(clamp(54px, 10vw, 160px), calc((100vw - 2 * var(--gutter)) / 7)); }
  .tlx-copy { max-width: 62ch; color: var(--bone-dim); margin: 0; }
  .tlx-controls { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; margin-top: 8px; }
  .tlx-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .tlx-chips button { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; border: 1px solid var(--iron-2); padding: 10px 14px; border-radius: 99px; min-height: 44px; color: var(--bone-dim); }
  .tlx-chips button span { color: var(--doom); margin-left: 4px; }
  .tlx-chips button[aria-pressed='true'] { background: var(--bone); color: var(--void); border-color: var(--bone); }
  .tlx-chips button[aria-pressed='true'] span { color: var(--void); }
  .tlx-follow { display: flex; gap: 10px; align-items: center; }
  .tlx-follow select { background: var(--void-2); color: var(--bone); border: 1px solid var(--iron-2); border-radius: 99px; padding: 10px 14px; min-height: 44px; font: inherit; font-size: 14px; }

  /* the reel: a 35 mm strip with sprocket holes, scrolled sideways */
  .reel { position: relative; margin-top: 46px; }
  .reel-year { position: absolute; right: var(--gutter); top: -0.55em; margin: 0; font-family: var(--font-display, var(--font-serif)); font-size: clamp(80px, 14vw, 220px); line-height: 1; color: transparent; -webkit-text-stroke: 1px rgba(61, 255, 138, 0.45); pointer-events: none; font-variant-numeric: tabular-nums; z-index: 0; }
  .strip { position: relative; z-index: 1; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x proximity; scrollbar-width: none; cursor: grab; outline: none; background: #0d0f10; padding: 34px 0; }
  .strip::-webkit-scrollbar { display: none; }
  .strip.dragging { cursor: grabbing; scroll-snap-type: none; }
  .strip:focus-visible { box-shadow: inset 0 0 0 2px var(--doom); }
  .frames { list-style: none; margin: 0; padding: 0 calc(50vw - 150px); display: flex; gap: 0; width: max-content; position: relative;
    background-image: radial-gradient(circle at 50% 50%, #050607 0 4px, transparent 4.5px), radial-gradient(circle at 50% 50%, #050607 0 4px, transparent 4.5px);
    background-size: 22px 22px, 22px 22px; background-repeat: repeat-x; background-position: 0 -28px, 0 calc(100% + 28px); }
  .strip::before, .strip::after { content: ''; position: absolute; left: 0; right: 0; height: 14px; pointer-events: none;
    background: repeating-linear-gradient(90deg, transparent 0 7px, #050607 7px 19px, transparent 19px 26px); background-attachment: local; }
  .strip::before { top: 10px; } .strip::after { bottom: 10px; }
  .frame { flex: 0 0 300px; scroll-snap-align: center; padding: 0 8px; }
  .frame[hidden] { display: none; }
  .frame-in { height: 400px; border-radius: 4px; background: linear-gradient(180deg, #16191b, #0a0c0d); box-shadow: inset 0 0 0 1px rgba(232, 230, 225, 0.08); padding: 20px; display: grid; grid-template-rows: auto auto auto 1fr auto; gap: 8px; transition: transform 0.5s var(--ease-out), opacity 0.5s; opacity: 0.55; transform: scale(0.94); }
  .frame.on .frame-in { opacity: 1; transform: scale(1); box-shadow: inset 0 0 0 1px rgba(61, 255, 138, 0.6); }
  .fr-top { display: flex; justify-content: space-between; align-items: center; margin: 0; }
  .fr-year { font-family: var(--font-mono); font-size: 13px; color: var(--doom); letter-spacing: 0.1em; }
  .fr-tag { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; border: 1px solid currentColor; padding: 3px 8px; border-radius: 99px; color: var(--doom); }
  .fr-tag[data-cont='FOX'] { color: #ffb36b; } .fr-tag[data-cont='OTHER'] { color: var(--bone-dim); }
  .fr-tag[data-kindtag='debut'], .fr-tag[data-kindtag='era'] { color: #8fb8ff; } .fr-tag[data-kindtag='news'] { color: var(--bone); } .fr-tag[data-kindtag='release'] { color: var(--void); background: var(--doom); border-color: var(--doom); }
  .fr-title { font-family: var(--font-serif); font-weight: 400; font-size: 30px; line-height: 1; margin: 6px 0 0; overflow-wrap: break-word; }
  .k-release .fr-title { font-size: 44px; color: var(--doom); }
  .fr-sub { margin: 0; font-size: 13px; color: var(--bone-dim); }
  .fr-names { margin: 4px 0 0; font-size: 14px; line-height: 1.45; color: var(--bone); }
  .k-era .fr-names, .k-debut .fr-names { display: none; }
  .fr-faces { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; align-self: end; }
  .fr-faces li { width: 44px; height: 44px; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 1px rgba(232, 230, 225, 0.18); }
  .fr-faces li.first { box-shadow: 0 0 0 2px var(--a); }
  .fr-faces :global(.photo) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fr-faces li.more { display: grid; place-items: center; font-family: var(--font-mono); font-size: 11px; color: var(--bone-dim); background: var(--void-2); }
  .fr-first { margin: 0; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bone-dim); }
  @media (max-width: 600px) { .frame { flex-basis: 74vw; } .frames { padding: 0 13vw; } .frame-in { height: 380px; } .fr-title { font-size: 26px; } }

  /* film burn: brightens and scorches the strip's edges when it is flung fast */
  .burn { position: absolute; left: 0; right: 0; top: 0; height: calc(400px + 68px); z-index: 2; pointer-events: none; opacity: 0;
    background: radial-gradient(60% 120% at 0% 50%, rgba(255, 214, 140, 0.95), rgba(255, 110, 20, 0.55) 30%, rgba(120, 20, 0, 0.35) 52%, transparent 70%),
                radial-gradient(60% 120% at 100% 50%, rgba(255, 214, 140, 0.95), rgba(255, 110, 20, 0.55) 30%, rgba(120, 20, 0, 0.35) 52%, transparent 70%);
  }
  @media (max-width: 600px) { .burn { height: calc(380px + 68px); } }

  .scrub { display: flex; gap: 14px; align-items: center; padding: 18px var(--gutter) 0; }
  .scrub-track { position: relative; flex: 1; height: 44px; border-top: 1px solid var(--iron-2); cursor: pointer; touch-action: none; }
  .tick { position: absolute; top: 10px; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; color: var(--bone-dim); transform: translateX(-50%); white-space: nowrap; }
  .tick::before { content: ''; position: absolute; left: 50%; top: -11px; width: 1px; height: 8px; background: var(--iron-2); }
  .playhead { position: absolute; top: -9px; left: 0; width: 2px; height: 18px; background: var(--doom); box-shadow: 0 0 16px var(--doom); transform: translateX(0); }
  .scrub-btns { display: flex; gap: 8px; }
  .scrub-btns button { width: 44px; height: 44px; border: 1px solid var(--iron-2); border-radius: 50%; color: var(--bone); }
  .scrub-btns button:hover { border-color: var(--doom); color: var(--doom); }

  .detail { margin-top: 40px; border-top: 1px solid var(--iron-2); padding-top: 26px; max-width: 900px; min-height: 220px; }

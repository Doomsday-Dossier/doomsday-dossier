---
import Dossier from '../../layouts/Dossier.astro';
import '../../styles/faces';
import { DESIGN, getResearch, castFor, publishedOrder, TEAMS, heroName, u } from '../../data/site';
import { PHOTO_CREDIT } from '../../data/photos';
import { accentOf, photos2For, pick2 } from '../../data/v2';

// Versus data: official Handbook grids, abilities, feats and power origins (research/versus),
// plus each character's screen titles for the connections panel.
const files = import.meta.glob('../../../research/versus/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const bySlug = Object.fromEntries(Object.values(files).map((v: any) => [v.slug, v]));
const key = (t: string) => t.toLowerCase().replace(/[^a-z0-9]/g, '');

const roster = publishedOrder().map((slug) => {
  const d = DESIGN[slug], r = getResearch(slug)!, c = castFor(slug)!, v = bySlug[slug];
  const ph = photos2For(slug)[0];
  return {
    slug, name: heroName(slug), alias: r.alias, actor: c.actor, team: TEAMS.find((t) => t.id === c.team)?.name ?? '', teamId: c.team,
    accent: accentOf(slug), font: d.font, weight: d.fontWeight, url: u(`/preview/c/${slug}/`), no: publishedOrder().indexOf(slug) + 1,
    photo: ph ? { small: pick2(ph.full, 640), big: pick2(ph.full, 1280), focus: ph.focusM } : null,
    grid: v?.powerGrid?.values ?? null, gridSource: v?.powerGrid?.source ?? null, gridNote: v?.powerGrid?.note ?? null,
    powerType: v?.powerType ?? null, origins: v?.powerOrigins ?? [], abilities: v?.abilities ?? [], feats: v?.feats ?? [],
    screens: [...r.screen].sort((a: any, b: any) => a.year - b.year).map((s: any) => ({ k: key(s.title) + s.year, title: s.title, year: s.year })),
    ready: !!v,
  };
});
const data = JSON.stringify(roster);
// the arena worker and Turnstile site key come from the build environment; without them voting shows as opening soon
const arenaApi = import.meta.env.PUBLIC_ARENA_API ?? '';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
---
<Dossier title="Fight arena (design preview)" page="arena" description="The Doomsday Dossier fight arena: pick any two Avengers: Doomsday characters, see their documented feats and official Marvel Handbook power grids side by side, and cast a fan vote. Every stat sourced." >
  <section class="cl-hero" data-cursor="Drag" data-cloth aria-label="Fight arena: grab a poster and throw it at the other">
    <div class="cl-stage">
      <p class="t-label t-accent cl-k">Fight arena &middot; fan vote, not fact</p>
      <p class="t-title cl-title" aria-hidden="true">Grab them.<br />Fling them.</p>
      <div class="cl-static" aria-hidden="true"><img data-static="a" alt="" /><img data-static="b" alt="" /></div>
      <p class="cl-hint t-label t-ash">Drag a poster &middot; throw it at the other &middot; or scroll for the stats</p>
      <i class="cl-flash" data-cloth-flash aria-hidden="true"></i>
    </div>
  </section>
  <section class="vs" data-versus>
    <div class="wrap vs-head">
      <p class="label" data-hero-in>Fight arena</p>
      <h1 class="display vs-title" data-split="words" data-split-on="load">Pick two.</h1>
      <p class="vs-copy" data-hero-in>Documented feats and official Marvel Handbook power grids, side by side, with every source shown. The site never declares a winner: the fan vote is just that, fans&rsquo; opinion. The stats are the comics&rsquo;, and the films don&rsquo;t always match them.</p>
    </div>

    <div class="vs-stage wrap" aria-live="polite">
      <i class="vs-flash" aria-hidden="true"></i>
      <article class="vs-side" data-side="a"></article>
      <div class="vs-mid">
        <i class="vs-shock" aria-hidden="true"></i>
        <span class="vs-badge" aria-hidden="true">VS</span>
        <svg class="radar" viewBox="-162 -132 324 264" role="img" aria-labelledby="radar-t" data-radar>
          <title id="radar-t">Power grid radar</title>
          <g class="rings"></g>
          <g class="axes"></g>
          <g class="shape-b"><polygon class="glow" /><polygon class="glow2" /><polygon class="fill" /></g>
          <g class="shape-a"><polygon class="glow" /><polygon class="glow2" /><polygon class="fill" /></g>
          <g class="labels"></g>
        </svg>
        <p class="radar-note">Comics stats: Marvel Handbook power grid, 1 to 7, as published on Marvel.com&rsquo;s Marvel Universe wiki. Films don&rsquo;t always match.</p>
      </div>
      <article class="vs-side" data-side="b"></article>
    </div>

    <section class="wrap vs-vote" data-vote data-api={arenaApi} data-sitekey={turnstileKey} aria-labelledby="vote-h">
      <p class="label">Fan vote &middot; opinion, not fact</p>
      <h2 id="vote-h" class="vote-q">Who wins this fight?</h2>
      <div class="vote-btns"><button type="button" data-v="a">Left</button><span aria-hidden="true">or</span><button type="button" data-v="b">Right</button></div>
      <p class="vote-status" data-status role="status"></p>
      <div class="vote-result" data-result hidden></div>
      <div class="vote-ts" data-ts></div>
      <p class="vote-note">One vote per fight per day. Bots are kept out by Cloudflare Turnstile; this site stores no account, name or IP address. <button type="button" class="vote-peek" data-peek>See the fan split without voting</button></p>
    </section>

    <section class="wrap lb" data-board id="most-wanted" aria-labelledby="lb-h">
      <header class="lb-head">
        <div>
          <p class="label">Most-wanted fights &middot; fan votes, live</p>
          <h2 id="lb-h" class="lb-title">The fights fans want</h2>
        </div>
        <p class="lb-note">Ranked by total fan votes and updated as people vote. Fan opinion, not fact. <span data-board-stamp></span></p>
      </header>
      <ol class="lb-list" data-board-list aria-live="polite"></ol>
      <p class="lb-empty" data-board-empty hidden>No fights have been voted on yet. Pick two above and cast the first vote.</p>
    </section>

    <div class="wrap vs-pick">
      <div class="vs-pick-head">
        <p class="label">Choose a character for</p>
        <div class="vs-slots" role="group" aria-label="Which side to change">
          <button type="button" data-slot="a" aria-pressed="true">Left</button>
          <button type="button" data-slot="b" aria-pressed="false">Right</button>
        </div>
        <button type="button" class="vs-swap" data-swap>Swap sides</button>
        <button type="button" class="vs-share" data-share>Copy link</button>
      </div>
      <ul class="vs-roster">
        {roster.map((c) => (
          <li><button type="button" data-pick={c.slug} style={`--a:${c.accent}`} aria-label={c.name}>
            {c.photo ? <img src={c.photo.small} alt="" width="56" height="56" loading="lazy" decoding="async" style={`object-position:${c.photo.focus}`} /> : <span>{c.name.slice(0, 1)}</span>}
            <b>{c.name}</b>
          </button></li>
        ))}
      </ul>
    </div>

    <div class="wrap vs-body" data-body></div>
    <noscript><div class="wrap"><p>The versus page needs JavaScript. Every character&rsquo;s abilities and history are on their dossier pages.</p></div></noscript>
  </section>
  <script type="application/json" id="vs-data" set:html={data} />
  <p class="wrap t-micro t-ash" style="padding: 0 0 var(--s-7)">{PHOTO_CREDIT}</p>
</Dossier>

<style>
  .cl-hero { position: relative; height: 100svh; min-height: 560px; touch-action: pan-y; cursor: grab; }
  .cl-hero:active { cursor: grabbing; }
  .cl-stage { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; }
  .cl-k { position: absolute; left: var(--margin); top: calc(var(--header-h) + 12px); margin: 0; }
  /* the title in clear space below the posters, in front (Peculiar Atelier: "Grab me / I dare you") */
  .cl-title { position: absolute; left: var(--margin); right: var(--margin); bottom: calc(var(--s-6) + 34px); margin: 0; font-size: min(9vw, 13svh); font-weight: 900; line-height: 0.86; color: var(--bone); z-index: 2; }
  .cl-hint { position: absolute; bottom: var(--s-6); left: var(--margin); right: var(--margin); margin: 0; z-index: 2; }
  @media (max-width: 760px) { .cl-title { font-size: 15vw; } }
  .cl-flash { position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, rgba(231, 228, 220, 0.85), rgba(31, 212, 122, 0.3) 30%, transparent 65%); opacity: 0; }
  .cl-static { display: none; gap: 4vw; }
  .cl-static img { width: min(36vw, 340px); aspect-ratio: 3 / 4; object-fit: cover; border: 6px solid #d9d5ca; transform: rotate(-3deg); }
  .cl-static img + img { transform: rotate(3deg); }
  html.rm .cl-static, html.no-gl .cl-static { display: flex; }
  html.rm .cl-hint, html.no-gl .cl-hint { display: none; }
  .vs { padding: calc(var(--header-h) + 60px) 0 90px; overflow-x: clip; }
  .vs-head { display: grid; gap: 16px; }
  .vs-title { font-size: min(clamp(64px, 12vw, 190px), calc((100vw - 2 * var(--gutter)) / 4.4)); }
  .vs-copy { max-width: 64ch; color: var(--bone-dim); margin: 0; }

  .vs-stage { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(12px, 2vw, 32px); align-items: center; margin-top: 46px; }
  .vs-side { contain: paint; position: relative; aspect-ratio: 3 / 4; border-radius: 4px; overflow: hidden; background: var(--void-2); box-shadow: 0 0 0 1px var(--iron); isolation: isolate; }
  .vs-side :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .vs-side::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, #050607 4%, rgba(5, 6, 7, 0.75) 36%, transparent 66%); }
  .vs-side :global(.vs-info) { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: clamp(12px, 2vw, 24px); display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; text-shadow: 0 1px 2px #050607, 0 0 16px rgba(5, 6, 7, 0.9); }
  .vs-side :global(.vs-name) { font-family: var(--f); font-weight: var(--w); text-transform: uppercase; font-size: min(52px, max(3.2vw, 18px), calc((100cqi - 2 * clamp(12px, 2vw, 24px)) / (var(--lw, 8) * 0.95))); line-height: 0.92; margin: 0; color: var(--bone); overflow-wrap: normal; }
  .vs-side { container-type: inline-size; }
  .vs-side :global(.vs-alias) { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--a); margin: 0; }
  .vs-side :global(.vs-meta) { font-size: 13px; color: var(--bone-dim); margin: 0; }
  .vs-side :global(.vs-type) { justify-self: start; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; border: 1px solid var(--a); color: var(--a); padding: 3px 8px; border-radius: 99px; }
  .vs-side :global(.vs-open) { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bone); text-decoration-color: var(--a); text-underline-offset: 3px; }
  .vs-side[data-side='b'] :global(.vs-info) { text-align: right; justify-items: end; }
  .vs-side[data-side='b'] :global(.vs-type) { justify-self: end; }

  .vs-mid { position: relative; display: grid; justify-items: center; gap: 10px; }
  /* slam effects: a shockwave ring from the badge and a flash over the stage (opacity and transform only) */
  .vs-stage { position: relative; }
  .vs-flash { position: absolute; inset: 0; z-index: 5; pointer-events: none; opacity: 0; background: radial-gradient(closest-side, rgba(255, 255, 255, 0.85), rgba(61, 255, 138, 0.25) 60%, transparent); }
  .vs-shock { position: absolute; left: 50%; top: 48px; width: 160px; height: 160px; margin: -80px 0 0 -80px; border-radius: 50%; border: 3px solid var(--doom); box-shadow: 0 0 0 10px rgba(61, 255, 138, 0.15); opacity: 0; pointer-events: none; z-index: 4; }

  /* documented feats on each card, one at a time */
  /* only on wide cards: on smaller ones the feats would run into the name, and they are listed just below */
  .vs-side :global(.vs-feat) { display: none; }
  @media (min-width: 1100px) { .vs-side :global(.vs-feat) { display: block; } }
  .vs-side :global(.vs-feat) { position: absolute; left: 0; right: 0; top: 0; z-index: 2; padding: clamp(12px, 1.6vw, 18px); background: linear-gradient(to bottom, rgba(5, 6, 7, 0.88) 55%, transparent); min-height: 110px; }
  .vs-side :global(.feat) { position: absolute; left: clamp(12px, 1.6vw, 18px); right: clamp(12px, 1.6vw, 18px); top: clamp(12px, 1.6vw, 18px); margin: 0; font-size: 13px; line-height: 1.45; color: var(--bone); opacity: 0; transform: translateY(8px); transition: opacity 0.6s, transform 0.6s var(--ease-out); }
  .vs-side :global(.feat.on) { opacity: 1; transform: none; }
  .vs-side :global(.feat .where) { display: block; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--a); margin-bottom: 4px; }
  .vs-side :global(.feat a) { color: var(--bone-dim); font-size: 11px; text-underline-offset: 2px; }

  /* fan vote */
  .vs-vote { margin-top: 40px; display: grid; justify-items: center; text-align: center; gap: 12px; border-top: 1px solid var(--iron); border-bottom: 1px solid var(--iron); padding: 34px var(--gutter); }
  .vote-q { font-family: var(--font-serif); font-weight: 400; font-size: clamp(30px, 3.6vw, 52px); margin: 0; }
  .vote-btns { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .vote-btns span { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--bone-dim); }
  .vote-btns button { min-height: 52px; min-width: 150px; padding: 12px 22px; border-radius: 99px; border: 1px solid var(--a, var(--iron-2)); color: var(--bone); font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; transition: background 0.3s, color 0.3s, transform 0.3s var(--ease-out); }
  .vote-btns button:hover { background: var(--a); color: var(--void); transform: translateY(-2px); }
  .vs-vote.voting .vote-btns button { opacity: 0.5; pointer-events: none; }
  .vs-vote.voted .vote-btns, .vs-vote.vote-off .vote-btns, .vs-vote.vote-off .vote-peek, .vs-vote.voted .vote-peek { display: none; }
  .vote-status { margin: 0; min-height: 1.4em; color: var(--bone-dim); font-size: 14px; }
  .vote-result { width: min(720px, 100%); display: grid; gap: 10px; }
  .vote-result :global(.split) { position: relative; height: 18px; border-radius: 99px; overflow: hidden; background: rgba(232, 230, 225, 0.06); }
  .vote-result :global(.split i) { position: absolute; top: 0; bottom: 0; width: 100%; }
  .vote-result :global(.sa) { left: 0; background: var(--ca); transform-origin: left; }
  .vote-result :global(.sb) { right: 0; background: var(--cb); transform-origin: right; opacity: 0.85; }
  .vote-result :global(.split-nums) { display: flex; justify-content: space-between; gap: 12px; margin: 0; font-size: 15px; }
  .vote-result :global(.split-nums b) { font-weight: 500; }
  .vote-result :global(.split-total) { margin: 0; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bone-dim); }
  .vote-ts:empty { display: none; }
  .vote-note { margin: 0; font-size: 12px; color: var(--bone-dim); max-width: 70ch; }
  .vote-peek { color: var(--bone); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--doom); font-size: 12px; }
  .vs-badge { will-change: transform; font-family: var(--font-display, var(--font-serif)); font-size: clamp(30px, 4vw, 54px); letter-spacing: 0.06em; color: var(--doom); text-shadow: 0 0 30px rgba(61, 255, 138, 0.5); }
  /* the radar repaints while it morphs: keep it on its own layer so the shaking stage is not repainted with it */
  .radar { width: 100%; max-width: 380px; overflow: visible; will-change: transform; }
  .radar :global(.rings polygon) { fill: none; stroke: rgba(232, 230, 225, 0.12); stroke-width: 1; }
  .radar :global(.axes line) { stroke: rgba(232, 230, 225, 0.14); stroke-width: 1; }
  .radar :global(.labels text) { fill: var(--bone-dim); font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.08em; text-transform: uppercase; }
  .radar .glow { fill: none !important; }
  .radar .fill { fill-opacity: 0.18; stroke-width: 1.6; stroke-linejoin: round; }
  /* soft glow from two wide translucent strokes: no blur filter to re-render while shapes morph */
  .radar .glow { fill: none; stroke-width: 9; stroke-opacity: 0.12; stroke-linejoin: round; }
  .radar .glow2 { fill: none !important; stroke-width: 4.5; stroke-opacity: 0.25; stroke-linejoin: round; }
  .radar-note { font-size: 11px; color: var(--bone-dim); text-align: center; max-width: 34ch; margin: 0; }

  /* most-wanted fights */
  .lb { margin-top: 56px; }
  .lb-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 10px 30px; margin-bottom: 18px; }
  .lb-title { font-family: var(--font-serif); font-weight: 400; font-size: clamp(32px, 3.6vw, 54px); margin: 6px 0 0; }
  .lb-note { margin: 0; font-size: 13px; color: var(--bone-dim); max-width: 46ch; }
  .lb-note span { display: block; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; margin-top: 4px; }
  .lb-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 520px), 1fr)); gap: 0 32px; }
  .lb-list :global(.lb-row) { border-top: 1px solid var(--iron); }
  .lb-list :global(.lb-open) { width: 100%; display: grid; grid-template-columns: 34px auto minmax(0, 1fr) auto; grid-template-areas: 'rank faces names total' 'rank faces split pct'; align-items: center; gap: 6px 14px; padding: 14px 4px; text-align: left; border-radius: 4px; transition: background 0.3s; }
  .lb-list :global(.lb-open:hover) { background: rgba(232, 230, 225, 0.04); }
  .lb-list :global(.lb-rank) { grid-area: rank; font-family: var(--font-mono); font-size: 13px; color: var(--doom); }
  .lb-list :global(.lb-faces) { grid-area: faces; display: flex; }
  .lb-list :global(.lb-faces img), .lb-list :global(.lb-faces span) { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px var(--void); }
  .lb-list :global(.lb-faces > :nth-child(1)) { box-shadow: 0 0 0 2px var(--ca); }
  .lb-list :global(.lb-faces > :nth-child(2)) { margin-left: -10px; box-shadow: 0 0 0 2px var(--cb); }
  .lb-list :global(.lb-names) { grid-area: names; min-width: 0; font-size: 15px; overflow-wrap: anywhere; }
  .lb-list :global(.lb-names b) { font-weight: 500; white-space: nowrap; }
  .lb-list :global(.lb-names i) { font-style: normal; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bone-dim); margin: 0 4px; }
  .lb-list :global(.lb-split) { grid-area: split; position: relative; height: 6px; border-radius: 99px; overflow: hidden; background: rgba(232, 230, 225, 0.06); }
  .lb-list :global(.lb-split i) { position: absolute; top: 0; bottom: 0; width: 100%; }
  .lb-list :global(.lb-split .sa) { left: 0; background: var(--ca); transform-origin: left; }
  .lb-list :global(.lb-split .sb) { right: 0; background: var(--cb); transform-origin: right; opacity: 0.85; }
  .lb-list :global(.lb-pct) { grid-area: pct; font-family: var(--font-mono); font-size: 11px; color: var(--bone-dim); white-space: nowrap; }
  .lb-list :global(.lb-total) { grid-area: total; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--bone-dim); white-space: nowrap; }
  .lb-list :global(.lb-total b) { font-size: 15px; color: var(--bone); font-weight: 500; }
  .lb-empty { color: var(--bone-dim); margin: 0; padding: 16px 0; border-top: 1px solid var(--iron); }
  .vs-pick { margin-top: 40px; }
  .vs-pick-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-bottom: 14px; }
  .vs-pick-head .label { margin: 0; }
  .vs-slots { display: flex; gap: 6px; }
  .vs-pick-head button { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; border: 1px solid var(--iron-2); padding: 10px 14px; border-radius: 99px; min-height: 44px; color: var(--bone-dim); }
  .vs-pick-head button[aria-pressed='true'] { background: var(--bone); color: var(--void); border-color: var(--bone); }
  .vs-pick-head button:hover { border-color: var(--bone-dim); color: var(--bone); }
  .vs-roster { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(76px, 1fr)); gap: 8px; }
  .vs-roster button { width: 100%; display: grid; justify-items: center; gap: 6px; padding: 8px 4px; border-radius: 6px; border: 1px solid transparent; min-height: 44px; transition: border-color 0.3s, background 0.3s; }
  .vs-roster button:hover { border-color: var(--iron-2); }
  .vs-roster img, .vs-roster span { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 1px var(--iron); }
  .vs-roster b { font-weight: 400; font-size: 11px; line-height: 1.2; color: var(--bone-dim); text-align: center; text-transform: uppercase; letter-spacing: 0.04em; }
  .vs-roster button.is-a, .vs-roster button.is-b { border-color: var(--a); background: color-mix(in srgb, var(--a) 12%, transparent); }
  .vs-roster button.is-a b, .vs-roster button.is-b b { color: var(--bone); }

  .vs-body { margin-top: 60px; display: grid; gap: 56px; transition: opacity 0.4s; }
  .vs-body.stale { opacity: 0.35; }
  .vs-body :global(h2) { font-family: var(--font-serif); font-weight: 400; font-size: clamp(32px, 3.6vw, 54px); margin: 0 0 18px; }
  .vs-body :global(.stats) { display: grid; gap: 10px; }
  .vs-body :global(.stat) { display: grid; grid-template-columns: minmax(0, 1fr) 150px minmax(0, 1fr); align-items: center; gap: 12px; }
  .vs-body :global(.stat-name) { text-align: center; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bone-dim); }
  .vs-body :global(.bar) { position: relative; height: 26px; background: rgba(232, 230, 225, 0.05); border-radius: 3px; overflow: hidden; }
  .vs-body :global(.bar i) { position: absolute; inset: 0; background: var(--a); transform-origin: right; opacity: 0.85; }

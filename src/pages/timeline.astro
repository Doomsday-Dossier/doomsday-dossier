---
// DOOM-OS module 02, the temporal archive: universes collide. Every confirmed character's comic debut, every released
// live-action title with any of them, and Marvel's Doomsday announcements, in order. Beside the log (sticky), the
// archive's map of the multiverse: the comics, the Fox films, Marvel Studios' MCU and other studios as rings of
// light; each sighting lands on its universe's ring as the reader reaches its year; threads join a character's
// sightings across universes; and as the log nears 2026 the rings drift together into one. That convergence is a
// fact of the cast list: Marvel's Doomsday cast brings actors from the Fox X-Men films together with MCU heroes.
import OS from '../layouts/OS.astro';
import { getResearch, publishedOrder, OFFICIAL, SRC, heroName, fmtDate, u } from '../data/site';
import { accentOf } from '../data/v2';
import { targets } from '../data/os';

type Src = { label: string; url: string };
type Ev = { id: string; u: 'C' | 'F' | 'M' | 'O' | 'N'; kind: 'debut' | 'screen' | 'news' | 'release'; year: number; sort: number; title: string; sub: string; text?: string; who: { slug: string; actor?: string; cameo?: boolean }[]; sources: Src[] };
const MONTHS = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];
const monthOf = (s: string) => { const i = MONTHS.findIndex((m) => s.toLowerCase().includes(m)); return i < 0 ? 6 : i + 1; };
const key = (t: string) => t.toLowerCase().replace(/[^a-z0-9]/g, '');
const issue = (s: string) => (s.startsWith('#') ? s : `#${s}`);
const UNI = { C: 'The comics', F: 'Fox films', M: 'Marvel Studios', O: 'Other studios', N: 'Marvel announces' } as const;
const CONT: Record<string, Ev['u']> = { MCU: 'M', FOX: 'F', OTHER: 'O' };

const evs: Ev[] = [];
const screens = new Map<string, Ev>();
for (const slug of publishedOrder()) {
  const r = getResearch(slug)!, fa = r.origin.firstAppearance, y = Number((fa.coverDate.match(/\d{4}/) || ['0'])[0]);
  evs.push({ id: `d-${slug}`, u: 'C', kind: 'debut', year: y, sort: y * 1000 + monthOf(fa.coverDate) * 10, title: `${fa.title} ${issue(fa.issue)}`, sub: `${heroName(slug)} first appears`, text: `Cover date ${fa.coverDate}. Created by ${r.origin.creators.join(', ')}.`, who: [{ slug }], sources: r.origin.sources.slice(0, 2) });
  for (const e of r.screen) {
    const k = key(e.title) + e.year;
    if (!screens.has(k)) screens.set(k, { id: `s-${k}`, u: CONT[e.continuity] ?? 'O', kind: 'screen', year: e.year, sort: e.year * 1000 + 600, title: e.title, sub: '', who: [], sources: [] });
    const f = screens.get(k)!;
    f.who.push({ slug, actor: e.actor, cameo: e.cameo });
    for (const s of e.sources) if (!f.sources.some((x) => x.url === s.url)) f.sources.push(s);
  }
}
for (const f of screens.values()) { f.sub = `${f.who.length} target${f.who.length > 1 ? 's' : ''} sighted`; evs.push(f); }
for (const m of OFFICIAL.milestones as any[]) {
  const [yy, mm] = m.date.split('-').map(Number), rel = m.date === OFFICIAL.film.releaseDate;
  evs.push({ id: `n-${m.date}`, u: 'N', kind: rel ? 'release' : 'news', year: yy, sort: yy * 1000 + (mm || 6) * 10 + 8, title: m.title, sub: rel ? 'In theaters' : `Marvel, ${fmtDate(m.date)}`, text: m.text.replace(/<[^>]+>/g, ''), who: [], sources: SRC[m.source] ? [SRC[m.source]] : [] });
}
if (!evs.some((e) => e.kind === 'release')) evs.push({ id: 'n-release', u: 'N', kind: 'release', year: 2026, sort: 2026 * 1000 + 128, title: 'Avengers: Doomsday', sub: 'In theaters, 18 December 2026', text: 'Marvel Studios releases Avengers: Doomsday.', who: [], sources: [SRC.S_FILM] });
evs.sort((a, b) => a.sort - b.sort || a.title.localeCompare(b.title));
const decades = [...new Set(evs.map((e) => Math.floor(e.year / 10) * 10))];
const T = targets(), tile = new Map(T.map((t) => [t.slug, t.tile]));
const chars = Object.fromEntries(T.map((t) => [t.slug, { name: t.name, accent: accentOf(t.slug) }]));
const data = { evs: evs.map((e) => ({ id: e.id, u: e.u, y: e.year, s: e.sort, w: e.who.map((x) => x.slug), t: e.title })), chars };
const n = { C: evs.filter((e) => e.u === 'C').length, F: evs.filter((e) => e.u === 'F').length, M: evs.filter((e) => e.u === 'M').length, O: evs.filter((e) => e.u === 'O').length, N: evs.filter((e) => e.u === 'N').length };
---
<OS title="Temporal archive" page="timeline" description="Every comic debut and every live-action appearance of the 29 Avengers: Doomsday characters, from 1939 to 2026, mapped as the comics, Fox and Marvel Studios universes converging on Doomsday.">
  <div class="mod-head">
    <div>
      <svg class="op-rings" viewBox="0 0 640 220" aria-hidden="true"><ellipse cx="250" cy="110" rx="200" ry="70" /><ellipse cx="390" cy="110" rx="200" ry="70" /><ellipse cx="320" cy="118" rx="240" ry="86" /></svg>
      <h1 class="os-display os-hi mod-title">Universes collide</h1>
      <p class="mod-sub">Doom's archive watches every universe at once. Scroll through time: each sighting lands on its universe, threads join a target's lives across them, and the universes drift together as 18 December 2026 nears, when Marvel's Doomsday cast brings the Fox films' X-Men and the MCU's heroes together.</p>
    </div>
    <div class="tl-keys">
      <span class="k kC">The comics &middot; {n.C}</span><span class="k kF">Fox films &middot; {n.F}</span><span class="k kM">Marvel Studios &middot; {n.M}</span><span class="k kO">Other studios &middot; {n.O}</span><span class="k kN">Marvel announces &middot; {n.N}</span>
    </div>
  </div>

  <div class="tl">
    <div class="tl-stage">
      <canvas data-mv aria-hidden="true"></canvas>
      <div class="tl-read"><span class="os-label" data-mv-phase>Signal acquired</span><b class="os-display os-hi" data-mv-year>1939</b><span class="os-label" data-mv-now></span></div>
    </div>
    <div class="tl-log" data-log>
      <nav class="tl-dec" aria-label="Jump to a decade">{decades.map((d) => <a href={`#dec-${d}`}>{d}s</a>)}</nav>
      {decades.map((d) => (
        <section class="dec" id={`dec-${d}`}>
          <h2 class="dec-h os-display">{d}<span class="dec-s">s</span></h2>
          {evs.filter((e) => Math.floor(e.year / 10) * 10 === d).map((e) => (
            <article class={`ev ev-${e.u} ${e.kind}`} data-ev={e.id} data-s={e.sort} data-y={e.year}>
              <span class="ev-y">{e.year}</span>
              <div>
                <p class="ev-u os-label">{UNI[e.u]}{e.kind === 'debut' && ' · first appearance'}</p>
                <h3>{e.title}</h3>
                <p class="ev-sub">{e.sub}</p>
                {e.who.length > 0 && e.kind === 'screen' && (
                  <ul class="ev-who">{e.who.map((w) => <li><a href={u(`/c/${w.slug}/`)} title={`${heroName(w.slug)}${w.actor ? ', played by ' + w.actor : ''}${w.cameo ? ' (cameo)' : ''}`}><img src={tile.get(w.slug)} alt={heroName(w.slug)} loading="lazy" /></a></li>)}</ul>
                )}
                {e.text && <p class="ev-text">{e.text}</p>}
                {e.sources.length > 0 && <details class="os-src"><summary>Sources</summary><ol class="srcs">{e.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}</ol></details>}
              </div>
            </article>
          ))}
        </section>
      ))}
    </div>
  </div>
  <script type="application/json" data-mv-data is:inline set:html={JSON.stringify(data)} />
</OS>

<style is:global>
  .tl-keys { display: flex; flex-wrap: wrap; gap: 6px; max-width: 520px; justify-content: flex-end; }
  .tl-keys .k { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; padding: 3px 7px; border: 1px solid currentColor; }
  .kC { color: #ffb347; } .kF { color: #8fcaff; } .kM { color: #3dff8f; } .kO { color: #c79bff; } .kN { color: #e9fff3; }
  .tl { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--os-gap); align-items: start; }
  /* the stage is opaque: the log scrolls beside it (desktop) or under it (phones), never through it */
  .tl-stage { position: sticky; top: 60px; z-index: 6; height: calc(100svh - 76px); border: 1px solid var(--os-line); background: radial-gradient(ellipse at 50% 50%, rgba(61, 255, 143, 0.06), transparent 70%), #020504; overflow: hidden; }
  .tl-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .tl-read { position: absolute; left: 16px; bottom: 12px; display: grid; gap: 2px; pointer-events: none; }
  .tl-read b { font-size: clamp(48px, 7vw, 110px); line-height: 0.9; font-variant-numeric: tabular-nums; }
  .tl-log { min-width: 0; }
  .tl-dec { position: sticky; top: 48px; z-index: 5; display: flex; flex-wrap: wrap; gap: 4px; padding: 10px 0; background: #020504; border-bottom: 1px solid var(--os-line); box-shadow: 0 10px 16px -8px #020504; }
  .tl-dec a { font-size: 11px; letter-spacing: 0.12em; text-decoration: none; border: 1px solid var(--os-line); padding: 3px 6px; }
  .tl-dec a:hover { border-color: var(--os-line-hi); }
  .dec { scroll-margin-top: 100px; }
  .dec-h { font-size: 44px; color: var(--os-dim); margin: 26px 0 8px; }
  .ev { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 12px; padding: 12px 0 12px 12px; border-left: 1px solid var(--os-line); --tick: var(--uc, var(--os-line)); background-image: linear-gradient(var(--tick), var(--tick)), linear-gradient(var(--tick), var(--tick)); background-size: 12px 2px, 2px 12px; background-position: 0 0, 0 0; background-repeat: no-repeat; border-bottom: 1px dashed rgba(61, 255, 143, 0.1); transition: background 0.3s; }
  .ev.now { background: linear-gradient(90deg, rgba(61, 255, 143, 0.08), transparent); }
  .ev-C { --uc: #ffb347; } .ev-F { --uc: #8fcaff; } .ev-M { --uc: #3dff8f; } .ev-O { --uc: #c79bff; } .ev-N { --uc: #e9fff3; }
  .ev-y { font-weight: 700; color: var(--uc); font-size: 13px; }
  .ev-u { margin: 0; color: var(--uc) !important; }
  .ev h3 { margin: 2px 0 2px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em; }
  .ev-sub { margin: 0; font-size: 11.5px; color: var(--os-dim); }
  .ev-text { margin: 6px 0 0; font-size: 12.5px; max-width: 70ch; }
  .ev-who { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px; }
  .ev-who img { width: 30px; height: 30px; object-fit: cover; object-position: 50% 15%; border: 1px solid var(--uc); display: block; filter: grayscale(0.6); }
  .ev-who a:hover img { filter: none; }
  .ev.release h3 { font-family: var(--os-display); font-size: 26px; color: var(--os-green); }
  @media (max-width: 900px) {
    .tl { grid-template-columns: minmax(0, 1fr); }
    .tl-stage { top: 48px; height: 40svh; min-height: 260px; margin: 0 calc(-1 * var(--os-margin)); border-left: 0; border-right: 0; box-shadow: 0 12px 20px -6px #020504; }
    .tl-dec { top: calc(48px + max(40svh, 260px)); flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin: 0 calc(-1 * var(--os-margin)); padding: 8px var(--os-margin); }
    .tl-dec::-webkit-scrollbar { display: none; }
    .tl-dec a { flex: 0 0 auto; padding: 8px 10px; font-size: 11px; }
    .tl-read { left: 12px; bottom: 8px; }
    .tl-read .os-label { font-size: 11px; }
    .dec { scroll-margin-top: calc(110px + max(40svh, 260px)); }
    .tl-read b { font-size: 44px; }
    .tl-keys { justify-content: flex-start; }
  }
</style>

---
// DOOM-OS, sources and rules: the protocols this archive is kept by (the site's rules, in its own words), every
// Marvel source for the film, and the unofficial, non-commercial notice. No script (page="about").
import OS from '../layouts/OS.astro';
import { SRC, OFFICIAL, u } from '../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
const sources = Object.values(SRC);
---
<OS title="Sources and rules" page="about" description="How Doomsday Dossier sources every fact, and what it will never publish.">
  <div class="mod-head">
    <div>
      <h1 class="os-display os-hi mod-title">Nothing here is a guess.</h1>
      <p class="mod-sub">The standing orders this archive is kept by, Your Majesty, and the Marvel announcements every fact about the film traces back to.</p>
    </div>
    <p class="os-label">Facts last checked {OFFICIAL.verifiedOn}</p>
  </div>

  <div class="ab-grid">
    <section class="os-panel" data-os-in aria-labelledby="ab-rules">
      <header><b id="ab-rules">The rules</b><span class="os-label">Standing orders</span></header>
      <ol class="ab-orders">
        <li><span class="os-label">Order 01</span><p>Every fact about Avengers: Doomsday comes from a Marvel announcement, listed below.</p></li>
        <li><span class="os-label">Order 02</span><p>A page says an actor plays a named character only where Marvel has named that role. Otherwise it says the role is not yet named.</p></li>
        <li><span class="os-label">Order 03</span><p>Character history comes from the Marvel Fandom wiki, the Marvel Cinematic Universe Wiki and the named films and comics. Every section lists its sources.</p></li>
        <li><span class="os-label">Order 04</span><p>All writing is our own. Nothing is copied from the wikis.</p></li>
        <li><span class="os-label">Order 05</span><p>No rumours, leaks, set reports or plot predictions. People who asked on stage to join the cast, but whom Marvel has not confirmed, are left out.</p></li>
        <li><span class="os-label">Order 06</span><p>Each dossier shows three photos of the character. Images belong to their respective owners, are used here non-commercially, and any image will be removed on request. Every one is listed on the <a href={u('/credits/')}>image credits</a> page. All other visuals are made from colour, type and code.</p></li>
      </ol>
    </section>

    <section class="os-panel" data-os-in aria-labelledby="ab-src">
      <header><b id="ab-src">Marvel sources for the film</b><span class="os-label">{pad(sources.length)} on file</span></header>
      <ol class="ab-src">
        {sources.map((s, i) => <li><span class="os-label">S-{pad(i + 1)}</span><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ol>
      <p class="os-label ab-checked">Facts last checked <span class="os-hi">{OFFICIAL.verifiedOn}</span>.</p>
    </section>
  </div>

  <section class="os-panel ab-legal" data-os-in aria-labelledby="ab-unoff">
    <header><b id="ab-unoff">Unofficial</b><span class="os-label os-amber">Fan project // non-commercial</span></header>
    <p>Doomsday Dossier is an unofficial, non-commercial fan project. It is not affiliated with, endorsed by or sponsored by Marvel, Marvel Studios or The Walt Disney Company. All character names, related marks and images are the property of their owners.</p>
    <p>Fan votes in the combat simulation are opinions, not facts, and are labelled that way. Voting uses Cloudflare Turnstile to keep bots out. The site stores no account, name, email or IP address: a vote is counted once per fight per day using a code that changes daily and cannot be traced back to you.</p>
    <p>DOOM-OS is drawn with WebGL (Three.js for Battleworld, a small shader for the scans), SVG and canvas; every sound is synthesised in the browser by this site's own code. Your verdicts, plans, decrees and royal log stay on your device. Reduced-motion settings are respected: with them on, every page is still and fully readable.</p>
  </section>
</OS>

<style is:global>
  .ab-grid { display: grid; gap: var(--os-gap); align-items: start; }
  @media (min-width: 960px) { .ab-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  .ab-orders, .ab-src { list-style: none; margin: 0; padding: 0; }
  .ab-orders li { display: grid; grid-template-columns: 82px minmax(0, 1fr); gap: 12px; padding: 10px 0; border-bottom: 1px dashed rgba(61, 255, 143, 0.12); }
  .ab-orders li:last-child { border-bottom: 0; }
  .ab-orders .os-label { color: var(--os-green-2); padding-top: 2px; }
  .ab-orders p { margin: 0; max-width: 70ch; }
  .ab-src li { display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 10px; padding: 7px 0; border-bottom: 1px dashed rgba(61, 255, 143, 0.12); }
  .ab-src .os-label { color: var(--os-green-2); padding-top: 2px; }
  .ab-src a { overflow-wrap: anywhere; text-underline-offset: 3px; text-decoration-color: rgba(61, 255, 143, 0.4); }
  .ab-src a:hover { text-decoration-color: var(--os-green); }
  .ab-checked { margin: 12px 0 0; }
  .ab-legal { margin-top: var(--os-gap); }
  .ab-legal p { margin: 0 0 10px; max-width: 90ch; }
  .ab-legal p:last-child { margin-bottom: 0; }
  @media (max-width: 560px) { .ab-orders li { grid-template-columns: minmax(0, 1fr); gap: 2px; } }
</style>

---
// DOOM-OS module 05, the probability engine (CLAUDE.md, "Design system v4"): the ten approved prediction questions
// (research/predictions.json) as terminal queries. Every answer feeds the engine's readout (the odds of calling them
// all by chance alone); locking in stamps the set SEALED; once locked, the fan split shows as bar readouts under each
// option. Everything is fan prediction, never fact. The v1 board (motion/predict.ts: Turnstile lock-in, the worker,
// the seal countdown, copy my picks) runs unchanged on the hooks below; scripts/os/pages/probability.ts adds the
// engine around it.
import OS from '../layouts/OS.astro';
import pred from '../../research/predictions.json';
import { OFFICIAL, fmtDate } from '../data/site';

// the arena worker also keeps predictions; without it configured the board says it opens soon
const api = import.meta.env.PUBLIC_ARENA_API ?? '';
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const data = JSON.stringify({ seal: pred.seal, questions: pred.questions, results: pred.results });
const pad = (n: number) => String(n).padStart(2, '0');
const KEYS = 'ABCDEFGH';
const total = pred.questions.length;
const questions = pred.questions.map((q) => ({ ...q, hint: (q as { hint?: string }).hint ?? '' }));
---
<OS title="Probability engine" page="predictions" description="Lock in your Avengers: Doomsday fan predictions before the board seals on 17 December 2026, then see how other fans are calling it. Ten questions written only from what Marvel has confirmed. Fan predictions, not facts.">
  <section class="pb" data-predict data-api={api} data-sitekey={sitekey}>
    <div class="mod-head">
      <div>
        <p class="os-label">Module 05 // Probability engine &middot; fan prediction</p>
        <h1 class="os-display os-hi mod-title">Call it</h1>
        <p class="mod-sub">Ten questions about Avengers: Doomsday, written only from what Marvel has confirmed: no rumours, no leaks. Feed the engine an answer to each, Your Majesty, and seal your calls. You can change them until the board seals; once the film is out, every call is checked against the record. Fan predictions, not facts.</p>
      </div>
      <div class="os-panel pb-seal">
        <header><b>Board seals in</b><span class="os-label">Fan prediction</span></header>
        <b class="pb-count" data-seal-count>&nbsp;</b>
        <p class="pb-seal-at os-label" data-seal-at>at the first moment 18 December begins anywhere on Earth</p>
      </div>
    </div>

    <div class="pb-grid">
      <ol class="pb-list">
        {questions.map((q, i) => (
          <li class="os-panel pb-q" data-q={q.id} data-os-in>
            <header><b>Query {pad(i + 1)} / {pad(total)}</b><span class="os-label" data-pb-qst>Awaiting input</span></header>
            <p class="pb-prompt" aria-hidden="true"><span class="os-hi">DOOM-OS:\&gt;</span> predict --query {pad(i + 1)}</p>
            <h2 class="pb-text">{q.text}</h2>
            {q.hint && <p class="pb-hint">{q.hint}</p>}
            <div class="pr-opts pb-opts" role="radiogroup" aria-label={q.text}>
              {q.options.map((o, j) => (
                <button type="button" role="radio" aria-checked="false" data-opt={o.id}>
                  <span class="pb-key" aria-hidden="true">[{KEYS[j]}]</span>
                  <span class="pr-o-label">{o.label}</span>
                  <span class="pr-o-pct"></span>
                  <span class="pr-o-bar" aria-hidden="true"><i></i></span>
                </button>
              ))}
            </div>
            <p class="pb-read" data-pb-read>Chance alone: 1 in {q.options.length} ({(100 / q.options.length).toFixed(1)}%) &middot; awaiting input</p>
          </li>
        ))}
      </ol>

      <aside class="os-panel pb-dock" data-dock aria-label="Probability readout">
        <header><b>Probability readout</b><span class="os-label">Fan prediction</span></header>
        <p class="pb-progress"><b data-answered>0</b> / {total} <span>calls entered</span></p>
        <div class="pb-cells" data-pb-cells aria-hidden="true">{pred.questions.map((q, i) => <i data-cell={q.id}>{pad(i + 1)}</i>)}</div>
        <div class="pb-odds">
          <span class="os-label">A perfect set by chance alone</span>
          <b data-pb-odds>&mdash;</b>
          <span class="os-label pb-odds-k" data-pb-oddsk>if every option were equally likely</span>
        </div>
        <p class="pb-agree" data-pb-agree hidden></p>
        <p class="pb-sealed" data-pb-sealed hidden>Sealed &middot; fan prediction on file</p>
        <p class="pb-status" data-status role="status"></p>
        <div class="pb-ts" data-ts></div>
        <div class="pb-buttons">
          <button type="button" class="os-btn pb-lock" data-lock disabled>Lock in my predictions</button>
          <button type="button" class="os-btn pb-copy" data-copy hidden>Copy my predictions</button>
        </div>
      </aside>
    </div>

    <p class="pb-fine">Your picks are saved with a random code kept in this browser; nothing else about you is stored. Bots are kept out by Cloudflare Turnstile. The fan split appears once you lock in. Results are settled from the Marvel Cinematic Universe Wiki's page for the film after {fmtDate(OFFICIAL.film.releaseDate)}, and shown behind a spoiler warning. Fan predictions, not facts.</p>
    <div class="pb-stamp" data-stamp aria-hidden="true">Sealed<small>Fan prediction &middot; locked in</small></div>
  </section>
  <script type="application/json" id="pr-data" is:inline set:html={data} />
</OS>

<style is:global>
  .pb-seal { min-width: min(100%, 320px); box-sizing: border-box; }
  .pb-count { display: block; font-family: var(--os-display); font-weight: 700; font-size: clamp(26px, 3.4vw, 44px); line-height: 1.05; color: var(--os-green); text-shadow: var(--os-glow); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pb-seal-at { margin: 6px 0 0; text-transform: none; letter-spacing: 0.06em; max-width: 40ch; }

  .pb-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 340px); gap: var(--os-gap); align-items: start; }
  .pb-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--os-gap); min-width: 0; }
  .pb-q { transition: border-color 0.3s; }
  .pb-q.done { border-color: rgba(61, 255, 143, 0.4); }
  .pb-q.done > header span { color: var(--os-green); }
  .pb-prompt { margin: 0 0 4px; font-size: 11.5px; color: var(--os-dim); }
  .pb-text { margin: 0; font-family: var(--os-display); font-weight: 700; text-transform: uppercase; font-size: clamp(20px, 2.4vw, 30px); line-height: 1.05; color: var(--os-text); overflow-wrap: break-word; }
  .pb-hint { margin: 6px 0 0; font-size: 12px; color: var(--os-dim); }
  .pb-opts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 6px; margin-top: 14px; }
  .pb-opts button { font: inherit; position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 4px 10px; min-height: 46px; padding: 8px 12px; text-align: left; color: var(--os-text); background: rgba(61, 255, 143, 0.03); border: 1px solid var(--os-line); cursor: pointer; transition: border-color 0.2s, background 0.2s; }
  .pb-opts button:hover, .pb-opts button:focus-visible { border-color: var(--os-line-hi); }
  .pb-opts button[aria-checked='true'] { border-color: var(--os-green); background: rgba(61, 255, 143, 0.12); box-shadow: inset 3px 0 0 var(--os-green); }
  .pb-key { color: var(--os-green-2); font-size: 11px; font-weight: 700; }
  .pb-opts button[aria-checked='true'] .pb-key { color: var(--os-green); }
  .pr-o-label { font-size: 13px; min-width: 0; overflow-wrap: break-word; }
  .pr-o-pct { font-family: var(--os-display); font-size: 15px; color: var(--os-dim); font-variant-numeric: tabular-nums; }
  .pb-opts button[aria-checked='true'] .pr-o-pct { color: var(--os-green); }
  .pr-o-pct:empty { display: none; }
  /* the fan split as a bar readout under each option, once there is a split to show */
  .pr-o-bar { grid-column: 1 / -1; position: relative; height: 6px; background: rgba(61, 255, 143, 0.06); border: 1px solid rgba(61, 255, 143, 0.14); display: none; overflow: hidden; }
  .pb.has-split .pr-o-bar { display: block; }
  .pr-o-bar i { position: absolute; inset: 0; transform-origin: left; transform: scaleX(0); background: repeating-linear-gradient(90deg, var(--os-dim) 0 6px, transparent 6px 8px); }
  .pb-opts button[aria-checked='true'] .pr-o-bar i { background: repeating-linear-gradient(90deg, var(--os-green) 0 6px, transparent 6px 8px); box-shadow: 0 0 8px rgba(61, 255, 143, 0.4); }
  .pb.sealed .pb-opts button { pointer-events: none; }
  .pb-read { margin: 10px 0 0; font-size: 11px; letter-spacing: 0.08em; color: var(--os-dim); border-top: 1px dashed rgba(61, 255, 143, 0.12); padding-top: 8px; overflow-wrap: anywhere; }
  .pb-read b { color: var(--os-green); font-weight: 400; }

  .pb-dock { position: sticky; top: 64px; display: grid; gap: 10px; }
  .pb-progress { margin: 0; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--os-dim); }
  .pb-progress b { font-family: var(--os-display); font-size: 30px; color: var(--os-green); text-shadow: var(--os-glow); letter-spacing: 0; font-weight: 700; }
  .pb-cells { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; }
  .pb-cells i { font-style: normal; text-align: center; font-size: 10px; padding: 4px 0; border: 1px solid var(--os-line); color: var(--os-dim); transition: background 0.25s, color 0.25s; }
  .pb-cells i.on { background: var(--os-green); border-color: var(--os-green); color: #021008; }
  .pb-cells i.agree { box-shadow: inset 0 -3px 0 var(--os-amber); }
  .pb-odds { display: grid; gap: 2px; padding: 8px 0; border-top: 1px dashed rgba(61, 255, 143, 0.14); border-bottom: 1px dashed rgba(61, 255, 143, 0.14); }
  .pb-odds b { font-family: var(--os-display); font-weight: 700; font-size: 26px; line-height: 1.1; color: var(--os-text); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
  .pb-odds-k { text-transform: none; letter-spacing: 0.06em; }
  .pb-agree { margin: 0; font-size: 12px; color: var(--os-amber); }
  .pb-agree[hidden], .pb-sealed[hidden] { display: none; }
  .pb-sealed { justify-self: start; margin: 0; font-size: 10.5px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--os-green); border: 2px solid var(--os-green); padding: 3px 8px; transform: rotate(-3deg); }
  .pb-status { margin: 0; min-height: 1.3em; font-size: 12px; color: var(--os-text); }
  .pb-ts:empty { display: none; }
  .pb-buttons { display: flex; flex-wrap: wrap; gap: 6px; }
  .pb-lock { justify-content: center; min-height: 46px; flex: 1 1 auto; }
  .pb-lock:disabled { opacity: 0.35; cursor: not-allowed; }
  .pb-lock:disabled:hover { background: rgba(61, 255, 143, 0.06); color: var(--os-green); }
  .pb-copy { min-height: 46px; }
  .pb-copy[hidden] { display: none; }
  .pb-fine { margin: var(--os-gap) 0 0; font-size: 11px; color: var(--os-dim); max-width: 100ch; }

  /* SEALED: the stamp slams down over the screen (motion/predict.ts moves it; it starts unseen and untransformed) */
  .pb-stamp { position: fixed; left: 50%; top: 45%; z-index: 56; opacity: 0; pointer-events: none; display: grid; justify-items: center; gap: 4px; padding: 12px 28px 10px; font-family: var(--os-display); font-weight: 700; font-size: clamp(40px, 8vw, 96px); line-height: 1; letter-spacing: 0.18em; text-transform: uppercase; color: var(--os-green); border: 4px solid var(--os-green); background: rgba(2, 10, 6, 0.85); text-shadow: var(--os-glow); box-shadow: 0 0 40px rgba(61, 255, 143, 0.3), inset 0 0 24px rgba(61, 255, 143, 0.15); white-space: nowrap; }
  .pb-stamp small { font-family: var(--os-mono); font-weight: 400; font-size: clamp(9px, 1.2vw, 12px); letter-spacing: 0.24em; text-shadow: none; }

  @media (max-width: 899px) {
    .pb-grid { grid-template-columns: minmax(0, 1fr); }
    /* phones: the readout becomes a compact bar pinned to the foot of the screen */
    .pb-dock { position: sticky; top: auto; bottom: 0; z-index: 5; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 12px; padding: 8px 12px 10px; background: rgba(3, 12, 8, 0.96); box-shadow: 0 -16px 28px -10px var(--os-bg); }
    .pb-dock > header { grid-column: 1 / -1; margin-bottom: 4px; }
    .pb-cells, .pb-odds-k, .pb-copy, .pb-odds > .os-label:first-child { display: none; }
    .pb-progress { grid-column: 1; grid-row: 2; }
    .pb-progress b { font-size: 22px; }
    .pb-odds { grid-column: 1; grid-row: 3; padding: 0; border: 0; }
    .pb-odds b { font-size: 15px; }
    .pb-odds b::before { content: 'Chance alone: '; font-family: var(--os-mono); font-weight: 400; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--os-dim); }
    .pb-buttons { grid-column: 2; grid-row: 2 / span 2; }
    .pb-lock { min-height: 44px; padding: 8px 12px; font-size: 10px; letter-spacing: 0.12em; }
    .pb-agree, .pb-sealed, .pb-status, .pb-ts { grid-column: 1 / -1; }
    .pb-agree, .pb-status { font-size: 11px; }
    .pb-status:empty { min-height: 0; }
  }
  @media (max-width: 420px) {
    .pb-opts { grid-template-columns: minmax(0, 1fr); }
    .pb-count { font-size: 24px; }
    .pb-lock { max-width: 150px; white-space: normal; text-align: center; line-height: 1.25; }
  }
</style>

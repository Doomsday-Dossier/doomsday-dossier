---
// A target file in DOOM-OS (CLAUDE.md, "Design system v4"): one template for all 29. The target is scanned in from
// their photo and locked, identity and threat type in, and His Majesty passes judgement. Level 1, the 30-second
// brief, decrypts at once; Level 2 (the surveillance record: every live-action appearance and what Marvel
// confirmed) and Level 3 (the deep archive: origin, the comics by era, abilities, feats, notes) open on request.
// Then the signal history (every sighting by year), known associates (targets who shared the screen), the stills,
// and the next file. Every fact carries its numbered source.
import OS from '../../layouts/OS.astro';
import { getResearch, castFor, publishedOrder, TEAMS, OFFICIAL, SRC, Citer, u, heroName, fmtDate } from '../../data/site';
import { PHOTO_CREDIT } from '../../data/photos';
import { photos2For, pick2 } from '../../data/v2';
import { scanPhoto, versusOf, briefOf, threatOf, targets } from '../../data/os';
import ThreatDial from '../../components/ThreatDial.astro';

export function getStaticPaths() {
  return publishedOrder().map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params as { slug: string };
const r = getResearch(slug)!, c = castFor(slug)!, vs = versusOf(slug), b = briefOf(slug);
const team = TEAMS.find((t) => t.id === c.team)!;
const order = publishedOrder(), no = order.indexOf(slug) + 1, total = order.length;
const next = order[no % total], prev = order[(no - 2 + total) % total];
const name = heroName(slug), pad = (n: number) => String(n).padStart(2, '0');
const isDoom = slug === 'victor-von-doom';
const scan = scanPhoto(slug)!;
const fa = r.origin.firstAppearance;
const named = !!(c.character && c.roleSource);
const sup = (nums: number[], anchor: string) => nums.map((n) => `<sup class="cite"><a href="#${anchor}">${n}</a></sup>`).join('');

// LEVEL 1: identity and the 30-second brief
const cBrief = new Citer();
const nRole = cBrief.cite([SRC[named ? c.roleSource! : 'S_LIVE']]);
const faNum = fa.issue.replace('#', '');
const faSrc = r.origin.sources.find((x) => x.label.includes(fa.title.split(':')[0]) && new RegExp(`(\\b|#)${faNum}\\b`).test(x.label)) ?? r.origin.sources[0];
const nFa = cBrief.cite([faSrc]);
const nB = cBrief.cite(b?.sources?.length ? b.sources : [faSrc]);
const identity = [
  // `aka`: a second real name the reader will know, such as Magneto's Erik Lehnsherr from the films
  { k: 'Real name', v: (r as any).aka ? `${r.name}; also ${(r as any).aka}` : r.name, n: [] as number[] },
  { k: 'Codename', v: r.alias, n: [] },
  { k: 'Continent', v: team.name, n: [] },
  { k: 'In Doomsday', v: named ? `${c.actor}, as ${c.character}` : `${c.actor} (on Marvel's cast list; role not yet named)`, n: nRole },
  { k: 'First seen', v: `${fa.title} ${fa.issue}, ${fa.coverDate}`, n: nFa },
  { k: 'Created by', v: r.origin.creators.join(', '), n: nFa },
];
const last = b?.lastSeen ? `${b.lastSeen.title} (${b.lastSeen.year}), as ${b.lastSeen.role}: ${b.lastSeen.note}` : `Avengers: Doomsday is ${c.actor}'s first live-action appearance in the role.`;
const brief = [
  { k: 'Who', v: b?.who ?? `${r.name}, known as ${r.alias}.`, n: nB.slice(0, 1) },
  { k: 'Abilities', v: b?.powers ?? vs.abilities.slice(0, 3).map((a: any) => a.name).join(' · '), n: nB.slice(0, 1) },
  { k: 'In Doomsday', v: b?.doomsday ?? (named ? `${c.actor} plays ${c.character}.` : `Marvel lists ${c.actor} in the cast.`), n: nRole },
  { k: 'Last seen', v: last, n: b?.lastSeen ? nB.slice(-1) : [] },
];

// THREAT: Marvel's power grid
const grid = (vs.powerGrid?.values ?? null) as Record<string, number> | null;
const threat = grid ? Object.values(grid).reduce((a, v) => a + v, 0) : null;
const th = threatOf(slug);
const nGrid = grid && vs.powerGrid.source ? cBrief.cite([vs.powerGrid.source]) : [];

// LEVEL 2: the surveillance record
const cRec = new Citer();
const screen = [...r.screen].sort((a, x) => a.year - x.year).map((s) => ({ ...s, nums: cRec.cite(s.sources) }));
const mcu = screen.filter((s) => s.continuity === 'MCU').length;
const surname = c.actor.replace(/ Jr\.$/, '').split(' ').slice(-1)[0];
const wordRe = new RegExp(`\\b${surname}\\b`);
const mentions = OFFICIAL.milestones.filter((m: any) => m.text.includes(c.actor) || (c.character && m.text.includes(c.character)) || wordRe.test(m.text)).map((m: any) => ({ ...m, n: cRec.cite([SRC[m.source]]) }));
const nFilm = cRec.cite([SRC.S_FILM]);

// LEVEL 3: the deep archive
const cArc = new Citer();
const originN = cArc.cite(r.origin.sources);
const comics = r.comics.map((e) => ({ ...e, n: cArc.cite(e.sources) }));
const abilities = (vs.abilities as any[]).map((a) => ({ ...a, n: cArc.cite(a.sources) }));
const origins = (vs.powerOrigins as any[]).map((o) => ({ ...o, n: cArc.cite(o.sources) }));
const feats = (vs.feats as any[] ?? []).map((f) => ({ ...f, n: cArc.cite(f.sources) }));
const notes = (r.trivia ?? []).map((x) => ({ ...x, n: cArc.cite(x.sources) }));

// SIGNAL HISTORY: every sighting by year, from the first comic to Doomsday
const y0 = Math.min(Number((fa.coverDate.match(/\d{4}/) ?? ['1960'])[0]), ...screen.map((s) => s.year));
const years = Array.from({ length: 2026 - y0 + 1 }, (_, i) => y0 + i);
const eraYears = new Set<number>();
for (const e of r.comics) { const m = e.years.match(/(\d{4})(?:\D+(\d{4}|present))?/i); if (m) { const a = +m[1], z = m[2] ? (m[2].toLowerCase() === 'present' ? 2026 : +m[2]) : a; for (let y = a; y <= z; y++) eraYears.add(y); } }
const sig = years.map((y) => ({ y, screen: screen.filter((s) => s.year === y), comics: eraYears.has(y) }));
const sigMax = Math.max(1, ...sig.map((x) => x.screen.length));

// KNOWN ASSOCIATES: targets who shared a released title on screen
const norm = (t: string) => t.toLowerCase().replace(/[^a-z0-9]/g, '');
const mine = new Set(r.screen.map((s) => norm(s.title)));
const all = targets();
const assoc = all.filter((t) => t.slug !== slug).map((t) => {
  const shared = getResearch(t.slug)!.screen.filter((s) => mine.has(norm(s.title))).map((s) => s.title);
  return { slug: t.slug, name: t.name, no: t.no, href: t.href, tile: t.tile, shared: [...new Set(shared)] };
}).filter((a) => a.shared.length).sort((a, x) => x.shared.length - a.shared.length || a.no - x.no).slice(0, 10);

// STILLS, and the next file
const stills = photos2For(slug).map((p, i) => ({ src: pick2(p.full, 1280), w: p.w, h: p.h, focus: p.focus, n: i + 1 }));
const nx = all.find((t) => t.slug === next)!, pv = all.find((t) => t.slug === prev)!;
const me = all.find((t) => t.slug === slug)!;
const data = { slug, no, name, alias: r.alias, photo: scan.photo, depth: scan.depth, head: scan.head, bbox: scan.bbox, grid, threat, abilities: abilities.slice(0, 2).map((a) => a.name), isDoom };
---
<OS title={`${name}: target file`} page="file" module="targets" description={`${name} (${r.alias}) in Avengers: Doomsday: who they are, their powers, every live-action appearance and their comics history, with sources. An unofficial fan file.`}>
  <nav class="f-top" aria-label="Files">
    <a class="os-btn" href={u('/targets/')}>&larr; Register</a>
    <span class="os-label f-code">File T-{pad(no)} / {total} &middot; {slug.toUpperCase()}</span>
    <span class="f-pn"><a class="os-btn" href={pv.href} aria-label={`Previous file: ${pv.name}`}>&lsaquo; T-{pad(pv.no)}</a><a class="os-btn" href={nx.href} aria-label={`Next file: ${nx.name}`}>T-{pad(nx.no)} &rsaquo;</a></span>
  </nav>

  <section class="f-main">
    <div class="f-scan" data-f-scan>
      <img class="f-still" src={scan.photo} alt={`${name}, scanned`} />
      <div class="acq" data-acq aria-hidden="true"><i></i><span>Acquiring signal</span></div>
      <canvas data-scan aria-hidden="true"></canvas>
      <svg class="co-layer" data-co aria-hidden="true"></svg>
      <div class="os-reticle" data-ret hidden><Fragment set:html={`<svg viewBox="0 0 120 120" aria-hidden="true"><g class="spin" fill="none" stroke="#3dff8f" stroke-width="1.2"><circle cx="60" cy="60" r="44" stroke-dasharray="10 8" /></g><g fill="none" stroke="#3dff8f" stroke-width="1.5"><path d="M60 4v18M60 98v18M4 60h18M98 60h18" /><circle cx="60" cy="60" r="3" fill="#3dff8f" /></g></svg>`} /><span class="lock os-label os-hi">Target locked</span></div>
      <span class="f-status os-label os-hi" data-status>Acquiring</span>
      <span class="f-stamp" data-stamp hidden></span>
    </div>
    <div class="f-read">
      <p class="os-label">Target {pad(no)} of {total} &middot; {team.name}{isDoom && ' · Your Majesty'}</p>
      <h1 class="os-display os-hi f-name" data-name>{name}</h1>
      <div class="os-panel" data-os-in>
        <header><b>Identity</b><span class="os-label">Confirmed</span></header>
        {identity.map((x) => <div class="os-row"><span>{x.k}</span><span><span data-type>{x.v}</span><Fragment set:html={sup(x.n, 'src-brief')} /></span></div>)}
      </div>
      <div class="os-panel os-inst" data-os-in>
        <header><b>Threat index</b><span class="os-label">{grid ? 'Marvel power grid' : 'No grid'}</span></header>
        <div class="th-main">
          <div class="th-dial">
            <ThreatDial total={th.total} band={th.band.id} size="l" />
            <p class="th-n"><b class={th.band.cls}>{th.total ?? '?'}</b><span class="os-label">/ 42</span></p>
          </div>
          <div class="th-read">
            {th.rank && <p class="th-rank"><b class={th.band.cls}>#{th.rank}</b> <span class="os-label">{th.joint ? 'joint ' : ''}of {th.of} rated targets</span></p>}
            <p class={`th-band ${th.band.cls}`}>{th.band.name}</p>
            <p class="th-line"><span class="os-label">Doom:</span> {th.band.line}</p>
          </div>
        </div>
        <p class="os-label th-how">{grid ? <Fragment>Marvel's six power ratings, 1 to 7 each, added up out of 42<Fragment set:html={sup(nGrid, 'src-brief')} />. The bands and Doom's words are this site's.</Fragment> : 'Marvel never published a power grid for this target.'}</p>
        {grid && <div data-radar></div>}
      </div>
      {!isDoom ? (
        <div class="os-panel verdict" data-verdict-panel data-os-in>
          <header><b>Your judgement</b><span class="os-label">Fan opinion &middot; this device</span></header>
          <p class="v-ask">How shall Your Majesty regard {name}?</p>
          <div class="v-btns">
            <button data-v="ally"><b>Ally</b><span>Useful, for now</span></button>
            <button data-v="pawn"><b>Pawn</b><span>To be moved</span></button>
            <button data-v="obstacle"><b>Obstacle</b><span>To be removed</span></button>
            <button data-v="beneath"><b>Beneath notice</b><span>Not worth the ink</span></button>
          </div>
        </div>
      ) : (
        <div class="os-panel verdict" data-os-in><header><b>Your judgement</b><span class="os-label">Mirror</span></header><p class="v-ask">Doom does not judge Doom. The file is Your Majesty's own.</p></div>
      )}
    </div>
  </section>

  <section class="f-lv os-panel" data-os-in>
    <header><b>Level 1 // The brief</b><span class="os-label">Decrypted &middot; 30 seconds</span></header>
    <div class="brief">
      {brief.map((x) => <div class="os-row"><span>{x.k}</span><span><span data-decrypt>{x.v}</span><Fragment set:html={sup(x.n, 'src-brief')} /></span></div>)}
    </div>
    <details class="os-src" id="src-brief"><summary>Sources</summary><ol class="srcs">{cBrief.list.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}</ol></details>
  </section>

  <section class="f-lv os-panel locked" data-level="2" data-os-in>
    <header><b>Level 2 // Surveillance record</b><span class="os-label">On screen &middot; {screen.length} sightings, {mcu} in the MCU</span></header>
    <div class="lock-gate" data-gate-for="2"><p>Every live-action sighting of {name}, and everything Marvel has confirmed.</p><button class="os-btn" data-clear="2">Request level 2 clearance</button></div>
    <div class="lv-body" inert>
      <ol class="rec">
        {screen.map((s) => (
          <li>
            <span class="rec-y">{s.year}</span>
            <div><b data-head>{s.title}</b> <span class={`os-chip ${s.continuity === 'MCU' ? 'hi' : ''}`}>{s.continuity}</span>{s.cameo && <span class="os-chip">Cameo</span>}<p><span class="os-label">{s.actor}</span> {s.summary}<Fragment set:html={sup(s.nums, 'src-rec')} /></p></div>
          </li>
        ))}
      </ol>
      <h3 class="lv-h" data-head>What Marvel confirmed</h3>
      <ul class="conf">
        <li><b>The film.</b> Avengers: Doomsday opens 18 December 2026.<Fragment set:html={sup(nFilm, 'src-rec')} /></li>
        {mentions.map((m: any) => <li><span class="os-label">{fmtDate(m.date)}</span> <b>{m.title}.</b> <Fragment set:html={m.text + sup(m.n, 'src-rec')} /></li>)}
      </ul>
      <details class="os-src" id="src-rec"><summary>Sources</summary><ol class="srcs">{cRec.list.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}</ol></details>
    </div>
  </section>

  <section class="f-lv os-panel locked" data-level="3" data-os-in>
    <header><b>Level 3 // Deep archive</b><span class="os-label">The comics &middot; since {fa.coverDate}</span></header>
    <div class="lock-gate" data-gate-for="3"><p>Origin, the comics by era, abilities and recorded feats.</p><button class="os-btn" data-clear="3">Request level 3 clearance</button></div>
    <div class="lv-body" inert>
      <h3 class="lv-h" data-head>Origin</h3>
      {r.origin.summary.map((p, i) => <p class="para">{p}{i === r.origin.summary.length - 1 && <Fragment set:html={sup(originN, 'src-arc')} />}</p>)}
      <h3 class="lv-h" data-head>The record, by era</h3>
      <ol class="eras">
        {comics.map((e) => <li><span class="rec-y">{e.years}</span><div><b data-head>{e.title}</b> <span class="os-chip">{e.era}</span><p>{e.summary}<Fragment set:html={sup(e.n, 'src-arc')} /></p>{e.keyIssues?.length > 0 && <p class="os-label">Key issues: {e.keyIssues.join(' · ')}</p>}</div></li>)}
      </ol>
      <h3 class="lv-h" data-head>Capabilities</h3>
      <div class="abil-grid">{abilities.map((a) => <div class="abil"><b>{a.name}</b><p>{a.detail}<Fragment set:html={sup(a.n, 'src-arc')} /></p></div>)}</div>
      {origins.length > 0 && <Fragment><h3 class="lv-h" data-head>Source of power</h3>{origins.map((o) => <p class="para">{o.detail}<Fragment set:html={sup(o.n, 'src-arc')} /></p>)}</Fragment>}
      {feats.length > 0 && <Fragment><h3 class="lv-h" data-head>Recorded feats</h3><ul class="conf">{feats.map((f) => <li><span class="os-chip">{f.medium}</span> {f.text} <span class="os-label">{f.where}</span><Fragment set:html={sup(f.n, 'src-arc')} /></li>)}</ul></Fragment>}
      {notes.length > 0 && <Fragment><h3 class="lv-h" data-head>Notes from the archive</h3><ul class="conf">{notes.map((x) => <li>{x.fact}<Fragment set:html={sup(x.n, 'src-arc')} /></li>)}</ul></Fragment>}
      <details class="os-src" id="src-arc"><summary>Sources</summary><ol class="srcs">{cArc.list.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.label}</a></li>)}</ol></details>
    </div>
  </section>

  <section class="f-two">
    <div class="os-panel os-inst" data-os-in>
      <header><b>Signal history</b><span class="os-label">{y0} to 2026 &middot; bars: screen &middot; line: comics eras</span></header>
      <div class="sig" data-sig role="img" aria-label={`Sightings of ${name} by year from ${y0} to 2026: ${screen.length} on screen.`}>
        {sig.map((x) => (
          <span class={`sg${x.comics ? ' c' : ''}${x.y === 2026 ? ' now' : ''}`} style={`--h:${x.screen.length / sigMax}`} title={`${x.y}${x.screen.length ? ': ' + x.screen.map((s) => s.title).join(', ') : ''}`}><i></i></span>
        ))}
      </div>
      <div class="sig-axis os-label"><span>{y0}</span><span>{Math.round((y0 + 2026) / 2)}</span><span>2026 &middot; Doomsday</span></div>
    </div>
    <div class="os-panel os-inst" data-os-in>
      <header><b>Known associates</b><span class="os-label">Shared the screen</span></header>
      {assoc.length ? (
        <div class="assoc" data-assoc>
          <svg class="assoc-lines" data-assoc-lines aria-hidden="true"></svg>
          <span class="assoc-me"><img src={me.tile} alt="" /><b>{name}</b></span>
          {assoc.map((a, i) => (
            <a class="assoc-n" href={a.href} style={`--i:${i};--n:${assoc.length};--w:${a.shared.length}`} data-w={a.shared.length} title={`Shared: ${a.shared.join(', ')}`}>
              <img src={a.tile} alt="" loading="lazy" class="os-tint" /><b>{a.name}</b><span>{a.shared.length} shared</span>
            </a>
          ))}
        </div>
      ) : <p class="os-label">No released title puts {name} on screen with another target yet. Doomsday will be the first.</p>}
    </div>
  </section>

  <section class="os-panel stills" data-os-in>
    <header><b>Stills on file</b><span class="os-label">{PHOTO_CREDIT}</span></header>
    <div class="st-row">
      {stills.map((p) => <figure class="st scanhov"><img src={p.src} alt={`${name}, still ${p.n}`} loading="lazy" width={p.w} height={p.h} style={`object-position:${p.focus}`} /><figcaption class="os-label">Still {pad(p.n)} &middot; T-{pad(no)}</figcaption></figure>)}
    </div>
  </section>

  <a class="nextf" href={nx.href}>
    <span class="nextf-img"><img src={nx.tile} alt="" loading="lazy" class="os-tint" /></span>
    <span><span class="os-label">Next file &middot; T-{pad(nx.no)}</span><b class="os-display os-hi">{nx.name}</b><span class="os-label">{nx.team}</span></span>
    <i aria-hidden="true">&rsaquo;</i>
  </a>
  <script type="application/json" data-file is:inline set:html={JSON.stringify(data)} />
</OS>

<style is:global>
  .f-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin: 6px 0 var(--os-gap); flex-wrap: wrap; }
  .f-top .os-btn { padding: 7px 11px; font-size: 11px; }
  .f-pn { display: flex; gap: 6px; }
  .f-main { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: var(--os-gap); align-items: start; }
  .f-scan { position: sticky; top: 64px; height: min(78svh, 780px); border: 1px solid var(--os-line); background: radial-gradient(circle at 50% 35%, rgba(61, 255, 143, 0.08), transparent 70%); }
  .f-scan canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .f-still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; }
  html.no-scan .f-still { opacity: 1; filter: grayscale(1) sepia(1) hue-rotate(80deg) saturate(2) brightness(1.4); }
  .f-status { position: absolute; left: 12px; bottom: 10px; max-width: calc(100% - 24px); padding: 3px 8px; background: rgba(2, 8, 5, 0.82); white-space: nowrap; overflow: hidden; }
  .os-reticle .lock { position: absolute; left: 100%; top: 50%; white-space: nowrap; margin-left: 4px; opacity: 0; transition: opacity 0.3s; }
  .os-reticle.locked .lock { opacity: 1; }
  .f-stamp { position: absolute; right: 16px; top: 16px; font: 700 15px var(--os-mono); letter-spacing: 0.2em; text-transform: uppercase; border: 2px solid currentColor; padding: 6px 12px; transform: rotate(-8deg); background: rgba(2, 5, 4, 0.7); }
  .f-stamp[hidden] { display: none; }
  .f-read { display: grid; gap: 12px; }
  .f-read > .os-label { margin: 0; }
  .f-name { font-size: clamp(36px, 5.4vw, 80px); overflow-wrap: anywhere; }
  .th-main { display: grid; grid-template-columns: minmax(130px, 200px) minmax(0, 1fr); gap: 14px; align-items: center; }
  .th-dial { display: grid; justify-items: center; gap: 2px; }
  .th-n { display: flex; align-items: baseline; gap: 6px; margin: 0; }
  .th-n b { font-family: var(--os-display); font-size: 30px; line-height: 1; }
  .th-read p { margin: 0; }
  .th-rank b { font-family: var(--os-display); font-size: 30px; line-height: 1; }
  .th-band { font-family: var(--os-display); font-size: 21px; text-transform: uppercase; letter-spacing: 0.02em; margin-top: 2px !important; }
  .th-line { margin-top: 6px !important; font-size: 14px; line-height: 1.4; color: var(--os-text); }
  .th-how { margin: 8px 0 6px; font-size: 11px; letter-spacing: 0.1em; line-height: 1.5; }
  @media (max-width: 420px) { .th-main { grid-template-columns: minmax(0, 1fr); } .th-dial { max-width: 220px; } }
  .v-ask { margin: 0 0 10px; }
  .v-btns { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .v-btns button { font: inherit; text-align: left; display: grid; gap: 2px; padding: 9px 10px; color: var(--os-text); background: rgba(61, 255, 143, 0.03); border: 1px solid var(--os-line); cursor: pointer; }
  .v-btns button b { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; }
  .v-btns button span { font-size: 11px; color: var(--os-dim); }
  .v-btns button:hover { border-color: var(--os-line-hi); }
  .v-btns button[aria-pressed='true'] { border-color: currentColor; background: rgba(61, 255, 143, 0.1); }
  .v-btns [data-v='ally'] b { color: var(--os-green); } .v-btns [data-v='pawn'] b { color: #9fd8ff; } .v-btns [data-v='obstacle'] b { color: var(--os-red); } .v-btns [data-v='beneath'] b { color: var(--os-dim); }
  .f-lv, .f-two, .stills, .nextf { margin-top: var(--os-gap); }
  .brief .os-row { grid-template-columns: 130px minmax(0, 1fr); font-size: 13px; }

---
// A classified file, design system v3: one template for all 29 characters, in clearance levels (CLAUDE.md,
// fifth interview). The hero (the subject in front of their name, with their signature sound), then Level 1,
// the 30-second briefing, on the sheet inside the folder as its redaction bars tear away: who they are, what
// they can do, why they matter in Doomsday (Marvel's word only) and where you last saw them. "Request
// clearance" tears open Level 2 (on screen: the subject, every live-action appearance, the prints, what Marvel
// confirmed) and Level 3 (the comics: origin, the record by era, abilities, the power grid, file notes).
import Dossier from '../../layouts/Dossier.astro';
import '../../styles/faces';
import { DESIGN, getResearch, castFor, publishedOrder, TEAMS, OFFICIAL, SRC, Citer, u, fmtDate, heroName } from '../../data/site';
import { PHOTO_CREDIT } from '../../data/photos';
import { accentOf, photos2For, pick2, srcset2, anchorsFor, dioFor } from '../../data/v2';

type Brief = { who: string; powers: string; doomsday: string; lastSeen: { title: string; year: number; role: string; note: string } | null; sources: { label: string; url: string }[] };
const BRIEF_FILE = import.meta.glob('../../../research/briefs.json', { eager: true, import: 'default' }) as Record<string, Record<string, Brief>>;
const BRIEFS = Object.values(BRIEF_FILE)[0] ?? {};
const VS = import.meta.glob('../../../research/versus/*.json', { eager: true, import: 'default' }) as Record<string, any>;

export function getStaticPaths() {
  return publishedOrder().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params as { slug: string };
const d = DESIGN[slug];
const r = getResearch(slug)!;
const c = castFor(slug)!;
const vs = VS[`../../../research/versus/${slug}.json`];
const team = TEAMS.find((t) => t.id === c.team)!;
const order = publishedOrder();
const no = order.indexOf(slug) + 1;
const next = order[no % order.length];
const isDoom = slug === 'victor-von-doom';
const accent = accentOf(slug);
const ph = photos2For(slug);
const fa = r.origin.firstAppearance;
const name = heroName(slug).toUpperCase();
const pad = (n: number) => String(n).padStart(2, '0');
const sup = (nums: number[], anchor: string) => nums.map((n) => `<sup class="cite"><a href="#${anchor}">${n}</a></sup>`).join('');
const EVENT: Record<string, string> = { S_SDCC24: 'Comic-Con 2024', S_TEASERS: 'a Doomsday teaser', S_TRAILER: 'the official trailer', S_SDCC26: 'Comic-Con 2026', S_D23: 'D23 2026', S_LIVE: 'the March 2025 cast reveal' };
const named = !!(c.character && c.roleSource);

// I. the file sheet: Marvel's confirmation and the first appearance
const cFile = new Citer();
const nRole = cFile.cite([SRC[named ? c.roleSource! : 'S_LIVE']])[0];
const roleLine = named ? `${c.actor}, named by Marvel as ${c.character}` : `Marvel lists ${c.actor} in the cast; the role is not yet named`;
const faNum = fa.issue.replace('#', '');
const faSrc = r.origin.sources.find((x) => x.label.includes(fa.title.split(':')[0]) && new RegExp(`(\\b|#)${faNum}\\b`).test(x.label)) ?? r.origin.sources[0];
const nFilm = cFile.cite([SRC.S_FILM])[0];
const aliasLine = isDoom ? `${r.alias} · Monarch of Latveria` : r.alias && r.alias.toUpperCase() !== name ? `${r.alias} · ${team.name}` : team.name;
const stampBig = isDoom ? 'Adversary' : named ? 'Named' : 'In the cast';
const stampSmall = named ? `Role named by Marvel · ${EVENT[c.roleSource!] ?? 'Marvel'}` : 'Marvel cast list · March 2025';

// II. the subject: callouts pinned to points on the lead photo (u, v from its top-left), and key traits
const cSub = new Citer();
const A = anchorsFor(slug);
const sdcc26 = OFFICIAL.milestones.find((m) => m.source === 'S_SDCC26');
const ab = vs.abilities as { name: string; detail: string; sources: { label: string; url: string }[] }[];
const callouts = (isDoom ? [
  { u: 0.5, v: 0.5, k: 'The mask', t: 'Forged by the monks who trained him, and pressed to his face before it had cooled.', n: cSub.cite([r.origin.sources[0], r.origin.sources[3]]) },
  { u: 0.53, v: 0.62, k: 'Beneath it', t: 'A scar from his own exploding machine at State University, which his pride turned into ruin.', n: cSub.cite([r.origin.sources[0]]) },
  { u: 0.36, v: 0.42, k: 'The green', t: sdcc26 ? 'His cloak colour: at Comic-Con 2026 Marvel turned all of Hall H green, in Doom masks and capes.' : 'His cloak colour since the comics began.', n: sdcc26 ? cSub.cite([SRC.S_SDCC26]) : cSub.cite([r.origin.sources[1]]) },
  { u: 0.71, v: 0.88, k: 'The armour', t: ab[2].detail, n: cSub.cite(ab[2].sources) },
] : [
  { u: A[0][0], v: A[0][1], k: 'First seen', t: `${fa.title} ${fa.issue}, cover date ${fa.coverDate}. Created by ${r.origin.creators.join(' and ')}.`, n: cSub.cite([faSrc]) },
  ab[0] && { u: A[1][0], v: A[1][1], k: ab[0].name, t: ab[0].detail, n: cSub.cite(ab[0].sources) },
  ab[1] && { u: A[2][0], v: A[2][1], k: ab[1].name, t: ab[1].detail, n: cSub.cite(ab[1].sources) },
  vs.powerOrigins[0] && { u: A[3][0], v: A[3][1], k: 'Power source', t: vs.powerOrigins[0].detail, n: cSub.cite(vs.powerOrigins[0].sources) },
]).filter(Boolean) as { u: number; v: number; k: string; t: string; n: number[] }[];
const grid = vs.powerGrid?.values as Record<string, number> | null;
const gridLabels: Record<string, string> = { intelligence: 'Intelligence', strength: 'Strength', speed: 'Speed', durability: 'Durability', energyProjection: 'Energy projection', fightingSkills: 'Fighting skills' };
const nGrid = grid && vs.powerGrid.source ? cSub.cite([vs.powerGrid.source])[0] : null;
const abilities = ab.map((a) => ({ ...a, n: cSub.cite(a.sources) }));
// Level 1: the 30-second briefing (research/briefs.json, sourced from the research files and official.json)
const brief = BRIEFS[slug] ?? null;
const nBrief = cFile.cite(brief?.sources.length ? brief.sources : [faSrc]);
const lastSeenLine = brief?.lastSeen
  ? `${brief.lastSeen.title} (${brief.lastSeen.year}), as ${brief.lastSeen.role}: ${brief.lastSeen.note}`
  : `Avengers: Doomsday is ${c.actor}'s first live-action appearance in the role.`;
const level1 = [
  { k: 'Who', v: brief?.who ?? `${r.name}, known as ${r.alias}.`, n: nBrief.slice(0, 1) },
  { k: 'What they can do', v: brief?.powers ?? ab.slice(0, 3).map((a) => a.name).join(' · '), n: brief ? nBrief.slice(0, 1) : ab[0] ? cFile.cite(ab[0].sources) : [] },
  { k: 'In Doomsday', v: brief?.doomsday ?? roleLine, n: [nRole, nFilm] },
  { k: 'Last seen', v: lastSeenLine, n: brief?.lastSeen ? nBrief.slice(-1) : [] },
];

// III to V: origin, the comics record, sightings on screen
const cOrigin = new Citer(); const originNums = cOrigin.cite(r.origin.sources);
const cComics = new Citer(); const comics = r.comics.map((e) => ({ ...e, nums: cComics.cite(e.sources) }));
const cScreen = new Citer(); const screen = [...r.screen].sort((a, b) => a.year - b.year).map((s) => ({ ...s, nums: cScreen.cite(s.sources) }));
const cNotes = new Citer(); const notes = (r.trivia ?? []).map((x) => ({ ...x, nums: cNotes.cite(x.sources) }));
const mcuCount = screen.filter((x) => x.continuity === 'MCU').length;
const keyRows = isDoom
  ? [{ k: 'Real name', v: r.name }, { k: 'Alias', v: r.alias }, { k: 'Rules', v: 'Latveria, from Doomstadt', n: originNums.slice(0, 1) }]
  : [{ k: 'Real name', v: r.name }, { k: 'Alias', v: r.alias }, { k: 'Team', v: team.name }, { k: 'In Doomsday', v: c.actor }];

// VI: only what Marvel confirmed
const cDoom = new Citer();
const dFilm = cDoom.cite([SRC.S_FILM])[0];
const dRole = named ? cDoom.cite([SRC[c.roleSource!]])[0] : null;
const surname = c.actor.replace(/ Jr\.$/, '').split(' ').slice(-1)[0];
const wordRe = new RegExp(`\\b${surname}\\b`);
const mentions = OFFICIAL.milestones.filter((m) => m.text.includes(c.actor) || (c.character && m.text.includes(c.character)) || wordRe.test(m.text)).map((m) => ({ ...m, num: cDoom.cite([SRC[m.source]])[0] }));
const lastScreen = [...r.screen].filter((x) => x.actor.startsWith(c.actor)).sort((a, b) => b.year - a.year)[0];

// photos (HD and cut-outs) and the figure
const lead = ph[0], p2 = ph[1], p3 = ph[2];
const heroCut = lead && lead.cut.length ? lead.cut : null;
// the name on the hero: two balanced lines when it has several words, sized by the longer line
const heroLines = (() => { const w = name.split(' '); let best = [name]; for (let i = 1; i < w.length; i++) { const l = [w.slice(0, i).join(' '), w.slice(i).join(' ')]; if (best.length === 1 || Math.max(...l.map((x) => x.length)) < Math.max(...best.map((x) => x.length))) best = l; } return best; })();
const longest = Math.max(...heroLines.map((l) => l.length));
const nextPh = photos2For(next)[0];
const files = order.map((x, i) => ({ slug: x, no: i + 1, name: heroName(x).toUpperCase(), accent: accentOf(x) }));
const styleVars = `--sig:${d.font};--sig-w:${d.fontWeight};--forged:${isDoom ? '#5c5f58' : accent};--longest:${longest}`;
---
<Dossier title={`${name}: classified file`} description={`The classified file on ${heroName(slug)}, opened.`} page="file" accent={accent} styleVars={styleVars}>
  <div class="tint" data-tint aria-hidden="true"></div>
  <article class="file" data-file data-slug={slug} data-scene={d.scene}>

    <!-- 0. THE SUBJECT, IN FRONT OF THEIR NAME (Obsidian, Lena Varga) -->
    <section class="hero" data-hero data-dio={JSON.stringify(dioFor(slug, heroLines, d.font, d.fontWeight))} aria-label={`${name}, file ${pad(no)}`}>
      <div class="hero-stage">
        <div class="hero-flood" data-flood aria-hidden="true"></div>
        {(p2 ?? lead) && <div class="hero-back" data-depth="0.12" aria-hidden="true"><img src={pick2((p2 ?? lead)!.full, 1280)} alt="" decoding="async" style={`object-position:${(p2 ?? lead)!.focus}`} /></div>}
        <div class="hero-glow" data-depth="0.3" aria-hidden="true"></div>
        <div class="hero-top t-label">
          <span class="t-accent" data-hin>File {pad(no)} / {order.length}</span>
          <span data-hin>{team.name}</span>
          <span class="t-ash" data-hin>{named ? 'Role named by Marvel' : 'In the cast'}</span>
        </div>
        <p class="hero-name" data-hero-name data-depth="0.45" data-fit aria-hidden="true">{heroLines.map((l) => <Fragment><span class="hw">{l}</span>{' '}</Fragment>)}</p>
        {lead && <div class={heroCut ? 'hero-subj' : 'hero-subj soft'} data-depth="0.9">{heroCut
          ? <img class="hero-cut" data-hero-cut style={`translate:${Math.round((0.5 - (lead.head?.[0] ?? 0.5)) * 1000) / 10}% 0`} src={pick2(heroCut, 1280)} srcset={srcset2(heroCut)} sizes="(min-width: 900px) 60vw, 100vw" width={lead.w} height={lead.h} alt="" fetchpriority="high" decoding="async" />
          : <img class="hero-cut hero-soft" data-hero-cut src={pick2(lead.full, 1280)} srcset={srcset2(lead.full)} sizes="100vw" width={lead.w} height={lead.h} alt="" fetchpriority="high" decoding="async" style={`object-position:${lead.focusM}`} />}</div>}
        <div class="hero-foot">
          <p class="t-label t-ash" data-hin>{aliasLine}</p>
          <p class="t-label hero-cue" data-hin>Scroll for the 30-second briefing</p>
        </div>
      </div>
    </section>

    <!-- LEVEL 1. THE 30-SECOND BRIEFING: the folder opens, the redaction bars tear off the facts -->
    <section class="open" data-open aria-labelledby="f-name">
      <div class="open-stage">
        <div class="folder" data-folder>
          <div class="sheet" data-sheet>
            <div class="sheet-head t-micro">
              <span>Latverian state archive</span><span>File {pad(no)} / {order.length}</span><span class="t-accent">Clearance level 1 &middot; the briefing</span>
            </div>
            <p class="t-label t-ash sheet-k">Subject</p>
            <h1 id="f-name" class="sig-name" data-fit>{name}</h1>
            <p class="t-label t-accent sheet-alias">{aliasLine}</p>
            <ul class="traits sheet-rows">
              {level1.map((row) => (
                <li><span class="k">{row.k}</span><span class="v"><span class="redact">{row.v}{row.n.length > 0 && <Fragment set:html={sup(row.n, 'src-file')} />}<span class="bar" data-bar></span></span></span></li>
              ))}
            </ul>
          </div>
          {[p2, p3].filter(Boolean).map((p, i) => <figure class={`print fp${i + 1}`} data-print><img src={pick2(p!.full, 640)} srcset={srcset2(p!.full)} sizes="(min-width: 900px) 20vw, 34vw" alt={`${heroName(slug)}, exhibit ${pad(no)}-${i ? 'C' : 'B'}`} width={p!.w} height={p!.h} loading="lazy" style={`object-position:${p!.focusM}`} /><figcaption>Exhibit {pad(no)}-{i ? 'C' : 'B'}</figcaption></figure>)}
          <div class="stamp-at"><span class="stamp" data-stamp><b>{stampBig}</b><small>{stampSmall}</small></span></div>
          <div class="cover" data-cover aria-hidden="true">
            <div class="cover-face">
              <span class="cover-tab t-label">File {pad(no)}</span>
              <div class="cover-top t-micro"><span>Property of the Latverian state</span><span>Do not remove from the archive</span></div>
              <p class="cover-name" data-fit>{name}</p>
              <div class="cover-bottom">
                <span class="t-label t-accent">Top secret &middot; three clearance levels</span>
                <span class="t-micro t-ash">{team.name} &middot; {r.alias}</span>
              </div>
              <i class="rivet r1"></i><i class="rivet r2"></i><i class="rivet r3"></i><i class="rivet r4"></i>
            </div>
            <div class="cover-back"></div>
          </div>
        </div>
        <p class="open-hint t-label t-ash" data-hint>Scroll for the 30-second briefing</p>
      </div>
      <details class="sources wrap file-src" id="src-file"><summary>Briefing sources ({cFile.list.length})</summary>
        <ol>{cFile.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
      </details>
    </section>

    <!-- LEVEL 2. ON SCREEN -->
    <div class="level" data-level="2" id="level-2" aria-labelledby="lv2-h">
      <header class="level-head wrap">
        <p class="t-label t-accent">Clearance level 2</p>
        <h2 id="lv2-h" class="t-title level-t" data-fit>On screen</h2>
        <p class="level-sub">The live-action story: the subject under the hood, {screen.length} appearances{mcuCount ? ` (${mcuCount} in the MCU)` : ''}, the prints on file and every word Marvel has said about Doomsday.</p>
      </header>
      <div class="level-body" data-level-body>

        <!-- the subject: one big graded print, the callouts pinned to it -->
        <section class="subject wrap" data-subject aria-labelledby="sub-h">
          <p class="t-label t-accent">The subject</p>
          <h3 id="sub-h" class="t-title chap" data-rise>Under the hood</h3>
          {lead && (
            <div class="sub-grid">
              <figure class="sub-photo" data-sub-photo style={`aspect-ratio:${lead.w} / ${lead.h};--ar:${(lead.w / lead.h).toFixed(4)}`}>
                <img src={pick2(lead.full, 1920)} srcset={srcset2(lead.full)} sizes="(min-width: 1100px) 62vw, 100vw" width={lead.w} height={lead.h} alt={`${heroName(slug)}, exhibit ${pad(no)}-A`} loading="lazy" decoding="async" data-sub-img />
                {callouts.map((k, i) => <span class="pin" data-pin style={`left:${k.u * 100}%;top:${k.v * 100}%`} aria-hidden="true"><i></i><b>{pad(i + 1)}</b></span>)}
              </figure>
              <ol class="callouts">
                {callouts.map((k, i) => (
                  <li class="callout" data-callout data-i={i}>
                    <span class="t-micro t-accent">{pad(i + 1)} &middot; {k.k}</span>
                    <span class="cal-t"><Fragment set:html={k.t + sup(k.n, 'src-sub')} /></span>
                  </li>
                ))}
              </ol>
            </div>
          )}
          <details class="sources" id="src-sub"><summary>Subject sources ({cSub.list.length})</summary>
            <ol>{cSub.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
          </details>
        </section>

        <!-- every live-action appearance, by year -->
        <section class="chapter-sec wrap" id="ch-screen" aria-labelledby="sig-h">
          <p class="t-label t-accent">Sightings on screen</p>
          <h3 id="sig-h" class="t-title chap" data-rise>{screen.length} live-action appearances</h3>
          <ol class="log">
            {screen.map((x, i) => (
              <li data-reveal id={`sig-${i}`} class={x.continuity === 'MCU' ? 'mcu' : ''}>
                <span class="log-y t-title">{x.year}</span>
                <span class="log-main">
                  <span class="log-tags t-micro"><span class="tag">{x.continuity}</span>{x.cameo && <span class="tag">Cameo</span>}</span>
                  <b class="log-t">{x.title}</b>
                  <span class="t-micro t-ash">Performer: {x.actor}</span>
                  <span class="log-s" set:html={x.summary + sup(x.nums, 'src-screen')} />
                </span>
              </li>
            ))}
          </ol>
          <details class="sources" id="src-screen"><summary>Screen sources ({cScreen.list.length})</summary>
            <ol>{cScreen.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
          </details>
        </section>

        <!-- the prints on file: each comes toward you as it passes (Oyla) -->
        {ph.length > 0 && (
          <section class="exhibits wrap" data-exhibits aria-labelledby="ex-h">
            <p class="t-label t-accent">Exhibits</p>
            <h3 id="ex-h" class="t-title chap" data-rise>{ph.length} {ph.length === 1 ? 'print' : 'prints'} on file</h3>
            <div class="ex-grid">
              {ph.map((p, i) => (
                <figure class={`ex ex${i + 1}`} data-ex>
                  <div class="ex-frame"><img src={pick2(p.full, 1280)} srcset={srcset2(p.full)} sizes="(min-width: 900px) 46vw, 92vw" width={p.w} height={p.h} alt={`${heroName(slug)}, exhibit ${pad(no)}-${'ABC'[i]}`} loading="lazy" decoding="async" style={`object-position:${p.focusM}`} /></div>
                  <figcaption class="t-micro"><span class="t-accent">Exhibit {pad(no)}-{'ABC'[i]}</span><span class="t-ash">{p.hd ? 'Enhanced print' : 'Original print'} &middot; graded to the archive &middot; {p.w} &times; {p.h}</span></figcaption>
                </figure>
              ))}
            </div>
            <p class="t-micro t-ash ex-credit">{PHOTO_CREDIT}</p>
          </section>
        )}

        <!-- only what Marvel confirmed -->
        <section class="chapter-sec wrap doom-sec" id="ch-doom" aria-labelledby="dd-h">
          <p class="t-label t-accent">In Avengers: Doomsday</p>
          <h3 id="dd-h" class="t-title chap" data-rise>What Marvel has confirmed</h3>
          <p class="t-ash">Only what Marvel has announced. No rumours, no leaks, no guesses.</p>
          <div class="dd-grid">
            <div data-reveal><p class="t-micro t-ash">Cast</p><p class="dd-big t-title">{c.actor}</p><p set:html={`Marvel lists ${c.actor} in the cast.${sup([dFilm], 'src-doom')}`} /></div>
            {named ? (
              <div data-reveal><p class="t-micro t-ash">Role</p><p class="dd-big t-title">{c.character}</p><p set:html={`Named by Marvel in ${EVENT[c.roleSource!] ?? 'an announcement'}.${sup([dRole!], 'src-doom')}`} /></div>
            ) : (
              <div data-reveal><p class="t-micro t-ash">Role</p><p class="dd-big t-title">Not yet named</p><p>Marvel has not said which character {c.actor} plays.{lastScreen && c.lastRole && <> For context only: the most recent released role for {c.actor} was {c.lastRole} in {lastScreen.title} ({lastScreen.year}).</>}</p></div>
            )}
            <div data-reveal><p class="t-micro t-ash">Release</p><p class="dd-big t-title">{fmtDate(OFFICIAL.film.releaseDate)}</p><p class="t-type dd-count" data-mini-count>00d 00h 00m 00s</p></div>
          </div>
          <ol class="dd-line">
            {mentions.map((m) => <li data-reveal><span class="t-micro t-accent">{fmtDate(m.date)}</span><span><b>{m.title}.</b> <Fragment set:html={m.text + sup([m.num], 'src-doom')} /></span></li>)}
          </ol>
          <details class="sources" id="src-doom"><summary>Marvel sources ({cDoom.list.length})</summary>
            <ol>{cDoom.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
          </details>
        </section>
      </div>
      <div class="level-lock" data-level-lock hidden>
        <div class="lock-bars" aria-hidden="true">{[86, 64, 92, 48, 78, 70, 90, 56].map((w) => <i data-lock-bar style={`width:${w}%`}></i>)}</div>
        <div class="lock-ask">
          <p class="t-micro t-ash">Restricted &middot; clearance level 2</p>
          <button type="button" class="lock-btn t-label" data-request="2" data-cursor="Request">Request level 2 clearance <span aria-hidden="true">&rarr;</span></button>
          <p class="t-micro t-ash">The full story on screen, the prints and Marvel's word on Doomsday.</p>
        </div>
      </div>
    </div>

    <!-- LEVEL 3. THE COMICS -->
    <div class="level" data-level="3" id="level-3" aria-labelledby="lv3-h">
      <header class="level-head wrap">
        <p class="t-label t-accent">Clearance level 3</p>
        <h2 id="lv3-h" class="t-title level-t" data-fit>The comics</h2>
        <p class="level-sub">Deep history for readers: where it began in {fa.coverDate.match(/\d{4}/)?.[0]}, {comics.length} eras of the record, abilities, the power grid{notes.length ? ' and notes from the archive' : ''}.</p>
      </header>
      <div class="level-body" data-level-body>
        <section class="chapter-sec wrap" id="ch-origin" aria-labelledby="or-h">
          <p class="t-label t-accent">Origin</p>
          <h3 id="or-h" class="t-title chap" data-rise>Where it began</h3>
          <div class="or-grid">
            <aside class="fa" data-reveal>
              <p class="t-micro t-ash">First appearance</p>
              <p class="fa-t t-title">{fa.title} {fa.issue}</p>
              <p class="t-label">Cover date {fa.coverDate}</p>
              <p class="t-micro t-ash" style="margin-top:18px">Created by</p>
              <p class="t-label">{r.origin.creators.join(', ')}</p>
            </aside>
            <div class="prose">
              {r.origin.summary.map((p, i) => <p data-reveal set:html={p + (i === r.origin.summary.length - 1 ? sup(originNums, 'src-origin') : '')} />)}
            </div>
          </div>
          <details class="sources" id="src-origin"><summary>Origin sources ({cOrigin.list.length})</summary>
            <ol>{cOrigin.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
          </details>
        </section>

        <section class="chapter-sec wrap" id="ch-comics" aria-labelledby="rec-h">
          <p class="t-label t-accent">The comics record</p>
          <h3 id="rec-h" class="t-title chap" data-rise>{comics.length} reports, {comics[0].years.slice(0, 4)} to {comics[comics.length - 1].years.slice(-4)}</h3>
          <ol class="reports">
            {comics.map((e, i) => (
              <li class="report" data-report id={`rep-${i}`}>
                <div class="rep-years t-title">{e.years}</div>
                <div class="rep-body">
                  <p class="t-micro t-accent">Report {pad(i + 1)} &middot; {e.era}</p>
                  <h4 class="rep-t">{e.title}</h4>
                  <p set:html={e.summary + sup(e.nums, 'src-comics')} />
                  <p class="t-micro t-ash rep-k">Key issues: {e.keyIssues.join(' · ')}</p>
                </div>
              </li>
            ))}
          </ol>
          <details class="sources" id="src-comics"><summary>Comics sources ({cComics.list.length})</summary>
            <ol>{cComics.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
          </details>
        </section>

        <section class="chapter-sec wrap" id="ch-abilities" aria-labelledby="ab-h">
          <p class="t-label t-accent">Abilities on file</p>
          <h3 id="ab-h" class="t-title chap" data-rise>What the record says they can do</h3>
          <div class="ab-grid">
            <ul class="abil">
              {abilities.map((a) => <li data-reveal><b class="t-title">{a.name}</b><span><Fragment set:html={a.detail + sup(a.n, 'src-sub')} /></span></li>)}
            </ul>
            <aside class="key" data-key aria-label="Key traits">
              <p class="t-label t-ash">Key traits</p>
              <ul class="traits">
                {keyRows.map((k) => <li><span class="k">{k.k}</span><span class="v">{k.v}{k.n && <Fragment set:html={sup(k.n, 'src-origin')} />}</span></li>)}
              </ul>
              {grid ? (
                <>
                  <p class="t-label t-ash key-k">Power grid, 1 to 7{nGrid && <Fragment set:html={sup([nGrid], 'src-sub')} />}</p>
                  <ul class="grid-bars">
                    {Object.entries(grid).map(([k, v]) => (
                      <li><span class="t-micro">{gridLabels[k] ?? k}</span><span class="gb" aria-label={`${v} of 7`}><i data-bar-w style={`--v:${v / 7}`}></i></span><b class="t-type">{v}</b></li>
                    ))}
                  </ul>
                  <p class="t-micro t-ash grid-note">Comics stats, as published on Marvel.com&rsquo;s Marvel Universe wiki.</p>
                </>
              ) : (
                <p class="t-label t-ash key-k">Not rated in the Handbook</p>
              )}
            </aside>
          </div>
        </section>

        {notes.length > 0 && (
          <section class="chapter-sec wrap" id="ch-notes" aria-labelledby="nt-h">
            <p class="t-label t-accent">Notes from the archive</p>
            <h3 id="nt-h" class="t-title chap" data-rise>For the record</h3>
            <ol class="notes">
              {notes.map((x, i) => <li data-reveal><span class="t-micro t-accent">Note {pad(i + 1)}</span><p set:html={x.fact + sup(x.nums, 'src-notes')} /></li>)}
            </ol>
            <details class="sources" id="src-notes"><summary>Note sources ({cNotes.list.length})</summary>
              <ol>{cNotes.list.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ol>
            </details>
          </section>
        )}
      </div>
      <div class="level-lock" data-level-lock hidden>
        <div class="lock-bars" aria-hidden="true">{[72, 90, 58, 84, 66, 92, 50, 80].map((w) => <i data-lock-bar style={`width:${w}%`}></i>)}</div>
        <div class="lock-ask">
          <p class="t-micro t-ash">Restricted &middot; clearance level 3</p>
          <button type="button" class="lock-btn t-label" data-request="3" data-cursor="Request">Request level 3 clearance <span aria-hidden="true">&rarr;</span></button>
          <p class="t-micro t-ash">The comics: the origin, every era of the record, the power grid.</p>
        </div>
      </div>
    </div>

    <nav class="voyage" data-voyage aria-label="Other files" style={`--na:${accentOf(next)}`}>
      <div class="voy-stage">
        {nextPh && <img class="voy-bg" src={pick2(nextPh.full, 1920)} srcset={srcset2(nextPh.full)} sizes="100vw" width={nextPh.w} height={nextPh.h} alt="" loading="lazy" decoding="async" style={`object-position:${nextPh.focus}`} data-voy-bg />}
        <ol class="voy-list t-micro" aria-label="All files">
          {files.map((f) => <li class={f.slug === slug ? 'here' : f.slug === next ? 'next' : ''} style={`--fa:${f.accent}`}><a href={u(`/c/${f.slug}/`)} aria-current={f.slug === slug ? 'page' : undefined}><i></i>{f.name}</a></li>)}
        </ol>
        <a class="voy-window" href={u(`/c/${next}/`)} data-voy-window>
          {nextPh && <span class="voy-img"><img src={pick2(nextPh.cut.length ? nextPh.cut : nextPh.full, 1280)} alt="" loading="lazy" decoding="async" style={`object-position:${nextPh.focusM}`} class={nextPh.cut.length ? 'cut' : ''} /></span>}
          <span class="voy-cap t-micro">Next file &middot; {pad((no % order.length) + 1)}</span>
        </a>
        <div class="voy-name">
          <p class="t-label t-ash">Open the next file</p>
          <a class="voy-big t-title" href={u(`/c/${next}/`)} data-fit>{heroName(next).toUpperCase()}</a>
          <a class="t-label voy-back" href={u('/')}>&larr; Back to the archive</a>
        </div>
      </div>
      <p class="t-micro t-ash credit wrap">{PHOTO_CREDIT}</p>
    </nav>
  </article>
</Dossier>

<style>


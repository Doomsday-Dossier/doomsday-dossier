---
// DOOM-OS module 04, the subject profiler: the v1 quiz (ten questions, number keys, Back, answers in ?a=, the result
// with its telling answers and runners-up, share cards) as Doom's system profiling whoever sits before the screen.
// Questions type in as terminal prompts and the answers are lines to select (scripts/os/pages/profiler.ts, which runs
// motion/quiz.ts unchanged). Before the match an optional camera scan draws the subject as green wireframe
// (scripts/os/camera.ts: opt-in, video only, four seconds, nothing kept). The match is revealed as a scan of the
// target's photo. A fan quiz, just for fun: the answers are opinions, not facts.
import OS from '../layouts/OS.astro';
import '../styles/faces';
import quiz from '../../research/quiz.json';
import { DESIGN, castFor, publishedOrder, TEAMS, heroName, u } from '../data/site';
import { PHOTO_CREDIT } from '../data/photos';
import { accentOf, photos2For, pick2 } from '../data/v2';
import { scanPhoto } from '../data/os';

// every published character is a possible result; roster order breaks the last ties. `photo` feeds the v1 result
// and the share cards; `scan` is the photo and depth map the match is scanned from.
const roster = publishedOrder().map((slug) => {
  const d = DESIGN[slug], ph = photos2For(slug)[0], team = TEAMS.find((t) => t.id === castFor(slug)!.team)!, sp = scanPhoto(slug);
  const name = heroName(slug).toUpperCase();
  return {
    slug, name, team: team.name, accent: accentOf(slug), font: d.font, weight: d.fontWeight, kicker: d.kicker, href: u(`/c/${slug}/`),
    photo: ph ? { src: pick2(ph.cut.length ? ph.cut : ph.full, 1280), card: pick2(ph.full, 1280), focus: ph.cut.length ? '50% 100%' : ph.focusM, cut: ph.cut.length > 0 } : null,
    scan: sp ? { photo: sp.photo, depth: sp.depth, head: sp.head } : null,
  };
});
const site = (Astro.site?.host ?? 'doomsdaydossier.github.io') + u('/quiz/');
const data = JSON.stringify({ questions: quiz.questions, roster, credit: PHOTO_CREDIT, site });
const n = quiz.questions.length, pad = (x: number) => String(x).padStart(2, '0');
const maxOpts = Math.max(...quiz.questions.map((q) => q.options.length));
const RET = `<svg viewBox="0 0 120 120" aria-hidden="true"><g class="spin" fill="none" stroke="#3dff8f" stroke-width="1.2"><circle cx="60" cy="60" r="44" stroke-dasharray="10 8" /></g><g fill="none" stroke="#3dff8f" stroke-width="1.5"><path d="M60 4v18M60 98v18M4 60h18M98 60h18" /><circle cx="60" cy="60" r="3" fill="#3dff8f" /></g></svg>`;
---
<OS title="Subject profiler" page="quiz" description="Which Avengers: Doomsday character are you? Ten quick questions match you with one of the 29 confirmed characters, then save your result as a card. A fan quiz, just for fun, not facts.">
  <section class="qz" data-quiz>
    <div class="mod-head">
      <div>
        <p class="os-label">Module 04 // Subject profiler</p>
        <h1 class="os-display os-hi mod-title">Who are you?</h1>
        <p class="mod-sub">Ten questions, Your Majesty. The system profiles whoever sits before the screen and matches them with one of the {roster.length} targets of Avengers: Doomsday. There are no right answers. The match opens that target's file, where every fact is sourced, and saves as a card to share.</p>
      </div>
      <p class="qz-fan"><span class="os-chip amber">Fan quiz, just for fun, not facts</span></p>
    </div>

    <div class="qz-stage os-panel" data-stage>
      <header><b>Profiling the subject</b><span class="os-label">Responses stay on this screen</span></header>
      <div class="qz-top">
        <p class="qz-count os-label">Query <b data-count>01</b> / {pad(n)}</p>
        <div class="os-bar qz-bar" aria-hidden="true"><i data-bar></i></div>
        <button type="button" class="os-btn qz-back" data-back disabled>&larr; Back</button>
      </div>
      <div class="qz-deck">
        {quiz.questions.map((q, i) => (
          <fieldset class="qz-q" data-q={q.id} data-i={i}>
            <legend class="qz-text" data-n={pad(i + 1)}>{q.text}</legend>
            <div class="qz-opts">
              {q.options.map((o, k) => (
                <button type="button" data-opt={o.id}><span class="qz-key" aria-hidden="true">[{k + 1}]</span><span class="qz-lbl">{o.label}</span></button>
              ))}
            </div>
          </fieldset>
        ))}
      </div>
      <p class="qz-hint os-label">Keys 1 to {maxOpts} answer &middot; Backspace goes back</p>
    </div>

    <!-- the optional subject scan, between the last answer and the match (scripts/os/camera.ts) -->
    <section class="qz-gate os-panel" data-gate hidden>
      <header><b>Final phase // subject scan</b><span class="os-label">Optional</span></header>
      <p class="qz-gl os-hi" data-gl></p>
      <p class="qz-gl" data-gl></p>
      <div class="qz-choice" data-choice>
        <p class="qz-gate-copy">Before the match, the system can scan the subject through your camera: a few seconds of green wireframe, just for show. It runs only in this browser. Nothing is recorded, uploaded or kept, the camera switches off after four seconds, and the scan does not change the result.</p>
        <div class="qz-gate-btns">
          <button type="button" class="os-btn qz-yes" data-cam-yes>Allow camera scan — stays on this device</button>
          <button type="button" class="os-btn qz-ghost" data-cam-no>Skip the scan, show the match</button>
        </div>
      </div>
      <div class="qz-cam" data-cam hidden>
        <canvas data-cam-canvas aria-hidden="true"></canvas>
        <div class="os-reticle" data-cam-ret hidden><Fragment set:html={RET} /><span class="lock os-label os-hi">Subject acquired</span></div>
        <ol class="qz-read" data-cam-read></ol>
        <span class="qz-pts os-label">Contour points <b data-cam-pts>0000</b></span>
        <button type="button" class="os-btn qz-skip" data-cam-skip>Stop and skip</button>
      </div>
    </section>

    <article class="qz-result" data-result hidden>
      <div class="qz-r-photo os-panel">
        <header><b>Match // scan</b><span class="os-label" data-r-status>Matching profile</span></header>
        <div class="qz-r-frame">
          <img data-r-img alt="" width="800" height="1000" />
          <canvas data-r-scan aria-hidden="true"></canvas>
          <div class="os-reticle" data-r-ret hidden><Fragment set:html={RET} /><span class="lock os-label os-hi">Match locked</span></div>
          <span class="qz-stamp" data-r-stamp hidden>Match</span>
        </div>
      </div>
      <div class="qz-r-text">
        <p class="sr" aria-live="polite" data-r-sr></p>
        <p class="os-label os-hi qz-r-kicker" data-r-kicker>Subject profile matches:</p>
        <h2 class="os-display os-hi qz-r-name" data-r-name></h2>
        <p class="qz-r-team os-label" data-r-team></p>
        <p class="qz-r-blurb" data-r-blurb></p>
        <div class="qz-why os-panel">
          <header><b>Telling answers</b><span class="os-label">Why the system chose this target</span></header>
          <ul data-r-why></ul>
        </div>
        <p class="qz-close" data-r-close></p>
        <div class="qz-actions">
          <a class="os-btn qz-primary" data-r-link href="#">Read the dossier</a>
          <button type="button" class="os-btn" data-card="portrait">Save card</button>
          <button type="button" class="os-btn" data-card="wide">Save wide card</button>
          <button type="button" class="os-btn" data-r-copy>Copy link</button>
          <button type="button" class="os-btn" data-r-again>Take it again</button>
        </div>
        <p class="qz-fine">Fan quiz, just for fun, not facts: the answers are opinions. {PHOTO_CREDIT}</p>
      </div>
    </article>
  </section>
  <script type="application/json" id="qz-data" set:html={data} />
</OS>

<style is:global>
  /* the share cards read these (motion/card.ts); DOOM-OS names its mono face differently */
  :root { --font-mono: 'JetBrains Mono', ui-monospace, monospace; }
  .qz [hidden] { display: none !important; }
  .qz-fan { margin: 0; }
  .qz-stage, .qz-gate, .qz-result { scroll-margin-top: 60px; }

  /* the stage: progress, then one prompt at a time (motion/quiz.ts shows the card marked .on) */
  .qz-top { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 14px; }
  .qz-count { margin: 0; white-space: nowrap; }
  .qz-count b { color: var(--os-green); font-weight: 700; }
  .qz-bar > i { width: 100%; transform: scaleX(0); }
  .qz-back { padding: 7px 11px; font-size: 10px; }
  .qz-back:disabled { opacity: 0.3; cursor: default; pointer-events: none; }
  .qz-deck { margin-top: 26px; }
  .qz.live .qz-q:not(.on) { display: none; }
  .qz-q { border: 0; margin: 0; padding: 0; min-width: 0; }
  .qz-text { font-family: var(--os-display); font-weight: 700; text-transform: uppercase; color: var(--os-green); text-shadow: var(--os-glow); font-size: clamp(24px, 3.8vw, 46px); line-height: 1.06; padding: 0; margin: 0 0 20px; max-width: 24ch; overflow-wrap: break-word; }
  .qz-text::before { content: 'DOOM-OS:\\> query ' attr(data-n); display: block; font: 400 10.5px var(--os-mono); letter-spacing: 0.22em; text-transform: uppercase; color: var(--os-dim); text-shadow: none; margin-bottom: 10px; }
  /* the prompt types in (profiler.ts); motion/quiz.ts's word rise and line slide are held still */
  .qz-text .w { transform: none !important; opacity: 1 !important; }
  .qz-opts button { transform: none !important; }
  .qz-q.typing .qz-opts { opacity: 0; pointer-events: none; }
  .qz-text .w i { font-style: normal; color: transparent; text-shadow: none; }
  .qz-text .cur { position: relative; }
  .qz-text .cur::after { content: '\2588'; position: absolute; left: 1px; bottom: 0.08em; font-size: 0.8em; line-height: 1; color: var(--os-green); }
  .qz-opts { display: grid; gap: 4px; max-width: 920px; }
  .qz-opts button { font: inherit; font-size: 14px; line-height: 1.4; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 12px; align-items: baseline; text-align: left; color: var(--os-text); background: transparent; border: 1px solid transparent; border-left: 2px solid var(--os-line); padding: 11px 12px; min-height: 48px; cursor: pointer; transition: background 0.15s, border-color 0.15s, color 0.15s; }
  .qz-key { color: var(--os-green); font-weight: 700; white-space: nowrap; }
  .qz-lbl { overflow-wrap: break-word; min-width: 0; }
  .qz-lbl::after { content: ' _'; color: var(--os-green); opacity: 0; }
  .qz-opts button:hover, .qz-opts button:focus-visible { background: rgba(61, 255, 143, 0.08); border-color: var(--os-line); border-left-color: var(--os-green); color: #eafff2; outline: none; }
  .qz-opts button:hover .qz-lbl::after, .qz-opts button:focus-visible .qz-lbl::after { opacity: 1; }
  .qz-opts button.picked { background: var(--os-green); border-color: var(--os-green); color: #021008; }
  .qz-opts button.picked .qz-key { color: #021008; }
  .qz-hint { margin: 16px 0 0; }
  @media (hover: none) { .qz-hint { display: none; } }

  /* the subject scan */
  .qz-gate { margin-top: var(--os-gap); }
  .qz-gl { margin: 0 0 4px; min-height: 1.55em; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; }
  .qz-gate-copy { margin: 12px 0 14px; max-width: 70ch; }
  .qz-gate-btns { display: flex; flex-wrap: wrap; gap: 8px; }
  .qz-gate .os-btn, .qz-actions .os-btn { max-width: 100%; box-sizing: border-box; white-space: normal; text-align: left; line-height: 1.35; }
  .qz-yes { background: var(--os-green); color: #021008; }
  .qz-yes:hover, .qz-yes:focus-visible { background: #8dffc0; }
  .qz-ghost { border-color: var(--os-line); color: var(--os-text); background: transparent; }
  .qz-cam { position: relative; width: min(100%, 760px); aspect-ratio: 4 / 3; margin: 12px auto 0; overflow: hidden; border: 1px solid var(--os-line); background: radial-gradient(circle at 50% 45%, rgba(61, 255, 143, 0.07), transparent 70%), #020504; }
  .qz-cam::after { content: ''; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(rgba(61, 255, 143, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(61, 255, 143, 0.05) 1px, transparent 1px); background-size: 32px 32px; }
  .qz-cam canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .cam-vid { position: absolute; left: 0; top: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .qz-read { position: absolute; z-index: 2; left: 10px; top: 10px; right: 10px; list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--os-green); text-shadow: 0 0 6px rgba(61, 255, 143, 0.6), 0 1px 2px #000; }
  .qz-read li.warn { color: var(--os-amber); text-shadow: 0 1px 2px #000; }
  .qz-pts { position: absolute; z-index: 2; left: 10px; bottom: 10px; }
  .qz-pts b { color: var(--os-green); font-weight: 400; font-variant-numeric: tabular-nums; }
  .qz-skip { position: absolute; z-index: 3; right: 8px; bottom: 8px; padding: 6px 9px; font-size: 9.5px; background: rgba(2, 5, 4, 0.8); }
  .qz .os-reticle { z-index: 2; }
  .qz .os-reticle .lock { position: absolute; left: 100%; top: 50%; white-space: nowrap; margin-left: 4px; opacity: 0; transition: opacity 0.3s; }
  .qz .os-reticle.locked .lock { opacity: 1; }

  /* the match: the scan beside the readout; every grid level minmax(0, 1fr) so a wide name is always fitted */
  .qz-result { margin-top: var(--os-gap); display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--os-gap); align-items: start; }
  .qz-result.held { display: none; }
  @media (min-width: 900px) { .qz-result { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); } .qz-r-photo { position: sticky; top: 64px; } }
  .qz-r-photo > header span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .qz-r-frame { position: relative; overflow: hidden; height: min(72svh, 720px); background: radial-gradient(circle at 50% 35%, rgba(61, 255, 143, 0.08), transparent 70%); }
  .qz-r-frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; display: block; opacity: 0; transition: opacity 0.4s; }
  .qz-r-frame.flat img { opacity: 1; filter: grayscale(1) sepia(1) hue-rotate(80deg) saturate(2) brightness(1.3); }
  .qz-r-frame canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .qz-stamp { position: absolute; z-index: 3; right: 14px; top: 14px; font: 700 15px var(--os-mono); letter-spacing: 0.24em; text-transform: uppercase; color: var(--os-green); border: 2px solid currentColor; padding: 6px 12px; transform: rotate(-8deg); background: rgba(2, 5, 4, 0.75); text-shadow: var(--os-glow); }
  .qz-r-text { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; min-width: 0; container-type: inline-size; }
  .qz-r-text > p, .qz-r-text > h2 { margin: 0; }
  .qz-r-kicker { min-height: 1.55em; }
  .qz-r-name { font-size: min(110px, calc(100cqi / (var(--lw, 8) * 0.68))); line-height: 0.92; overflow-wrap: normal; }
  .qz-r-name .ln { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .qz-r-name .ln > span { display: inline-block; }
  .qz-r-name .ln > span i { font-style: normal; color: transparent; text-shadow: none; }
  .qz-r-team { display: flex; align-items: center; gap: 8px; color: var(--os-text); }
  .qz-r-team::before { content: ''; width: 9px; height: 9px; flex: none; background: var(--a, var(--os-green)); box-shadow: 0 0 8px var(--a, var(--os-green)); }
  .qz-r-blurb { max-width: 60ch; }
  .qz-why ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .qz-why li { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2px; padding: 7px 0; border-bottom: 1px dashed rgba(61, 255, 143, 0.12); }
  .qz-why li:last-child { border-bottom: 0; }
  .qz-why li small { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--os-dim); }
  .qz-why li span { color: var(--os-green); }
  .qz-why li span::before { content: '> '; color: var(--os-dim); }
  .qz-close { color: var(--os-dim); }
  .qz-close a { color: var(--os-green); }
  .qz-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .qz-primary { background: var(--os-green); color: #021008 !important; }
  .qz-primary:hover, .qz-primary:focus-visible { background: #8dffc0; }
  .qz-actions button:disabled { opacity: 0.5; cursor: progress; }
  .qz-fine { font-size: 11px; color: var(--os-dim); }

  @media (max-width: 899px) { .qz-r-frame { height: 58svh; } }
  @media (max-width: 560px) {
    .qz-stage > header .os-label, .qz-gate > header .os-label { display: none; }
    .qz-top { gap: 10px; }
    .qz-opts button { font-size: 13.5px; padding: 10px 8px; gap: 9px; }
    .qz-gate .os-btn { width: 100%; letter-spacing: 0.12em; }
    .qz-read { font-size: 10px; letter-spacing: 0.1em; }
  }
  html.rm .qz-r-frame img { transition: none; }
</style>

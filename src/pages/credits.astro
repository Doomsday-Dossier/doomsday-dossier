---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { DESIGN, publishedOrder, heroName, u } from '../data/site';
import { photosFor, PHOTO_CREDIT } from '../data/photos';

const rows = publishedOrder().map((slug) => ({ slug, d: DESIGN[slug], photos: photosFor(slug) })).filter((r) => r.photos.length);
const total = rows.reduce((n, r) => n + r.photos.length, 0);
---
<Base title="Image credits" description="Every image used on Doomsday Dossier, by character. Images belong to their respective owners and any image will be removed on request." page="credits">
  <section class="cr">
    <div class="wrap cr-inner">
      <p class="label" data-hero-in>Image credits</p>
      <h1 class="display cr-title" data-split="words" data-split-on="load">Every frame, listed.</h1>
      <div class="cr-note" data-hero-in>
        <p>{PHOTO_CREDIT} Doomsday Dossier is an unofficial, non-commercial fan project and claims no rights in any image shown here.</p>
        <p>Any image will be removed on request: <a href="https://github.com/prejith77/doomsday-dossier/issues" target="_blank" rel="noopener">open an issue</a> naming the image number below, and it comes down.</p>
        <p class="cr-count">{total} images &middot; {rows.length} characters</p>
      </div>
      <ol class="cr-list">
        {rows.map((r, ri) => (
          <li class="cr-row" style={`--a:${r.d.accent}`} data-reveal>
            <a class="cr-name" href={u(`/c/${r.slug}/`)}>{heroName(r.slug)}</a>
            <ul class="cr-prints">
              {r.photos.map((p, i) => (
                <li class="cr-print">
                  <div class="cr-frame"><Photo photo={p} alt={`${heroName(r.slug)}, image ${i + 1}`} sizes="(min-width: 900px) 150px, 28vw" /></div>
                  <span class="cr-id">#{String(ri + 1).padStart(2, '0')}.{i + 1}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
<style>
  .cr { padding: calc(var(--header-h) + 80px) 0 100px; }
  .cr-inner { display: grid; gap: 36px; }
  .cr-title { font-size: min(clamp(54px, 10vw, 160px), calc((100vw - 2 * var(--gutter)) / 6.4)); }
  .cr-note { max-width: 70ch; color: var(--bone-dim); }
  .cr-note p { margin: 0 0 10px; }
  .cr-count { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--doom); }
  .cr-list { list-style: none; margin: 0; padding: 0; }
  .cr-row { display: grid; gap: 14px 30px; padding: 26px 0; border-top: 1px solid var(--iron); align-items: center; }
  @media (min-width: 900px) { .cr-row { grid-template-columns: minmax(0, 1fr) auto; } }
  .cr-name { font-family: var(--font-serif); font-size: clamp(28px, 3.4vw, 52px); line-height: 1; text-transform: uppercase; text-decoration: none; color: var(--bone); transition: color 0.4s; overflow-wrap: break-word; min-width: 0; }
  .cr-name:hover { color: var(--a); }
  .cr-prints { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 150px)); gap: 12px; }
  .cr-frame { aspect-ratio: 3 / 4; overflow: hidden; border-radius: 3px; box-shadow: 0 0 0 1px var(--iron); }
  .cr-frame :global(.photo) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cr-id { display: block; margin-top: 6px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; color: var(--bone-dim); }
</style>

---
// DOOM-OS home (CLAUDE.md, "Design system v4"): the visitor is Doom. The gate and the boot on the first visit of a
// session, then Battleworld (Secret Wars, 2015): the patchwork planet of 29 domains turning under the throne, one
// shard per target. Beside it the system's panel, the royal log of this visitor's reign, the launch clock and the
// modules.
import OS from '../layouts/OS.astro';
import { OFFICIAL, u } from '../data/site';
import { MODULES, PICK, targets } from '../data/os';
import { photos2For, pick2 } from '../data/v2';

const all = targets();
// the greatest threat to Doom: rank 1 (he is the measure, never his own threat)
const top = all.find((t) => t.threatOf.rank === 1)!;
const feed = OFFICIAL.milestones.slice(-8).map((m: any) => ({ date: m.date, text: m.text }));
const teams = new Set(all.map((t) => t.team)).size;
// each domain's face: the picked photo, full frame, cropped around the head in the browser
const world = all.map((t) => {
  const ph = photos2For(t.slug), pk = ph.find((x) => x.n === PICK[t.slug]) ?? ph[0];
  return { slug: t.slug, no: t.no, name: t.name, team: t.team, teamId: t.teamId, href: t.href, tile: t.tile, face: { src: pick2(pk.full, 640), head: pk.head ?? [0.5, 0.2], aspect: pk.w / pk.h } };
});
---
<OS title="DOOM-OS" page="home" description="An unofficial fan briefing for Avengers: Doomsday (18 December 2026), built as Doctor Doom's own surveillance system: all 29 confirmed characters as the domains of Battleworld, every appearance, and fan tools.">
  <!-- THE GATE: sound needs a click, and Doom's machine wants his hand on the scanner -->
  <section class="gate" data-gate hidden>
    <div class="gate-in">
      <p class="os-label">Latverian sovereign network &middot; identity required</p>
      <button class="os-btn big" data-auth>&#9673;&nbsp; I am Doom</button>
      <button class="gate-skip os-label" data-auth-quiet>Enter without sound</button>
      <p class="os-label gate-fine">Unofficial fan archive &middot; not affiliated with Marvel or Disney</p>
    </div>
  </section>
  <pre class="boot" data-boot aria-hidden="true"></pre>

  <div class="home" data-home>
    <h1 class="sr">Doomsday Dossier: DOOM-OS. Battleworld, 29 domains.</h1>
    <div class="bw-stage" data-bw-stage>
      <div class="acq" data-acq aria-hidden="true"><i></i><span>Gathering the fragments</span></div>
      <canvas class="bw" data-bw aria-label="Battleworld: a planet of 29 domains, one for each target. Drag to turn it; choose a domain to open its file."></canvas>
      <div class="bw-tag" data-bw-tag hidden><i data-bw-no></i><b data-bw-name></b><span data-bw-team></span><button type="button" class="bw-go" data-bw-go>Enter the domain</button></div>
      <div class="bw-strip" data-bw-strip role="group" aria-label="Choose a domain">
        {world.map((w) => <button type="button" aria-pressed="false"><img src={w.tile} alt="" loading="lazy" /><span>{w.name}</span></button>)}
      </div>
      <p class="bw-title os-label" aria-hidden="true"><b class="os-hi">Battleworld</b> &middot; {all.length} domains under His Majesty &middot; drag to turn &middot; tap a domain</p>
    </div>

    <aside class="sys" data-os-panel>
      <div class="os-panel os-inst">
        <header><b>System</b><span class="os-label os-hi">At your command</span></header>
        <p class="greet os-hi" data-greet>Welcome, Your Majesty.</p>
        <div class="os-row"><span>Orbital array</span><span class="os-hi">Linked</span></div>
        <div class="os-row"><span>Domains held</span><span>{all.length} in {teams} continents</span></div>
        <div class="os-row"><span>Greatest threat</span><a class="os-red" href={top.href}>{top.name} &middot; {top.threatOf.band.name}</a></div>
        <div class="os-row"><span>Doom's will</span><span><span class="willbar"><i data-will></i></span> <b data-will-n>0%</b></span></div>
        <p class="os-label feed-h">Intercepted // Marvel, confirmed</p>
        <ol class="feed" data-feed>{feed.map((f) => <li><i>{f.date}</i>{f.text}</li>)}</ol>
      </div>
      <div class="os-panel logp">
        <header><b>Royal log</b><a class="os-label" href={u('/chamber/')}>Chamber &rarr;</a></header>
        <ol class="rlog" data-rlog><li class="os-label">The log is empty. Your reign begins now.</li></ol>
      </div>
    </aside>

    <div class="h-clock">
      <p class="os-label">Doomsday launch // 18 &middot; 12 &middot; 2026</p>
      <p class="os-display clock os-hi" data-clock>--</p>
      <p class="os-label">Avengers: Doomsday &middot; in cinemas</p>
    </div>

    <nav class="modules" aria-label="Modules">
      {MODULES.map((m) => (
        <a class="mod" href={u(m.href)}><i>{m.no}</i><b>{m.name}</b><span>{m.line}</span></a>
      ))}
      <p class="mod-cmd os-label">Or press <kbd>/</kbd> and name your target</p>
    </nav>
  </div>
  <script type="application/json" data-home-data is:inline set:html={JSON.stringify({ world, count: all.length })} />
</OS>

<style is:global>
  .gate { position: fixed; inset: 0; z-index: 45; display: grid; place-items: center; background: var(--os-bg); }
  .gate[hidden] { display: none; }
  .gate-in { display: grid; gap: 18px; justify-items: center; text-align: center; padding: 0 16px; }
  .os-btn.big { font-size: 13px; padding: 16px 28px; }
  .gate-skip { background: none; border: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .gate-skip:hover { color: var(--os-text); }
  .gate-fine { margin-top: 14px; }
  .boot { position: fixed; z-index: 44; left: var(--os-margin); top: 70px; margin: 0; color: var(--os-green); text-shadow: var(--os-glow); font: 12px/1.7 var(--os-mono); pointer-events: none; white-space: pre-wrap; max-width: calc(100vw - 2 * var(--os-margin)); }
  .boot:empty { display: none; }
  html.os-booting .home > :not(.bw-stage) { visibility: hidden; }

  .home { position: relative; min-height: calc(100svh - 112px); display: grid; grid-template-columns: clamp(250px, 17vw, 400px) minmax(0, 1fr) clamp(250px, 17vw, 400px); grid-template-rows: 1fr auto; gap: var(--os-gap); align-items: center; }
  .bw-stage { position: absolute; z-index: 0; top: -16px; bottom: 0; left: calc(-1 * var(--os-margin) - 30px); right: calc(-1 * var(--os-margin) - 30px); }
  .bw { width: 100%; height: 100%; display: block; }
  .bw-title { position: absolute; left: 50%; top: 10px; transform: translateX(-50%); white-space: nowrap; pointer-events: none; }
  .bw-title b { font-weight: 700; letter-spacing: 0.3em; }
  .bw-tag { position: absolute; left: 0; top: 0; z-index: 3; display: grid; gap: 1px; padding: 8px 12px 8px 14px; border: 1px solid var(--os-line); background-color: rgba(2, 10, 6, 0.86); --tick: var(--os-green); background-image: linear-gradient(var(--tick), var(--tick)), linear-gradient(var(--tick), var(--tick)); background-size: 12px 2px, 2px 12px; background-position: 0 0, 0 0; background-repeat: no-repeat; pointer-events: none; white-space: nowrap; transform: translate(26px, -50%); }
  .bw-tag[hidden] { display: none; }
  .bw-tag::before { content: ''; position: absolute; right: 100%; top: 50%; width: 26px; height: 1px; background: var(--os-green); }
  .bw-tag i { font-style: normal; font-size: 11px; letter-spacing: 0.2em; color: var(--os-green); }
  .bw-tag b { font-family: var(--os-display); font-size: 22px; line-height: 1; text-transform: uppercase; }
  .bw-tag span { font-size: 11px; color: var(--os-dim); }
  .bw-tag em { font-style: normal; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--os-green); margin-top: 3px; }
  .bw-tag.left { transform: translate(calc(-100% - 26px), -50%); border-left: 0; border-right: 2px solid var(--os-green); text-align: right; }
  .bw-tag.left::before { right: auto; left: 100%; }
  .bw-go { font: inherit; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--os-green); background: none; border: 0; padding: 0; margin-top: 3px; text-align: inherit; }
  /* touch and narrow screens: the card docks above the strip of faces, with a real Enter button */
  .bw-tag.dock { left: 50%; top: auto; bottom: 104px; transform: translateX(-50%); pointer-events: auto; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto auto; column-gap: 16px; align-items: center; width: min(92%, 440px); box-sizing: border-box; padding: 12px 12px 12px 16px; border: 1px solid var(--os-line-hi); border-left: 1px solid var(--os-line); background: rgba(2, 12, 7, 0.94); white-space: normal; }
  .bw-tag.dock::before { display: none; }
  .bw-tag.dock b { font-size: clamp(18px, 5.6vw, 26px); overflow-wrap: anywhere; }
  .bw-tag.dock > :not(.bw-go) { grid-column: 1; min-width: 0; }
  .bw-tag.dock .bw-go { grid-column: 2; grid-row: 1 / span 3; margin: 0; min-height: 48px; padding: 0 16px; border: 1px solid var(--os-green); background: var(--os-green); color: #021008; font-weight: 700; letter-spacing: 0.16em; cursor: pointer; }
  .bw-strip { display: none; }
  @media (max-width: 1099px), (pointer: coarse) {
    .bw-strip { position: absolute; left: 0; right: 0; bottom: 6px; z-index: 3; display: flex; gap: 8px; overflow-x: auto; padding: 6px var(--os-margin) 10px; scroll-snap-type: x proximity; scrollbar-width: none; -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
    .bw-strip::-webkit-scrollbar { display: none; }
    .bw-strip button { flex: 0 0 auto; width: 80px; display: grid; gap: 4px; justify-items: center; padding: 0; background: none; border: 0; color: var(--os-dim); font: 10.5px var(--os-mono); letter-spacing: 0.02em; text-transform: uppercase; scroll-snap-align: center; cursor: pointer; }
    .bw-strip img { width: 56px; height: 56px; object-fit: cover; object-position: 50% 12%; border: 1px solid var(--os-line); border-radius: 50%; background: rgba(61, 255, 143, 0.06); filter: grayscale(1) sepia(1) hue-rotate(80deg) saturate(2.2) brightness(0.9); transition: filter 0.25s, border-color 0.25s, transform 0.25s; }
    .bw-strip span { max-width: 80px; text-align: center; line-height: 1.2; overflow-wrap: normal; min-height: 2.4em; }
    .bw-strip button[aria-pressed='true'] { color: var(--os-green); }
    .bw-strip button[aria-pressed='true'] img { filter: none; border: 2px solid var(--os-green); transform: scale(1.08); box-shadow: 0 0 14px rgba(61, 255, 143, 0.5); }
  }
  .sys, .modules, .h-clock { position: relative; z-index: 2; }
  .h-clock { pointer-events: none; }
  .sys { grid-column: 1; grid-row: 1; align-self: center; display: grid; gap: 12px; font-size: 11.5px; }
  .sys .os-row { grid-template-columns: 104px minmax(0, 1fr); }
  .sys .os-row a { text-decoration: none; }
  .greet { margin: 0 0 8px; font-family: var(--os-display); font-size: 17px; text-transform: uppercase; letter-spacing: 0.04em; }
  .willbar { display: inline-block; vertical-align: middle; width: 70px; height: 6px; border: 1px solid var(--os-line); position: relative; }
  .willbar i { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--os-green); box-shadow: 0 0 8px var(--os-green); }
  .feed-h { margin: 12px 0 6px; }
  .feed { list-style: none; margin: 0; padding: 0; height: 112px; overflow: hidden; }
  .feed li { padding: 5px 0; border-bottom: 1px dashed rgba(61, 255, 143, 0.12); font-size: 11px; line-height: 1.45; }
  .feed li i { display: block; font-style: normal; color: var(--os-green); font-size: 11px; letter-spacing: 0.14em; }
  .logp header a { text-decoration: none; }
  .rlog { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-size: 11px; line-height: 1.45; max-height: 120px; overflow: hidden; }
  .rlog li i { display: block; font-style: normal; color: var(--os-green-2); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; }
  .h-clock { grid-column: 1 / -1; grid-row: 2; text-align: center; display: grid; gap: 6px; }
  .h-clock p { margin: 0; }
  .clock { font-size: clamp(30px, 5vw, 72px); letter-spacing: 0.04em; font-variant-numeric: tabular-nums; }
  .modules { grid-column: 3; grid-row: 1; display: grid; gap: 7px; align-self: center; }
  .mod { position: relative; display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 2px 10px; padding: 9px 12px; border: 1px solid var(--os-line); background: rgba(4, 14, 9, 0.82); color: var(--os-text) !important; text-decoration: none; overflow: hidden; transition: border-color 0.2s, background 0.2s; }
  .mod::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(61, 255, 143, 0.16), transparent); transform: translateX(-100%); }
  .mod:hover, .mod:focus-visible { border-color: var(--os-line-hi); background: rgba(61, 255, 143, 0.1); }
  @media (hover: hover) { .mod:hover::before { transition: transform 0.6s cubic-bezier(.2,.8,.2,1); transform: translateX(100%); } }
  .mod i { grid-row: span 2; font-style: normal; color: var(--os-green); font-weight: 700; }
  .mod b { font-size: 11.5px; letter-spacing: 0.16em; text-transform: uppercase; }
  .mod span { font-size: 10.5px; color: var(--os-dim); }
  .mod-cmd { margin: 4px 0 0; text-transform: none; letter-spacing: 0.08em; }
  html.os kbd { font: inherit; color: var(--os-green); border: 1px solid var(--os-line-hi); padding: 0 5px; }
  html.no-gl .bw-stage { display: none; }
  @media (max-width: 1100px) {
    .home { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto auto auto; min-height: 0; }
    .bw-stage { position: relative; grid-row: 1; top: 0; left: auto; right: auto; margin: 0 calc(-1 * var(--os-margin)); height: 74svh; min-height: 520px; }
    .bw-title { top: 6px; font-size: 11px; }
    .h-clock { grid-row: 2; }
    .modules { grid-column: 1; grid-row: 3; grid-template-columns: 1fr 1fr; }
    .mod-cmd { grid-column: 1 / -1; }
    .sys { grid-column: 1; grid-row: 4; grid-template-columns: 1fr 1fr; align-items: start; }
  }
  @media (max-width: 640px) { .modules, .sys { grid-template-columns: 1fr; } .bw-tag b { font-size: 18px; } .bw-title { white-space: normal; width: 92%; text-align: center; line-height: 1.6; } }
</style>

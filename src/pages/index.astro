---
import Base from '../layouts/Base.astro';
import { OFFICIAL, SRC, TEAMS, CAST, DESIGN, isPublished, displayName, u, fmtDate } from '../data/site';
import { photosFor } from '../data/photos';
import Photo from '../components/Photo.astro';
import '../styles/faces';

// Order of names exactly as Marvel listed the 27 livestream reveals (S_LIVE).
const ROLL = ['Chris Hemsworth','Vanessa Kirby','Anthony Mackie','Sebastian Stan','Letitia Wright','Paul Rudd','Wyatt Russell','Tenoch Huerta Mejía','Ebon Moss-Bachrach','Simu Liu','Florence Pugh','Kelsey Grammer','Lewis Pullman','Danny Ramirez','Joseph Quinn','David Harbour','Winston Duke','Hannah John-Kamen','Tom Hiddleston','Patrick Stewart','Ian McKellen','Alan Cumming','Rebecca Romijn','James Marsden','Channing Tatum','Pedro Pascal','Robert Downey Jr.'];

const sourceOrder = ['S_SDCC24', 'S_LIVE', 'S_PROD', 'S_TEASERS', 'S_TRAILER', 'S_SDCC26', 'S_D23', 'S_FILM', 'S_SECRETWARS'];
const n = (k: string) => sourceOrder.indexOf(k) + 1;
const m = OFFICIAL.milestones;
const reveal = m[0], roll = m[1];
const signals = m.slice(2, m.length - 1);

// Team picker: every name on the cast list in one grid, in team order, unnamed roles last
const roster = [...TEAMS.flatMap((t) => CAST.filter((c) => c.team === t.id)), ...CAST.filter((c) => c.team === 'unnamed')];
const waveOf = (team: string) => TEAMS.find((t) => t.id === team)?.wave;
---
<Base title="The road to Doomsday" description="An unofficial, animated fan briefing for Avengers: Doomsday. Every confirmed character's origin, comics history and screen history, with every fact sourced." page="home" scene="void" ease="power4.out" pace={1.2}>
  <!-- 01 VOID -->
  <section class="hero h-void" data-gl-region>
    <div class="wrap hv-inner">
      <p class="label" data-hero-in>An unofficial fan briefing</p>
      <h1 class="sr-only">Doomsday Dossier</h1>
      <div class="hv-count" data-countdown aria-label="Countdown to the release of Avengers: Doomsday on 18 December 2026">
        <div><span data-k="d">000</span><small>days</small></div>
        <div><span data-k="h">00</span><small>hrs</small></div>
        <div><span data-k="m">00</span><small>min</small></div>
        <div><span data-k="s">00</span><small>sec</small></div>
      </div>
      <p class="hv-date" data-hero-in>Avengers: Doomsday <span class="accent">&middot;</span> in theaters 18 December 2026<sup class="cite"><a href="#home-sources">{n('S_FILM')}</a></sup></p>
      <p class="hv-lede serif" data-split="lines" data-split-on="load" data-delay="1.4">Heroes from three universes. One existential threat. Before the lights go down, meet every name Marvel has confirmed.</p>
      <div class="hv-cue" aria-hidden="true"><span>Scroll</span><i></i></div>
    </div>
  </section>

  <!-- 02 THE REVEAL -->
  <section class="rev" data-reveal-pin aria-labelledby="rev-h">
    <div class="wrap rev-inner">
      <p class="label">01 &mdash; {fmtDate(reveal.date)} &middot; San Diego Comic-Con, Hall H</p>
      <h2 id="rev-h" class="sr-only">{reveal.title}</h2>
      <div class="figs" aria-hidden="true">
        {Array.from({ length: 9 }).map(() => <span class="fig"></span>)}
      </div>
      <p class="rev-name display">Robert Downey Jr.<br /><em>as Victor von Doom</em></p>
      <p class="rev-copy">{reveal.text}<sup class="cite"><a href="#home-sources">{n('S_SDCC24')}</a></sup></p>
    </div>
  </section>

  <!-- 03 ROLL CALL -->
  <section class="roll" data-roll aria-labelledby="roll-h">
    <div class="wrap">
      <div class="roll-head">
        <p class="label">02 &mdash; {fmtDate(roll.date)} &middot; The livestream</p>
        <h2 id="roll-h" class="display roll-title" data-split="words">One chair at a time.</h2>
        <p class="roll-copy">{roll.text}<sup class="cite"><a href="#home-sources">{n('S_LIVE')}</a></sup></p>
        <p class="roll-count-wrap"><span class="roll-count">00</span> / {ROLL.length}</p>
      </div>
      <ol class="chairs">
        {ROLL.map((name, i) => (
          <li class="chair">
            <span class="chair-back" aria-hidden="true"></span>
            <span class="chair-front"><small>{String(i + 1).padStart(2, '0')}</small>{name}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 THE SIGNALS -->
  <section class="sigs" data-signals aria-labelledby="sig-h">
    <div class="sig-rail">
      <div class="sig sig-intro">
        <p class="label">03 &mdash; The signals</p>
        <h2 id="sig-h" class="display" data-split="lines">Then Marvel started showing its hand.</h2>
      </div>
      {signals.map((s) => (
        <article class="sig">
          <p class="sig-date">{fmtDate(s.date)}</p>
          <h3 class="sig-title serif">{s.title}</h3>
          <p>{s.text}<sup class="cite"><a href="#home-sources">{n(s.source)}</a></sup></p>
        </article>
      ))}
      <div class="sig sig-end">
        <p class="sig-date">{fmtDate(OFFICIAL.film.releaseDate)}</p>
        <p class="display sig-final">Doomsday.</p>
      </div>
    </div>
  </section>

  <!-- 05 ASSEMBLE -->
  <section class="asm" aria-labelledby="asm-h">
    <div class="wrap">
      <p class="label">04 &mdash; Assemble</p>
      <h2 id="asm-h" class="display asm-title" data-split="chars" data-split-style="drop">The roster</h2>
      <p class="asm-copy">Every name on Marvel&rsquo;s cast list for Avengers: Doomsday, plus Hayley Atwell, confirmed at D23.<sup class="cite"><a href="#home-sources">{n('S_FILM')}</a></sup><sup class="cite"><a href="#home-sources">{n('S_D23')}</a></sup> Where Marvel has not named an actor&rsquo;s role, we show their most recent screen role and say so.</p>
      <div class="picker" data-picker>
        <div class="pk-chips" role="group" aria-label="Show one team">
          <button type="button" data-team="all" aria-pressed="true">All <span>{roster.length}</span></button>
          {TEAMS.map((t) => <button type="button" data-team={t.id} aria-pressed="false">{t.short} <span>{CAST.filter((c) => c.team === t.id).length}</span></button>)}
        </div>
        <div class="pk-info" aria-live="polite">
          <p class="pk-blurb" data-for="all">All {roster.length} names. <span class="hover-only">Drag any card and its team follows it.</span></p>
          {TEAMS.map((t) => <p class="pk-blurb" data-for={t.id} hidden>{t.blurb} <a href={u(`/teams/${t.id}/`)}>Open the {t.name} page &rarr;</a></p>)}
        </div>
        <ul class="cards pk-grid">
          {roster.map((c) => {
            const live = isPublished(c.slug);
            const d = c.slug ? DESIGN[c.slug] : null;
            const style = d ? `--card-accent:${d.accent};--card-font:${d.font};--card-weight:${d.fontWeight};--card-case:${d.fontCase}` : '';
            const ph = live ? photosFor(c.slug)[0] : undefined;
            return (
              <li class={`card ${live ? 'live' : 'soon'}${ph ? ' has-photo' : ''}`} style={style} data-team={c.team} data-tilt={live ? '' : undefined}>
                {live ? (
                  <a href={u(`/c/${c.slug}/`)} data-accent={d!.accent} draggable="false">
                    {ph && <Photo photo={ph} alt="" class="card-photo" sizes="(min-width: 900px) 260px, 50vw" />}
                    <span class="card-name">{displayName(c)}</span>
                    <span class="card-actor">{c.actor}</span>
                    <span class="card-tag">{c.character ? 'Role named by Marvel' : 'Role not named by Marvel'}</span>
                    <span class="card-cta">Open dossier &rarr;</span>
                  </a>
                ) : (
                  <div>
                    <span class="card-name">{displayName(c)}</span>
                    <span class="card-actor">{c.actor}</span>
                    <span class="card-tag">{c.team === 'unnamed' ? 'Role not yet named by Marvel' : (c.character ? 'Role named by Marvel' : 'Role not named by Marvel')}</span>
                    <span class="card-cta">{c.team === 'unnamed' ? 'No page until Marvel names the role' : `Dossier coming in wave ${waveOf(c.team)}`}</span>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </div>

      <div class="said">
        <p class="label">What Marvel has said</p>
        <p class="said-logline serif" data-split="lines">{OFFICIAL.film.logline}</p>
        <p class="said-meta">Marvel&rsquo;s official overview, paraphrased. Directed by Joe and Anthony Russo. Produced by Kevin Feige, Louis D&rsquo;Esposito and Jonathan Schwartz.<sup class="cite"><a href="#home-sources">{n('S_FILM')}</a></sup> Avengers: Secret Wars follows on 17 December 2027.<sup class="cite"><a href="#home-sources">{n('S_SECRETWARS')}</a></sup></p>
      </div>

      <details class="sources" id="home-sources">
        <summary>Sources for this page</summary>
        <ol>
          {sourceOrder.map((k) => <li><a href={SRC[k].url} rel="noopener" target="_blank">{SRC[k].label}</a></li>)}
        </ol>
      </details>
    </div>
  </section>
</Base>

<style>
  .h-void { min-height: 100svh; display: grid; align-items: end; padding: calc(var(--header-h) + 40px) 0 56px; }
  .hv-inner { display: grid; gap: 22px; grid-template-columns: minmax(0, 1fr); }
  .hv-count { display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: clamp(14px, 3vw, 48px); font-family: var(--font-mono); margin-top: 22vh; }
  .hv-count div { display: grid; }
  .hv-count span { font-size: clamp(40px, 9vw, 132px); line-height: 0.9; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .hv-count div:first-child span { color: var(--doom); text-shadow: 0 0 40px rgba(61,255,138,0.35); }
  .hv-count small { font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--bone-dim); margin-top: 8px; }
  .hv-date { font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; margin: 0; }
  .hv-lede { font-size: clamp(26px, 3.2vw, 46px); line-height: 1.05; max-width: 22ch; margin: 8px 0 0; }
  .hv-cue { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--bone-dim); margin-top: 18px; }
  .hv-cue i { width: 60px; height: 1px; background: var(--bone-dim); transform-origin: left; animation: cue 2.4s var(--ease-out) infinite; }
  @keyframes cue { 0% { transform: scaleX(0) } 60% { transform: scaleX(1) } 100% { transform: scaleX(1); opacity: 0 } }
  @media (max-width: 600px) { .hv-count { grid-template-columns: repeat(2, auto); margin-top: 16vh; row-gap: 18px; } }

  .rev { min-height: 100svh; display: grid; align-items: center; padding: 120px 0; background: linear-gradient(transparent, rgba(5,6,7,0.85) 30%); }
  .rev-inner { display: grid; gap: 28px; justify-items: center; text-align: center; }
  .figs { display: flex; gap: clamp(8px, 2vw, 22px); align-items: flex-end; height: clamp(160px, 28vh, 280px); }
  .fig { width: clamp(20px, 4vw, 46px); height: 100%; border-radius: 40% 40% 6px 6px / 22% 22% 6px 6px; background: linear-gradient(#123d26, #071a10); box-shadow: inset 0 0 0 1px rgba(61,255,138,0.25); transform-origin: bottom; }
  .rev-name { font-size: clamp(44px, 8vw, 128px); }
  .rev-name em { font-style: italic; color: var(--doom); }
  .rev-copy { max-width: 60ch; color: var(--bone-dim); margin: 0; }

  .roll { padding: 120px 0; min-height: 100svh; }
  .roll-head { display: grid; gap: 14px; margin-bottom: 40px; max-width: 760px; }
  .roll-title { font-size: clamp(48px, 7vw, 110px); }
  .roll-copy { color: var(--bone-dim); margin: 0; }
  .roll-count-wrap { font-family: var(--font-mono); font-size: 13px; color: var(--bone-dim); margin: 0; }
  .roll-count { color: var(--doom); font-size: 28px; }
  .chairs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; perspective: 1200px; }
  .chair { position: relative; aspect-ratio: 4 / 3; transform-style: preserve-3d; }
  .chair-back, .chair-front { position: absolute; inset: 0; backface-visibility: hidden; border-radius: 4px; }
  .chair-back { background: repeating-linear-gradient(90deg, #0d0f10 0 10px, #111415 10px 20px); border: 1px solid var(--iron-2); transform: rotateY(180deg); }
  .chair-front { background: #0a0b0c; border: 1px solid rgba(232,230,225,0.18); display: grid; align-content: end; padding: 12px; font-family: var(--font-serif); font-size: clamp(18px, 1.6vw, 24px); line-height: 1.05; }
  .chair-front small { font-family: var(--font-mono); font-size: 10px; color: var(--doom); letter-spacing: 0.2em; margin-bottom: 6px; }
  @media (min-width: 900px) { .roll { display: grid; align-content: center; } .chairs { grid-template-columns: repeat(9, 1fr); } .chair-front { font-size: 17px; } }

  .sigs { position: relative; overflow: hidden; padding: 100px 0; }
  .sig-rail { display: flex; gap: clamp(18px, 3vw, 40px); padding: 0 var(--gutter); align-items: stretch; }
  .sig { flex: 0 0 min(78vw, 380px); border-top: 1px solid var(--iron-2); padding-top: 20px; }
  .sig p { color: var(--bone-dim); }
  .sig-intro { flex-basis: min(86vw, 520px); border: 0; }
  .sig-intro h2 { font-size: clamp(40px, 5vw, 76px); margin-top: 16px; }
  .sig-date { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--doom) !important; margin: 0 0 10px; }
  .sig-title { font-size: clamp(28px, 2.6vw, 40px); line-height: 1; margin: 0 0 12px; font-weight: 400; }
  .sig-end { border-color: var(--doom); }
  .sig-final { font-size: clamp(56px, 7vw, 110px); color: var(--doom); }
  @media (min-width: 900px) { .sigs { min-height: 100svh; display: flex; align-items: center; } }
  @media (max-width: 899px) { .sig-rail { flex-direction: column; } .sig { flex-basis: auto; } }

  .asm { padding: 120px 0 80px; }
  .asm-title { font-size: clamp(64px, 12vw, 200px); }
  .asm-copy { max-width: 64ch; color: var(--bone-dim); }
  /* team picker: chips filter the grid (cards fly to their new places), drag a card and its team follows */
  .asm { content-visibility: auto; contain-intrinsic-size: auto 3200px; }
  .picker { margin-top: 56px; overflow-anchor: none; contain: layout style; } /* flying cards must not become the browser's scroll anchor */
  .pk-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .pk-chips button { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; border: 1px solid var(--iron-2); padding: 10px 14px; border-radius: 99px; min-height: 44px; color: var(--bone-dim); transition: background 0.3s, color 0.3s, border-color 0.3s; }
  .pk-chips button span { color: var(--doom); margin-left: 4px; }
  .pk-chips button:hover { border-color: var(--bone-dim); color: var(--bone); }
  .pk-chips button[aria-pressed='true'] { background: var(--bone); color: var(--void); border-color: var(--bone); }
  .pk-chips button[aria-pressed='true'] span { color: var(--void); }
  @media (max-width: 700px) { .pk-chips { flex-wrap: nowrap; overflow-x: auto; margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter) 6px; scrollbar-width: none; } .pk-chips button { flex: 0 0 auto; } }
  .pk-info { min-height: 3.2em; margin: 18px 0 22px; }
  .pk-blurb { margin: 0; color: var(--bone-dim); max-width: 70ch; }
  .pk-blurb a { color: var(--bone); text-underline-offset: 3px; text-decoration-color: var(--doom); }
  .hover-only { display: none; }
  @media (hover: hover) and (pointer: fine) { .hover-only { display: inline; } }
  .pk-grid { user-select: none; -webkit-user-select: none; align-content: start; }
  .pk-grid .card { touch-action: pan-y; }
  :global(.pk-dragging) .card { transition: opacity 0.4s, border-color 0.4s; }
  :global(.pk-dragging) .card:not(.pk-team) { opacity: 0.28; }
  .card.pk-team { position: relative; }
  .card.pk-lead { cursor: grabbing; }
  .pk-out { display: none !important; }
  .team-block { margin-top: 64px; }
  .team-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--iron-2); padding-bottom: 10px; margin-bottom: 16px; gap: 12px; }
  .team-head h3 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(30px, 3.4vw, 48px); margin: 0; }
  .team-head a { text-decoration: none; }
  .team-head a:hover { color: var(--doom); font-style: italic; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; perspective: 1000px; }
  .card { --card-accent: var(--iron-2); position: relative; border: 1px solid var(--iron); border-radius: 6px; background: radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), color-mix(in srgb, var(--card-accent) 18%, transparent), transparent 60%), #0a0c0d; transform-style: preserve-3d; transition: border-color 0.4s; }
  .card > a, .card > div { display: grid; gap: 6px; padding: 18px; min-height: 170px; text-decoration: none; align-content: end; }
  .card.live:hover { border-color: var(--card-accent); }
  /* photo cards: portrait fills the card, graded at rest, full colour under the pointer */
  .card.has-photo { overflow: hidden; }
  .card.has-photo > a { position: relative; min-height: clamp(280px, 30vw, 360px); isolation: isolate; }
  .card.has-photo .card-name, .card.has-photo .card-actor, .card.has-photo .card-tag, .card.has-photo .card-cta { position: relative; z-index: 2; }
  :global(.card-photo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; transition: transform 1s var(--ease-out); }
  /* rest dim as an overlay, not a filter: filters repaint every frame while cards fly */
  .card.has-photo > a::before { content: ''; position: absolute; inset: 0; z-index: 1; background: rgba(5, 6, 7, 0.22); pointer-events: none; transition: opacity 0.7s var(--ease-out); }
  .card.has-photo:hover > a::before, .card.has-photo:focus-within > a::before { opacity: 0; }
  .card.has-photo > a::after { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(to top, #050607 6%, rgba(5, 6, 7, 0.82) 34%, rgba(5, 6, 7, 0) 66%); pointer-events: none; }
  .card.has-photo:hover :global(.card-photo), .card.has-photo:focus-within :global(.card-photo) { transform: scale(1.07); }
  @media (hover: none) { .card.has-photo > a::before { opacity: 0; } }
  .card-name { font-family: var(--card-font, var(--font-serif)); font-weight: var(--card-weight, 400); text-transform: uppercase; font-size: 26px; line-height: 1; color: var(--bone); }
  .card.soon .card-name { font-family: var(--font-serif); font-weight: 400; text-transform: uppercase; letter-spacing: 0.01em; color: var(--bone-dim); }
  .card-actor { font-size: 14px; color: var(--bone-dim); }
  .card-tag, .card-cta { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--iron-2); }
  .card.live .card-tag { color: var(--bone-dim); }
  .card.live .card-cta { color: var(--card-accent); }

  .said { margin-top: 100px; display: grid; gap: 16px; max-width: 900px; }
  .said-logline { font-size: clamp(28px, 3.6vw, 52px); line-height: 1.05; margin: 0; }
  .said-meta { color: var(--bone-dim); margin: 0; }
</style>

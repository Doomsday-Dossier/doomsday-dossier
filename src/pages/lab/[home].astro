---
// The two home pages for the user to choose between (CLAUDE.md, "through the mask"): forge A, then the push
// into Doom's eye, then the archive as 1, the hall, or 2, the drawer. Not linked from the site.
// ?rec records the sound mix for the screen recordings; ?first replays the full forge.
import '@fontsource-variable/big-shoulders-display';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
import { castFor, publishedOrder, TEAMS, heroName, u } from '../../data/site';
import { accentOf, photos2For, pick2 } from '../../data/v2';
import { LENGTHS } from '../../scripts/home/home';

export function getStaticPaths() {
  return [{ params: { home: 'home-1' }, props: { version: 1, name: '1: the hall' } }, { params: { home: 'home-2' }, props: { version: 2, name: '2: the drawer' } }];
}
const { version, name } = Astro.props as { version: 1 | 2; name: string };
const files = publishedOrder().map((slug, i) => {
  const p = photos2For(slug)[0];
  return {
    slug, no: i + 1, name: heroName(slug).toUpperCase(), team: TEAMS.find((t) => t.id === castFor(slug)!.team)!.name, accent: accentOf(slug),
    href: u(`/c/${slug}/`), photo: pick2(p.full, 1920), photoS: pick2(p.full, 1280), aspect: p.w / p.h,
  };
});
const mask = { photo: u('/photos2/victor-von-doom/1-1920.webp'), photoS: u('/photos2/victor-von-doom/1-1280.webp'), depth: u('/photos2/victor-von-doom/1-depth-1024.webp'), eye: [0.47, 0.49] };
const length = LENGTHS.mask + files.length * LENGTHS.perFile[version] + 1;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Home {name} | Doomsday Dossier lab</title>
  </head>
  <body>
    <div class="forge" data-forge data-version={version} data-files={JSON.stringify(files)} data-mask={JSON.stringify(mask)}>
      <canvas aria-hidden="true"></canvas>
      <div class="flood" data-flood aria-hidden="true"></div>
      <h1 class="sr">Doomsday Dossier</h1>
      <p class="cue" data-cue aria-hidden="true"><i></i>Scroll into the mask</p>
      <div class="file" data-file>
        <p class="no" data-no></p>
        <a class="name" data-name href="#"></a>
        <p class="team" data-team></p>
        <a class="open" data-open href="#">Open the file <span aria-hidden="true">&rarr;</span></a>
      </div>
      <button type="button" class="gate" data-gate><span class="sr">Enter the forge</span></button>
      <button type="button" class="mute" data-mute aria-pressed="false"><i aria-hidden="true"></i><span>Sound on</span></button>
    </div>
    <div class="track" style={`height:${length * 100}svh`}></div>
    <script>
      import Lenis from 'lenis';
      import { runForge } from '../../scripts/forge/run';
      import { homeExtension, type HomeFile } from '../../scripts/home/home';
      const root = document.querySelector<HTMLElement>('[data-forge]')!;
      const q = new URLSearchParams(location.search);
      const phone = matchMedia('(pointer: coarse)').matches || innerWidth < 768;
      const files = (JSON.parse(root.dataset.files!) as (HomeFile & { photoS: string })[]).map((f) => ({ ...f, photo: phone ? f.photoS : f.photo }));
      const m = JSON.parse(root.dataset.mask!);
      const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;

      // scrolling waits until the title stands
      scrollTo(0, 0);
      const lenis = new Lenis({ lerp: 0.075, wheelMultiplier: 0.8, touchMultiplier: 1.3 });
      lenis.stop();
      document.documentElement.classList.add('locked');
      const raf = (now: number) => { lenis.raf(now); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
      if (/^(localhost|127\.)/.test(location.hostname)) (window as any).__ddLenis = lenis;

      runForge(root, {
        version: 'a', first: q.has('first'), recordAudio: q.has('rec'),
        extend: homeExtension({
          version: Number(root.dataset.version) as 1 | 2, files,
          mask: { photo: phone ? m.photoS : m.photo, depth: m.depth, eye: m.eye },
          ui: { file: $('[data-file]'), no: $('[data-no]'), name: $('[data-name]'), team: $('[data-team]'), open: $('[data-open]'), cue: $('[data-cue]'), flood: $('[data-flood]') },
          scrollY: () => lenis.scroll, vh: () => innerHeight,
        }),
        onSettled: () => { document.documentElement.classList.remove('locked'); lenis.start(); },
      });
    </script>
  </body>
</html>

<style is:global>
  html, body { margin: 0; background: #050607; color: #e7e4dc; }
  html.locked, html.locked body { overflow: hidden; }
  .forge canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
  .track { pointer-events: none; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .gate { position: fixed; z-index: 3; inset: 0; width: 100%; height: 100%; background: none; border: 0; cursor: pointer; }
  .gate:focus-visible { outline: 1px solid #1fd47a; outline-offset: -12px; }
  .mute { position: fixed; z-index: 4; top: 18px; right: 18px; display: flex; align-items: center; gap: 10px; background: none; border: 1px solid rgba(231, 228, 220, 0.35); border-radius: 99px; color: #e7e4dc; padding: 8px 14px; font: 400 11px/1 'Courier Prime', monospace; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; }
  .mute i { width: 8px; height: 8px; border-radius: 50%; background: #1fd47a; box-shadow: 0 0 10px #1fd47a; }
  .mute[aria-pressed='true'] i { background: #5c5f58; box-shadow: none; }

  /* the green through the eye: brightest at the centre, where the slit was */
  .flood { position: fixed; inset: 0; z-index: 1; pointer-events: none; opacity: 0; background: radial-gradient(circle at 50% 50%, #d8ffe9 0%, #2bff95 18%, #0c9a52 55%, #02170c 100%); }

  .cue { position: fixed; z-index: 2; left: 50%; bottom: max(28px, env(safe-area-inset-bottom)); transform: translateX(-50%); margin: 0; display: flex; align-items: center; gap: 12px; font: 400 11px/1 'Courier Prime', monospace; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(231, 228, 220, 0.62); opacity: 0; transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1); white-space: nowrap; }
  .cue i { width: 1px; height: 28px; background: linear-gradient(#1fd47a, transparent); animation: cue 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite; transform-origin: top; }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

  .file { --a: #1fd47a; position: fixed; z-index: 2; left: clamp(20px, 5vw, 72px); bottom: clamp(28px, 7vh, 72px); right: 20px; visibility: hidden; opacity: 0; pointer-events: none; }
  .file a { pointer-events: auto; }
  .file .no, .file .team { margin: 0; font: 400 11px/1.4 'Courier Prime', monospace; letter-spacing: 0.2em; text-transform: uppercase; }
  .file .no { color: var(--a); margin-bottom: 14px; }
  .file .team { color: rgba(231, 228, 220, 0.6); margin-top: 12px; }
  .file .name { display: block; color: #e7e4dc; text-decoration: none; font: 900 clamp(46px, 9vw, 132px)/0.86 'Big Shoulders Display Variable', sans-serif; letter-spacing: -0.01em; text-shadow: 0 2px 30px rgba(0, 0, 0, 0.6); }
  .file .name .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.04em; }
  .file .name .c { display: inline-block; }
  .file .open { display: inline-block; margin-top: 22px; color: #e7e4dc; text-decoration: none; font: 700 12px/1 'Courier Prime', monospace; letter-spacing: 0.18em; text-transform: uppercase; padding: 12px 18px; border: 1px solid color-mix(in srgb, var(--a) 70%, transparent); border-radius: 99px; transition: background 0.4s cubic-bezier(0.22, 1, 0.36, 1); }
  .file .open:hover, .file .open:focus-visible { background: color-mix(in srgb, var(--a) 22%, transparent); }
</style>

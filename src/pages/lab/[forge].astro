---
// The two forge openings for the user to choose between (CLAUDE.md, "The forge"). Not linked from the site.
// ?record captures the canvas and the sound for the screen recordings; ?first replays the full forge.
import '@fontsource-variable/big-shoulders-display';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';

export function getStaticPaths() {
  return [{ params: { forge: 'forge-a' }, props: { version: 'a', name: 'A: the slow burn' } }, { params: { forge: 'forge-b' }, props: { version: 'b', name: 'B: the strike' } }];
}
const { version, name } = Astro.props as { version: 'a' | 'b'; name: string };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>Forge {name} | Doomsday Dossier lab</title>
  </head>
  <body>
    <div class="forge" data-forge data-version={version}>
      <canvas aria-hidden="true"></canvas>
      <h1 class="sr">Doomsday Dossier</h1>
      <button type="button" class="gate" data-gate><span class="sr">Enter the forge</span></button>
      <button type="button" class="mute" data-mute aria-pressed="false"><i aria-hidden="true"></i><span>Sound on</span></button>
    </div>
    <script>
      import { runForge } from '../../scripts/forge/run';
      const root = document.querySelector<HTMLElement>('[data-forge]')!;
      const q = new URLSearchParams(location.search);
      runForge(root, { version: root.dataset.version as 'a' | 'b', record: q.has('record'), first: q.has('first') });
    </script>
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #050607; overflow: hidden; }
  .forge canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .gate { position: fixed; inset: 0; width: 100%; height: 100%; background: none; border: 0; cursor: pointer; }
  .gate:focus-visible { outline: 1px solid #1fd47a; outline-offset: -12px; }
  .mute { position: fixed; z-index: 2; top: 18px; right: 18px; display: flex; align-items: center; gap: 10px; background: none; border: 1px solid rgba(231, 228, 220, 0.35); border-radius: 99px; color: #e7e4dc; padding: 8px 14px; font: 400 11px/1 'Courier Prime', monospace; letter-spacing: 0.16em; text-transform: uppercase; cursor: pointer; }
  .mute i { width: 8px; height: 8px; border-radius: 50%; background: #1fd47a; box-shadow: 0 0 10px #1fd47a; }
  .mute[aria-pressed='true'] i { background: #5c5f58; box-shadow: none; }
</style>

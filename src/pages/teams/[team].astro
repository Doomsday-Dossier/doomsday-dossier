---
// A team, design system v2 (Lena Varga). Each member is a full-screen slide in their own colour: the
// subject large and floating, sized by their measured outline so the face is never cropped, and their
// name set bottom-left in their own face, in front, never covered. Scrolling sweeps the next one in.
import Dossier from '../../layouts/Dossier.astro';
import '../../styles/faces';
import { TEAMS, CAST, DESIGN, isPublished, displayName, getResearch, u, heroName } from '../../data/site';
import { PHOTO_CREDIT } from '../../data/photos';
import { accentOf, photos2For, pick2, srcset2 } from '../../data/v2';

export function getStaticPaths() {
  return TEAMS.map((t) => ({ params: { team: t.id } }));
}
const { team } = Astro.params as { team: string };
const t = TEAMS.find((x) => x.id === team)!;
const idx = TEAMS.findIndex((x) => x.id === team);
const nextTeam = TEAMS[(idx + 1) % TEAMS.length];
const pad = (n: number) => String(n).padStart(2, '0');
const all = CAST.filter((c) => c.team === team);
const members = all.filter((c) => isPublished(c.slug)).map((c) => {
  const slug = c.slug!, d = DESIGN[slug], r = getResearch(slug)!, p = photos2For(slug)[0];
  const name = heroName(slug).toUpperCase();
  const w = name.split(' ');
  let lines = [name];
  for (let i = 1; i < w.length; i++) { const l = [w.slice(0, i).join(' '), w.slice(i).join(' ')]; if (lines.length === 1 || Math.max(...l.map((x) => x.length)) < Math.max(...lines.map((x) => x.length))) lines = l; }
  return {
    slug, name, lines, longest: Math.max(...lines.map((l) => l.length)), accent: accentOf(slug), font: d.font, weight: d.fontWeight,
    actor: c.actor, named: !!c.character, alias: r.alias, fa: r.origin.firstAppearance,
    cut: p?.cut.length ? p.cut : null, full: p?.full ?? [], w: p?.w ?? 1, h: p?.h ?? 1, head: p?.head?.[0] ?? 0.5, focus: p?.focusM ?? '50% 50%',
    // the subject's outline in the photo (top edge and width), for sizing the cut-out
    y0: p?.bbox?.[1] ?? 0, bw: p?.bbox ? p.bbox[2] - p.bbox[0] : 1,
  };
});
const others = all.filter((c) => !isPublished(c.slug));
---
<Dossier title={`${t.name}: team file`} description={`${t.name}: every confirmed member in Avengers: Doomsday.`} page="team" accent={members[0]?.accent ?? '#1fd47a'}>
  <article class="team" data-team>
    <header class="tm-head wrap">
      <p class="t-label t-accent">Team {pad(idx + 1)} / {pad(TEAMS.length)} &middot; {members.length} {members.length === 1 ? 'file' : 'files'}</p>
      <h1 class="t-title tm-title" data-fit data-rise>{t.name}</h1>
      <p class="tm-blurb">{t.blurb}</p>
    </header>

    {members.length > 0 && (
      <section class="tm-carousel" data-carousel style={`--n:${members.length}`} aria-label={`${t.name} members`}>
        <div class="tm-stage">
          {members.map((m) => <div class="tm-bg" data-bg style={`--a:${m.accent}`} aria-hidden="true"></div>)}
          <div class="tm-top t-micro" aria-hidden="true">
            <span class="tm-count"><b data-count>01</b> / {pad(members.length)}</span>
            <ol class="tm-dots">{members.map((m) => <li data-dot style={`--a:${m.accent}`}></li>)}</ol>
          </div>
          {members.map((m, i) => {
            const r3 = (v: number) => Math.round(v * 1000) / 1000;
            return (
            <div class="tm-slide" data-slide style={`--a:${m.accent};--f:${m.font};--fw:${m.weight};--longest:${m.longest}`} aria-hidden={i > 0 ? 'true' : undefined}>
              <div class="tm-subj" style={`--ar:${r3(m.w / m.h)};--y0:${r3(m.y0)};--bw:${r3(m.bw)};--cx:${r3(m.cut ? m.head : 0.5)}`}>
                <div class="tm-par" data-par><div class="tm-fly" data-fly>
                  {m.cut
                    ? <img data-cut src={pick2(m.cut, 1280)} srcset={srcset2(m.cut)} sizes="(min-width: 900px) 60vw, 130vw" width={m.w} height={m.h} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
                    : <img data-cut class="soft" src={pick2(m.full, 1280)} srcset={srcset2(m.full)} sizes="100vw" width={m.w} height={m.h} alt="" loading="lazy" decoding="async" style={`object-position:${m.focus}`} />}
                </div></div>
              </div>
              <div class="tm-copy">
                <p class="t-micro tm-kicker" data-info>{m.alias}</p>
                <p class="tm-name" data-name data-fit>{m.lines.map((l) => <><span class="ln">{l}</span>{' '}</>)}</p>
                <div class="tm-info" data-info>
                  <p class="t-micro t-ash">{m.named ? 'Role named by Marvel' : 'Marvel lists ' + m.actor + ' in the cast'} &middot; first appeared {m.fa.coverDate}</p>
                  <a class="tm-open t-label" href={u(`/c/${m.slug}/`)} data-cursor="Open">Open the file &rarr;</a>
                </div>
              </div>
            </div>
          ); })}
          <p class="tm-cue t-micro" data-cue>Scroll</p>
        </div>
      </section>
    )}

    <section class="tm-index wrap" aria-labelledby="idx-h">
      <h2 id="idx-h" class="t-label t-accent">Every member on file</h2>
      <ol class="tm-grid">
        {members.map((m, i) => (
          <li style={`--a:${m.accent}`}>
            <a href={u(`/c/${m.slug}/`)}>
              <span class="tg-photo">{(m.cut || m.full.length > 0) && <img src={pick2(m.cut ?? m.full, 640)} alt="" loading="lazy" decoding="async" class={m.cut ? 'cut' : ''} style={m.cut ? undefined : `object-position:${m.focus}`} />}</span>
              <span class="t-micro t-accent">File {pad(i + 1)}</span>
              <b>{m.name}</b>
              <span class="t-micro t-ash">{m.actor}</span>
            </a>
          </li>
        ))}
        {others.map((c) => (
          <li class="unnamed">
            <span class="tg-inner">
              <span class="t-micro t-ash">No file yet</span>
              <b>{displayName(c)}</b>
              <span class="t-micro t-ash">{c.team === 'unnamed' ? 'Role not yet named by Marvel' : 'Role not named by Marvel'}</span>
            </span>
          </li>
        ))}
      </ol>
      <nav class="tm-next">
        <a href={u(`/teams/${nextTeam.id}/`)}><span class="t-micro t-ash">Next team</span><b class="t-title">{nextTeam.name} &rarr;</b></a>
        <a href={u('/')}><span class="t-micro t-ash">Back to</span><b class="t-title">The archive</b></a>
      </nav>
      <p class="t-micro t-ash">{PHOTO_CREDIT}</p>
    </section>
  </article>
</Dossier>

<style>
  .tm-head { padding: calc(var(--header-h) + var(--s-8)) 0 var(--s-7); display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); position: relative; z-index: 2; }
  .tm-title { font-size: var(--t-mega); font-weight: 900; }
  .tm-blurb { max-width: 60ch; color: var(--ash); margin: 0; }

  .tm-carousel { position: relative; height: calc(var(--n) * 90svh + 100svh); }
  .tm-stage { position: sticky; top: 0; height: 100svh; overflow: hidden; background: var(--gunmetal); }
  /* the colour field: bold, in the member's colour, darkening toward the floor */
  .tm-bg { position: absolute; inset: 0; background:
    radial-gradient(ellipse 70% 55% at 62% 42%, color-mix(in srgb, var(--a) 62%, #0d1012) 0%, transparent 70%),
    linear-gradient(170deg, color-mix(in srgb, var(--a) 46%, #0d1012) 0%, color-mix(in srgb, var(--a) 24%, #0d1012) 60%, color-mix(in srgb, var(--a) 10%, #0d1012) 100%); }
  .tm-bg + .tm-bg { visibility: hidden; }
  .tm-top { position: absolute; z-index: 4; top: calc(var(--header-h) + 4px); left: var(--margin); right: var(--margin); display: flex; justify-content: space-between; align-items: center; color: var(--bone); }
  .tm-count b { font-weight: 700; }
  .tm-dots { list-style: none; margin: 0; padding: 0; display: flex; gap: 6px; }
  .tm-dots li { width: 18px; height: 2px; background: color-mix(in srgb, var(--bone) 30%, transparent); transition: background 0.4s, width 0.4s; }
  .tm-dots li.on { width: 34px; background: var(--bone); }
  .tm-slide { position: absolute; inset: 0; visibility: hidden; }
  .tm-slide:first-of-type { visibility: visible; }
  /* the subject: bottom-anchored, its outline (not the photo frame) sized to a share of the screen;
     wide subjects are capped by width; the head sits on a set line */
  .tm-subj { --sh: 80svh; --sw: 54vw; --tx: 64%; position: absolute; z-index: 1; bottom: 0; left: var(--tx);
    height: min(calc(var(--sh) / (1 - var(--y0))), calc(var(--sw) / (var(--ar) * var(--bw))));
    aspect-ratio: var(--ar); transform: translateX(calc(-100% * var(--cx))); pointer-events: none; }
  .tm-par, .tm-fly { width: 100%; height: 100%; }
  .tm-fly { transform-origin: 50% 85%; will-change: transform; }
  .tm-subj img { display: block; width: 100%; height: 100%; animation: tm-float 7s ease-in-out infinite; }
  .tm-subj img.soft { object-fit: cover; -webkit-mask-image: radial-gradient(ellipse at 50% 45%, #000 35%, transparent 72%); mask-image: radial-gradient(ellipse at 50% 45%, #000 35%, transparent 72%); }
  @keyframes tm-float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-1.4%) rotate(-0.6deg); } }
  /* the name: bottom-left, in front of the subject, in the character's own face */
  .tm-copy { position: absolute; z-index: 3; left: var(--margin); bottom: var(--s-7); width: min(46vw, 760px); display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-3); } /* minmax: a wide word must not widen the column, or the name is never fitted */
  .tm-kicker { margin: 0; color: var(--bone); letter-spacing: 0.18em; }
  .tm-name { margin: 0; font-family: var(--f); font-weight: var(--fw); text-transform: uppercase; line-height: 0.88; color: var(--bone);
    font-size: min(9vw, 15svh, calc(min(46vw, 760px) / (var(--longest) * 0.62))); }
  .tm-name .ln { display: block; }
  /* headroom: split into single letters, a name loses its kerning and grows a few pixels; fitText measures the
     unsplit word, so leave it 5% of the line spare or a word that just fits wraps (RED GUARDIA/N) */
  .tm-name { padding-right: 5%; }
  .tm-info { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-5); }
  .tm-info p { margin: 0; max-width: 46ch; }
  .tm-open { color: var(--bone); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .tm-cue { position: absolute; z-index: 4; right: var(--margin); bottom: var(--s-7); margin: 0; color: var(--bone); writing-mode: vertical-rl; letter-spacing: 0.3em; }
  @media (max-width: 760px) {
    /* phones: the subject stands centred in the upper part, the name below on a scrim, never over the face */
    .tm-subj { --sh: 66svh; --sw: 118vw; --tx: 50%; bottom: 20svh; }
    .tm-stage::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 52svh; z-index: 2; pointer-events: none;
      background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--accent) 12%, #0d1012) 52%); }
    .tm-copy { width: auto; right: var(--margin); bottom: var(--s-6); }
    .tm-name { font-size: min(19vw, calc((100vw - 2 * var(--margin)) / (var(--longest) * 0.62))); }
    .tm-cue { display: none; }
  }
  @media (min-width: 761px) and (max-height: 760px) {
    .tm-subj { --sh: 74svh; }
    .tm-copy { bottom: var(--s-6); }
  }
  html.rm .tm-carousel { display: none; }

  .tm-index { position: relative; z-index: 2; padding: var(--s-9) 0 var(--s-8); background: var(--gunmetal); }
  .tm-grid { list-style: none; margin: var(--s-5) 0 var(--s-8); padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 1px; background: var(--iron); border: 1px solid var(--iron); }
  .tm-grid a, .tm-grid .tg-inner { display: grid; gap: 6px; padding: var(--s-4); background: var(--gunmetal); text-decoration: none; height: 100%; align-content: start; }
  .tm-grid a:hover { background: var(--gunmetal-2); }
  .tg-photo { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; margin-bottom: 8px; background: radial-gradient(circle at 50% 75%, color-mix(in srgb, var(--a) 40%, #0d1012), #0d1012 75%); }
  .tg-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--e-reveal); }
  .tg-photo img.cut { object-fit: contain; object-position: 50% 100%; inset: 8% 0 0; height: 92%; }
  .tm-grid a:hover .tg-photo img { transform: scale(1.06); }
  .tm-grid b { font-family: var(--f-title); font-weight: 800; font-size: 26px; text-transform: uppercase; line-height: 0.95; }
  .unnamed .tg-inner { min-height: 120px; }
  .tm-next { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--s-5); margin-bottom: var(--s-5); }
  .tm-next a { display: grid; gap: 6px; padding: var(--s-6); border: 1px solid var(--iron); text-decoration: none; }
  .tm-next a:hover { border-color: var(--accent); }
  .tm-next b { font-size: var(--t-2); font-weight: 800; }
</style>

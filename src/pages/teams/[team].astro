---
// A team's page in DOOM-OS: the target register opened on that team's continent, with Marvel's line on the team.
import OS from '../../layouts/OS.astro';
import Register from '../../components/Register.astro';
import { TEAMS, CAST } from '../../data/site';

export function getStaticPaths() {
  return TEAMS.map((t) => ({ params: { team: t.id } }));
}
const { team } = Astro.params as { team: string };
const t = TEAMS.find((x) => x.id === team)!;
const unnamed = CAST.filter((c) => c.team === team && !c.slug);
---
<OS title={t.name} page="targets" description={`${t.name} in Avengers: Doomsday: every confirmed member, filed by Doctor Doom's surveillance system. ${t.blurb}`}>
  <div class="mod-head">
    <div>
      <p class="os-label">Module 01 // Target register // continent</p>
      <h1 class="os-display os-hi mod-title">{t.name}</h1>
      <p class="mod-sub">{t.blurb}</p>
      {unnamed.length > 0 && <p class="mod-sub os-label">Also on Marvel's cast list, role not yet named: {unnamed.map((c) => c.actor).join(', ')}.</p>}
    </div>
    <p class="os-label">Your verdicts are kept on this device &middot; fan opinion, not fact</p>
  </div>
  <Register team={team} />
</OS>

---
// DOOM-OS module 03, the combat simulation (CLAUDE.md, "Design system v4"): any two targets placed in the chamber
// side by side, each scanned in by Doom's sensors and locked, one radar laying both of Marvel's power grids over
// each other, then their documented feats, abilities and connections, every figure sourced. The system computes no
// victor (rule: no "who would win" verdict); the only verdict on the screen is the fan vote, labelled as such. The v1
// arena logic (motion/versus.ts, arena.ts, board.ts) runs unchanged on the hooks below; scripts/os/pages/combat.ts
// adds the scanners, the radar and the simulate moment.
import OS from '../layouts/OS.astro';
import { DESIGN, getResearch, castFor, publishedOrder, TEAMS, heroName, u } from '../data/site';
import { PHOTO_CREDIT } from '../data/photos';
import { accentOf, photos2For, pick2 } from '../data/v2';
import { scanPhoto, versusOf, PICK } from '../data/os';

// Versus data: official Handbook grids, abilities, feats and power origins (research/versus), plus each target's
// screen titles for the connections panel and the photo and depth map the scanner sweeps.
const key = (t: string) => t.toLowerCase().replace(/[^a-z0-9]/g, '');
const roster = publishedOrder().map((slug, i) => {
  const d = DESIGN[slug], r = getResearch(slug)!, c = castFor(slug)!, v = versusOf(slug), sp = scanPhoto(slug);
  const ph = photos2For(slug).find((x) => x.n === PICK[slug]) ?? photos2For(slug)[0];
  return {
    slug, name: heroName(slug), alias: r.alias, actor: c.actor, team: TEAMS.find((t) => t.id === c.team)?.name ?? '', teamId: c.team,
    accent: accentOf(slug), font: d.font, weight: d.fontWeight, url: u(`/c/${slug}/`), no: i + 1,
    // `big` is the scanner's own photo, so the v1 preload on hover warms the scan
    photo: ph ? { small: pick2(ph.full, 200), big: sp?.photo ?? pick2(ph.full, 1280), focus: ph.focusM } : null,
    scan: sp ? { photo: sp.photo, depth: sp.depth, head: sp.head, bbox: sp.bbox } : null,
    grid: v?.powerGrid?.values ?? null, gridSource: v?.powerGrid?.source ?? null, gridNote: v?.powerGrid?.caption ?? null,
    powerType: v?.powerType ?? null, origins: v?.powerOrigins ?? [], abilities: v?.abilities ?? [], feats: v?.feats ?? [],
    screens: [...r.screen].sort((a: any, b: any) => a.year - b.year).map((s: any) => ({ k: key(s.title) + s.year, title: s.title, year: s.year })),
    ready: !!v,
  };
});
const data = JSON.stringify(roster);
// the arena worker and Turnstile site key come from the build environment; without them voting shows as opening soon
const arenaApi = import.meta.env.PUBLIC_ARENA_API ?? '';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const pad = (n: number) => String(n).padStart(2, '0');
---
<OS title="Combat simulation" page="versus" description="DOOM-OS combat simulation: place any two Avengers: Doomsday characters side by side, with Marvel's published power grids, documented feats, abilities and connections, every stat sourced, and a fan vote. No winner is declared.">
  <section class="cb" data-versus>
    <div class="mod-head">
      <div>
        <p class="os-label">Module 03 // Combat simulation</p>
        <h1 class="os-display os-hi mod-title">Two targets</h1>
        <p class="mod-sub">Place any two targets in the chamber, Your Majesty. The system lays their documented feats and Marvel's published power grids side by side, every figure with its source. It computes no victor: the grids are the comics', the films don't always match them, and the only verdict on this screen is the fan vote.</p>
      </div>
      <p class="os-label">No verdict computed &middot; the fan vote is fan opinion</p>
    </div>

    <p class="cb-simline os-label"><b class="os-hi" data-sim-state>Simulation ready</b><span data-sim-line></span></p>

    <div class="vs-stage cb-stage">
      <i class="vs-flash" aria-hidden="true"></i>
      <article class="vs-side cb-side" data-side="a" aria-label="Target A"></article>
      <div class="vs-mid cb-mid">
        <i class="vs-shock" aria-hidden="true"></i>
        <span class="vs-badge" aria-hidden="true">VS</span>
        <b class="cb-simtag" data-simtag aria-hidden="true">Simulate</b>
        <div class="os-panel cb-radar">
          <header><b>Power grid overlay</b><span class="os-label">Comics</span></header>
          <div class="cb-radar-host" data-cb-radar role="img" aria-label="Marvel power grid radar for both targets"></div>
          <p class="cb-legend"><span class="la"><i></i><b data-leg-a></b></span><span class="lb"><i></i><b data-leg-b></b></span></p>
          <p class="cb-note" data-cb-note>Marvel Handbook power grid, 1 to 7, as published on Marvel.com's Marvel Universe wiki. Comics stats: the films don't always match.</p>
        </div>
        <!-- the v1 radar keeps its hooks (motion/versus.ts draws into it); DOOM-OS shows the HUD radar above instead -->
        <svg class="cb-v1radar" viewBox="-162 -132 324 264" aria-hidden="true" data-radar>
          <g class="rings"></g><g class="axes"></g>
          <g class="shape-b"><polygon class="glow" /><polygon class="glow2" /><polygon class="fill" /></g>
          <g class="shape-a"><polygon class="glow" /><polygon class="glow2" /><polygon class="fill" /></g>
          <g class="labels"></g>
        </svg>
      </div>
      <article class="vs-side cb-side" data-side="b" aria-label="Target B"></article>
    </div>

    <div class="os-panel cb-pick" data-os-in>
      <header><b>Select targets</b><span class="os-label">29 on file &middot; shareable link</span></header>
      <div class="cb-pick-head">
        <span class="os-label">Assign to</span>
        <div class="cb-slots" role="group" aria-label="Which side to change">
          <button type="button" class="cb-slot" data-slot="a" aria-pressed="true">Target A</button>
          <button type="button" class="cb-slot" data-slot="b" aria-pressed="false">Target B</button>
        </div>
        <button type="button" class="os-btn cb-tool" data-swap>Swap sides</button>
        <button type="button" class="os-btn cb-tool" data-share>Copy link</button>
      </div>
      <ul class="vs-roster cb-roster">
        {roster.map((c) => (
          <li><button type="button" data-pick={c.slug} aria-label={c.name}>
            <span class="cb-tile scanhov">{c.photo ? <img src={c.photo.small} alt="" width="64" height="64" loading="lazy" decoding="async" class="os-tint" style={`object-position:${c.photo.focus}`} /> : <span>{c.name.slice(0, 1)}</span>}</span>
            <i class="os-label">T-{pad(c.no)}</i>
            <b>{c.name}</b>
          </button></li>
        ))}
      </ul>
    </div>

    <div class="cb-two">
      <section class="os-panel vs-vote cb-vote" data-vote data-api={arenaApi} data-sitekey={turnstileKey} aria-labelledby="vote-h" data-os-in>
        <header><b>Fan vote</b><span class="os-label">Opinion, not fact</span></header>
        <h2 id="vote-h" class="cb-vote-q">Who wins this fight?</h2>
        <p class="cb-vote-sub">The system declares no victor. Fans do, one vote per fight per day.</p>
        <div class="vote-btns"><button type="button" class="cb-vbtn" data-v="a">Target A</button><span class="os-label" aria-hidden="true">or</span><button type="button" class="cb-vbtn" data-v="b">Target B</button></div>
        <p class="vote-status" data-status role="status"></p>
        <div class="vote-result" data-result hidden></div>
        <div class="vote-ts" data-ts></div>
        <p class="vote-note">Bots are kept out by Cloudflare Turnstile; this site stores no account, name or IP address. <button type="button" class="vote-peek" data-peek>See the fan split without voting</button></p>
      </section>

      <section class="os-panel lb cb-board" data-board id="most-wanted" aria-labelledby="lb-h" data-os-in>
        <header><b id="lb-h">Most-wanted fights</b><span class="os-label">Fan votes, live</span></header>
        <p class="lb-note">The fights fans want most, ranked by total fan votes and updated as people vote. Fan opinion, not fact. <span class="os-label" data-board-stamp></span></p>
        <ol class="lb-list" data-board-list aria-live="polite"></ol>
        <p class="lb-empty" data-board-empty hidden>No fights have been voted on yet. Pick two targets and cast the first fan vote.</p>
      </section>
    </div>

    <div class="vs-body cb-body" data-body></div>
    <noscript><div class="os-panel"><p>The combat simulation needs JavaScript. Every target's abilities and history are on their files in the <a href={u('/targets/')}>target register</a>.</p></div></noscript>
    <p class="os-label cb-credit">{PHOTO_CREDIT}</p>
  </section>
  <script type="application/json" id="vs-data" is:inline set:html={data} />
</OS>

<style is:global>
  .cb { overflow-x: clip; }
  .cb-simline { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0 0 12px; min-height: 1.6em; }
  .cb-simline b { font-weight: 700; }
  .cb-simline span { color: var(--os-text); overflow-wrap: anywhere; }

  /* THE CHAMBER: target A, the radar, target B */
  .cb-stage { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr) minmax(0, 1fr); gap: var(--os-gap); align-items: start; }
  .vs-flash { position: absolute; inset: 0; z-index: 5; pointer-events: none; opacity: 0; background: radial-gradient(closest-side, rgba(205, 245, 223, 0.7), rgba(61, 255, 143, 0.22) 60%, transparent); }
  .vs-shock { position: absolute; left: 50%; top: 40px; width: 150px; height: 150px; margin: -75px 0 0 -75px; border-radius: 50%; border: 2px solid var(--os-green); box-shadow: 0 0 0 8px rgba(61, 255, 143, 0.12); opacity: 0; pointer-events: none; z-index: 4; }
  .cb-side { position: relative; min-width: 0; display: flex; flex-direction: column; border: 1px solid var(--os-line); background: var(--os-panel); container-type: inline-size; }
  .cb-side::before, .cb-side::after { content: ''; position: absolute; z-index: 3; width: 12px; height: 12px; border: 1.5px solid var(--os-green); pointer-events: none; }
  .cb-side::before { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .cb-side::after { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }
  .cb-side[data-side='b']::before, .cb-side[data-side='b']::after { border-color: var(--os-amber); }
  .cb-side[data-side='b'] { border-color: rgba(255, 179, 71, 0.28); }
  /* the v1 card's photo stays in the markup but the scanner replaces it */
  .cb-side > img { display: none; }

  .cb-scan { position: relative; order: 0; aspect-ratio: 4 / 5; overflow: hidden; background: radial-gradient(circle at 50% 35%, rgba(61, 255, 143, 0.09), transparent 70%); border-bottom: 1px solid var(--os-line); }
  .cb-side[data-side='b'] .cb-scan { background: radial-gradient(circle at 50% 35%, rgba(255, 179, 71, 0.07), transparent 70%); border-bottom-color: rgba(255, 179, 71, 0.28); }
  .cb-scan canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .cb-still { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; }
  .cb-scan.still .cb-still { opacity: 1; filter: grayscale(1) sepia(1) hue-rotate(80deg) saturate(2) brightness(1.3); }
  .cb-scan.still canvas { display: none; }
  .cb-scan .os-reticle { width: 88px; height: 88px; margin: -44px 0 0 -44px; z-index: 2; }
  .cb-scan .os-reticle .lock { position: absolute; left: 100%; top: 50%; white-space: nowrap; margin-left: 10px; opacity: 0; transition: opacity 0.3s; }
  .cb-scan .os-reticle.locked .lock { opacity: 1; }
  .cb-side[data-side='b'] .os-reticle svg * { stroke: var(--os-amber); }
  .cb-side[data-side='b'] .os-reticle svg circle[r='3'] { fill: var(--os-amber); }
  .cb-side[data-side='b'] .os-reticle .lock { color: var(--os-amber); text-shadow: none; }
  .cb-st { position: absolute; left: 10px; bottom: 8px; z-index: 2; }
  .cb-tag { position: absolute; left: 10px; top: 8px; z-index: 2; color: var(--os-green); }
  .cb-side[data-side='b'] .cb-tag { left: auto; right: 10px; color: var(--os-amber); }
  .cb-side[data-side='b'] .cb-st { left: auto; right: 10px; color: var(--os-amber); text-shadow: none; }

  /* the v1 card's identity, under the scan */
  .vs-info { order: 1; display: grid; grid-template-columns: minmax(0, 1fr); gap: 4px; padding: 12px 14px 12px; }
  .vs-alias { margin: 0; font-size: 10.5px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--os-green); }
  .vs-name { margin: 0; font-family: var(--os-display); font-weight: 700; text-transform: uppercase; line-height: 0.95; letter-spacing: 0.01em; color: var(--os-text);
    font-size: max(14px, min(40px, calc((100cqi - 28px) / (var(--lw, 8) * 0.7)))); overflow-wrap: break-word; }
  .vs-meta { margin: 0; font-size: 11.5px; color: var(--os-dim); }
  .vs-type { justify-self: start; font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; border: 1px solid var(--os-line-hi); color: var(--os-green); padding: 2px 6px; }
  .vs-open { justify-self: start; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; margin-top: 2px; }
  .vs-open:hover { text-decoration: underline; }
  .cb-side[data-side='b'] .vs-alias, .cb-side[data-side='b'] .vs-type, .cb-side[data-side='b'] .vs-open { color: var(--os-amber) !important; border-color: rgba(255, 179, 71, 0.5); }
  /* documented feats, one at a time: every feat in one grid cell, so the panel is as tall as the longest */
  .vs-feat { order: 2; display: grid; margin: 0 14px 14px; padding: 10px 12px; border: 1px dashed var(--os-line); background: rgba(2, 5, 4, 0.5); }
  .vs-feat { grid-template-rows: auto 1fr; }
  .vs-feat::before { content: 'Intercept // documented feat'; grid-area: 1 / 1; align-self: start; font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--os-dim); }
  .feat { grid-area: 2 / 1; margin: 0; padding-top: 6px; font-size: 12px; line-height: 1.5; color: var(--os-text); opacity: 0; transform: translateY(6px); transition: opacity 0.5s, transform 0.5s cubic-bezier(.2,.8,.2,1), visibility 0.5s; }
  .feat.on { opacity: 1; transform: none; }
  .feat:not(.on) { visibility: hidden; }
  .feat .where, .cb-body .where { display: inline-block; font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; border: 1px solid var(--os-line); color: var(--os-dim); padding: 1px 6px; margin: 0 6px 4px 0; }
  .feat .where.screen, .cb-body .where.screen { color: var(--os-green); border-color: var(--os-line-hi); }
  .feat a { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--os-green-2) !important; }

  /* the middle: the badge, the simulate flash and the power grid overlay */
  .cb-mid { position: relative; display: grid; justify-items: center; gap: 10px; min-width: 0; }
  .vs-badge { font-family: var(--os-display); font-weight: 700; font-size: clamp(30px, 3.6vw, 52px); line-height: 1; letter-spacing: 0.08em; color: var(--os-green); text-shadow: var(--os-glow); will-change: transform; }
  .cb-simtag { position: absolute; left: 0; right: 0; top: 4px; margin: 0 auto; width: max-content; z-index: 6; font-family: var(--os-display); font-size: clamp(18px, 2.4vw, 30px); letter-spacing: 0.3em; text-transform: uppercase; color: #021008; background: var(--os-green); padding: 4px 10px 4px 14px; white-space: nowrap; opacity: 0; pointer-events: none; }
  .cb-radar { width: 100%; box-sizing: border-box; }
  .cb-radar-host { min-height: 120px; display: grid; place-items: center; }
  .cb-radar-host .radar { max-width: 320px; }
  .cb-radar-host.only-b .rp { fill: rgba(255, 179, 71, 0.12); stroke: var(--os-amber); stroke-dasharray: 3 2; filter: none; }
  .cb-radar-host.only-b .rd { fill: var(--os-amber); }
  .cb-radar-host .none { margin: 0; color: var(--os-dim); text-align: center; font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; padding: 30px 0; }
  .cb-legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 16px; margin: 6px 0 0; font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; }
  .cb-legend span { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
  .cb-legend i { width: 18px; height: 0; border-top: 2px solid var(--os-green); }
  .cb-legend .lb i { border-top: 2px dashed var(--os-amber); }
  .cb-legend .la b { color: var(--os-green); font-weight: 400; } .cb-legend .lb b { color: var(--os-amber); font-weight: 400; }
  .cb-legend span[hidden] { display: none; }
  .cb-note { margin: 8px 0 0; font-size: 10.5px; color: var(--os-dim); text-align: center; }
  .cb-v1radar { display: none; }

  /* SELECT TARGETS */
  .cb-pick, .cb-two, .cb-body { margin-top: var(--os-gap); }
  .cb-pick-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-bottom: 12px; }
  .cb-slots { display: flex; gap: 4px; }
  .cb-slot { font: inherit; font-size: 10.5px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--os-text); background: rgba(61, 255, 143, 0.04); border: 1px solid var(--os-line); padding: 8px 11px; min-height: 36px; cursor: pointer; }
  .cb-slot[data-slot='a'][aria-pressed='true'] { background: var(--os-green); border-color: var(--os-green); color: #021008; }
  .cb-slot[data-slot='b'][aria-pressed='true'] { background: var(--os-amber); border-color: var(--os-amber); color: #120b00; }
  .cb-tool { padding: 8px 11px; font-size: 10px; min-height: 36px; }
  .cb-roster { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(78px, 1fr)); gap: 6px; }
  .cb-roster button { position: relative; width: 100%; height: 100%; box-sizing: border-box; display: grid; justify-items: center; align-content: start; gap: 3px; padding: 6px 4px 8px; font: inherit; color: var(--os-text); background: rgba(61, 255, 143, 0.02); border: 1px solid var(--os-line); cursor: pointer; transition: border-color 0.2s, background 0.2s; }
  .cb-roster button:hover, .cb-roster button:focus-visible { border-color: var(--os-line-hi); }
  .cb-tile { display: block; width: 56px; height: 56px; overflow: hidden; background: rgba(61, 255, 143, 0.06); }
  .cb-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cb-tile > span { display: grid; place-items: center; height: 100%; font-family: var(--os-display); font-size: 20px; color: var(--os-green); }
  .cb-roster i { font-style: normal; font-size: 8.5px; letter-spacing: 0.14em; }
  .cb-roster b { font-weight: 700; font-size: 9.5px; line-height: 1.2; letter-spacing: 0.06em; text-transform: uppercase; text-align: center; overflow-wrap: anywhere; color: var(--os-dim); }
  .cb-roster button.is-a { border-color: var(--os-green); background: rgba(61, 255, 143, 0.12); }
  .cb-roster button.is-b { border-color: var(--os-amber); background: rgba(255, 179, 71, 0.1); }
  .cb-roster button.is-a b, .cb-roster button.is-b b { color: var(--os-text); }
  .cb-roster button.is-a img, .cb-roster button.is-b img { filter: none; }
  .cb-roster button.is-a::after, .cb-roster button.is-b::after { position: absolute; right: 3px; top: 3px; font-size: 8.5px; font-weight: 700; padding: 0 4px; color: #021008; }
  .cb-roster button.is-a::after { content: 'A'; background: var(--os-green); }
  .cb-roster button.is-b::after { content: 'B'; background: var(--os-amber); }

  /* FAN VOTE and MOST-WANTED */
  .cb-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: var(--os-gap); align-items: start; }
  .cb-board[hidden] { display: none; }
  .cb-vote { display: grid; gap: 10px; }
  .cb-vote-q { margin: 0; font-family: var(--os-display); font-weight: 700; text-transform: uppercase; font-size: clamp(22px, 2.6vw, 34px); line-height: 1; color: var(--os-text); }
  .cb-vote-sub { margin: 0; color: var(--os-dim); font-size: 12px; }
  .vote-btns { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .cb-vbtn { font: inherit; flex: 1 1 140px; min-width: 0; min-height: 48px; padding: 10px 14px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--os-green); background: rgba(61, 255, 143, 0.06); border: 1px solid var(--os-line-hi); cursor: pointer; overflow-wrap: anywhere; transition: background 0.2s, color 0.2s; }
  .cb-vbtn[data-v='b'] { color: var(--os-amber); background: rgba(255, 179, 71, 0.06); border-color: rgba(255, 179, 71, 0.6); }
  .cb-vbtn:hover, .cb-vbtn:focus-visible { background: var(--os-green); color: #021008; outline: none; }
  .cb-vbtn[data-v='b']:hover, .cb-vbtn[data-v='b']:focus-visible { background: var(--os-amber); color: #120b00; }
  .vs-vote.voting .vote-btns button { opacity: 0.45; pointer-events: none; }
  .vs-vote.voted .vote-btns, .vs-vote.vote-off .vote-btns, .vs-vote.vote-off .vote-peek, .vs-vote.voted .vote-peek { display: none; }
  .vote-status { margin: 0; min-height: 1.4em; color: var(--os-green); font-size: 12px; }
  .vote-status:empty { min-height: 0; }
  .vote-result { display: grid; gap: 6px; }
  .vote-result[hidden] { display: none; }
  .vote-result .split { position: relative; height: 14px; border: 1px solid var(--os-line); background: rgba(61, 255, 143, 0.05); overflow: hidden; }
  .vote-result .split i, .lb-split i { position: absolute; top: 0; bottom: 0; width: 100%; }
  .vote-result .sa, .lb-split .sa { left: 0; transform-origin: left; background: repeating-linear-gradient(90deg, var(--os-green) 0 6px, transparent 6px 8px); }
  .vote-result .sb, .lb-split .sb { right: 0; transform-origin: right; background: repeating-linear-gradient(90deg, var(--os-amber) 0 6px, transparent 6px 8px); opacity: 0.9; }
  .split-nums { display: flex; justify-content: space-between; gap: 10px; margin: 0; font-size: 12px; }
  .split-nums span { min-width: 0; overflow-wrap: anywhere; }
  .split-nums span:first-child b { color: var(--os-green); } .split-nums span:last-child { text-align: right; } .split-nums span:last-child b { color: var(--os-amber); }
  .split-nums b { font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .split-total { margin: 0; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--os-dim); }
  .vote-ts:empty { display: none; }
  .vote-note { margin: 0; font-size: 11px; color: var(--os-dim); }
  .vote-peek { font: inherit; font-size: 11px; color: var(--os-green); background: none; border: 0; padding: 0; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }


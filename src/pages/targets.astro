---
// DOOM-OS module 01, the target register: every target on file, to be judged by His Majesty.
import OS from '../layouts/OS.astro';
import Register from '../components/Register.astro';
---
<OS title="Target register" page="targets" description="All 29 confirmed characters in Avengers: Doomsday, filed by Doctor Doom's surveillance system: team, threat from Marvel's power grid, and first appearance.">
  <div class="mod-head">
    <div>
      <h1 class="os-display os-hi mod-title op-count"><b>29</b> <span>targets on file</span></h1>
      <p class="mod-sub">Every being who will stand in Your Majesty's way on 18 December, as Marvel has confirmed them. Open a file to examine a target and pass judgement.</p>
    </div>
    <p class="os-label">Your verdicts are kept on this device &middot; fan opinion, not fact</p>
  </div>
  <Register />
</OS>

---
// The threat dial: a half gauge in the four fan bands (scripts/os/threat.ts: Nuisance, Rival, Nemesis, Worthy of Doom,
// a quarter each), with a needle that swings to the fans' average. The page fills it in once the ratings arrive
// (`setDial`); until then, or below three ratings, it shows no needle.
interface Props { f?: number | null; band?: string; size?: 's' | 'l' }
const { f = null, band = 'awaiting', size = 's' } = Astro.props;
const R = 84, C = 100;
const pt = (k: number, r = R) => { const a = Math.PI * (1 - k); return [C + r * Math.cos(a), C - r * Math.sin(a)].map((n) => n.toFixed(2)).join(' '); };
const arc = (a: number, b: number) => `M ${pt(a)} A ${R} ${R} 0 0 1 ${pt(b)}`;
const segs = ['nuisance', 'rival', 'nemesis', 'worthy'].map((id, i) => ({ id, from: i / 4 + 0.01, to: (i + 1) / 4 - 0.01 }));
---
<svg class={`tdial tdial-${size}${f === null ? '' : ' swing'}`} data-band={band} data-f={f === null ? undefined : ''} viewBox="0 0 200 112" role="img" aria-label="Threat to Doom, rated by fans" style={f === null ? '' : `--f:${f.toFixed(4)}`}>
  {segs.map((s) => <path class={`seg seg-${s.id}`} d={arc(s.from, s.to)} />)}
  {size === 'l' && [0.25, 0.5, 0.75].map((k) => <path class="tick" d={`M ${pt(k, R - 13)} L ${pt(k, R - 7)}`} />)}
  <g class="needle">
    <path d={`M ${C} ${C - 3.2} L ${C - R + 10} ${C} L ${C} ${C + 3.2} Z`} />
    <circle cx={C} cy={C} r="6.5" />
  </g>
</svg>

<style is:global>
  .tdial { display: block; overflow: visible; }
  .tdial .seg { fill: none; stroke-width: 12; stroke-linecap: butt; opacity: 0.22; }
  .tdial-s .seg { stroke-width: 16; }
  .tdial .seg-nuisance { stroke: var(--os-dim); color: var(--os-dim); }
  .tdial .seg-rival { stroke: var(--os-green); color: var(--os-green); }
  .tdial .seg-nemesis { stroke: var(--os-amber); color: var(--os-amber); }
  .tdial .seg-worthy { stroke: var(--os-red); color: var(--os-red); }
  /* the fans' band lights up; Doom, the measure, lights them all */
  .tdial[data-band='nuisance'] .seg-nuisance, .tdial[data-band='rival'] .seg-rival, .tdial[data-band='nemesis'] .seg-nemesis, .tdial[data-band='worthy'] .seg-worthy { opacity: 1; filter: drop-shadow(0 0 4px currentColor); }
  .tdial[data-band='sovereign'] .seg { opacity: 0.6; }
  .tdial .tick { stroke: var(--os-dim); stroke-width: 1.4; }
  .tdial .needle { fill: var(--os-text); transform-box: view-box; transform-origin: 100px 100px; transform: rotate(calc(var(--f, 0) * 180deg)); }
  .tdial:not([data-f]) .needle { display: none; }
  .tdial .needle circle { fill: #021008; stroke: var(--os-text); stroke-width: 2; }
  /* the needle swings past its mark and settles, like a heavy instrument */
  .tdial.swing .needle { animation: tdial-sweep 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both; }
  @keyframes tdial-sweep { 0% { transform: rotate(0deg); } 70% { transform: rotate(calc(var(--f) * 180deg + 6deg)); } 100% { transform: rotate(calc(var(--f) * 180deg)); } }
  @media (prefers-reduced-motion: reduce) { .tdial.swing .needle { animation: none; } }
</style>

---
// The site layout, design system v2 (the Latverian dossier). Every page uses it since the switch on
// 26 October 2026; the v1 layout (Base.astro) is no longer used by any page.
import '@fontsource-variable/big-shoulders-display';
import '@fontsource/courier-prime/400.css';
import '@fontsource/courier-prime/700.css';
import '@fontsource-variable/inter-tight';
import '../styles/system.css';
import { TEAMS, CAST, isPublished, displayName, u } from '../data/site';
import { PHOTO_CREDIT } from '../data/photos';
import { accentOf } from '../data/v2';

interface Props {
  title: string;
  description: string;
  page: 'archive' | 'file' | 'team' | 'timeline' | 'arena' | 'catchup' | 'predictions' | 'quiz' | 'about' | 'credits';
  accent?: string;
  styleVars?: string;
  /** false for a page that brings its own renderer (the home page's forge) */
  gl?: boolean;
}
const { title, description, page, accent, styleVars = '', gl = true } = Astro.props;
const vars = [accent ? `--accent:${accent}` : '', styleVars].filter(Boolean).join(';');
const fullTitle = page === 'archive' ? 'Doomsday Dossier: an unofficial fan briefing for Avengers: Doomsday' : `${title} | Doomsday Dossier`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const NAV = [['/timeline/', 'Timeline'], ['/versus/', 'Arena'], ['/catch-up/', 'Catch-up'], ['/predictions/', 'Predict'], ['/quiz/', 'Quiz']];
const PAGES = [['/', 'The archive'], ['/timeline/', 'Timeline'], ['/versus/', 'Fight arena'], ['/catch-up/', 'Catch-up planner'], ['/predictions/', 'Prediction board'], ['/quiz/', 'Which hero are you?'], ['/about/', 'Sources and rules'], ['/credits/', 'Image credits']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1012" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // A cached page asking for files a deploy removed (CSS and JS are renamed on every deploy) reloads once.
      (function () {
        var KEY = 'dd-asset-reload';
        function again() {
          try { var t = +sessionStorage.getItem(KEY) || 0; if (Date.now() - t < 60000) return; sessionStorage.setItem(KEY, String(Date.now())); } catch (e) { return; }
          location.reload();
        }
        addEventListener('error', function (e) {
          var t = e.target;
          if (t && ((t.tagName === 'LINK' && /stylesheet|modulepreload/.test(t.rel)) || t.tagName === 'SCRIPT') && (t.href || t.src || '').indexOf('/_astro/') !== -1) again();
        }, true);
        addEventListener('unhandledrejection', function (e) {
          if (/dynamically imported module|Importing a module script failed|error loading dynamically imported/i.test(String(e.reason && e.reason.message))) again();
        });
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('rm');
        try { if (sessionStorage.getItem('dd-pt') === '1') document.documentElement.classList.add('pt-in'); } catch (e) {}
      })();
    </script>
  </head>
  <body data-page={page} data-gl={gl ? 'on' : 'off'} style={vars}>
    <a class="skip" href="#main">Skip to content</a>
    <div class="pt" data-pt aria-hidden="true"><span class="pt-mark"><i></i>Doomsday Dossier</span><span class="pt-name t-label" data-pt-name></span></div>
    {gl && <canvas id="dx-gl" aria-hidden="true"></canvas>}
    <div class="grain" aria-hidden="true"></div>
    <header class="dx-hdr">
      <a class="dx-mark" href={u('/')}><i></i><span>Doomsday Dossier</span></a>
      <div class="dx-hdr-right">
        <nav class="dx-nav" aria-label="Features">{NAV.map(([h, l]) => <a href={u(h)}>{l}</a>)}</nav>
        <span class="dx-unofficial" title="Not affiliated with or endorsed by Marvel or Disney">Unofficial<span class="dx-more"> fan site</span></span>
        <button type="button" class="dx-sound" data-sound aria-pressed="false"><i aria-hidden="true"></i><span>Sound on</span></button>
        <button type="button" class="dx-menu-btn" data-menu-toggle aria-expanded="false" aria-controls="dx-menu"><span>Index</span><i aria-hidden="true"></i></button>
      </div>
    </header>

    <!-- the index: every page, team and file, sliding down over the page -->
    <nav class="dx-menu" id="dx-menu" data-menu aria-label="Site index" hidden>
      <div class="dx-menu-in wrap">
        <div class="dx-menu-pages">
          <p class="t-label t-accent">Dossier</p>
          <ul>{PAGES.map(([h, l]) => <li data-menu-in><a href={u(h)}>{l}</a></li>)}</ul>
        </div>
        <div class="dx-menu-teams">
          {TEAMS.map((t) => (
            <div data-menu-in>
              <p class="t-label"><a href={u(`/teams/${t.id}/`)}>{t.name}</a></p>
              <ul>
                {CAST.filter((c) => c.team === t.id).map((c) =>
                  isPublished(c.slug)
                    ? <li><a href={u(`/c/${c.slug}/`)} style={`--a:${accentOf(c.slug!)}`}>{displayName(c)}</a></li>
                    : <li><span>{displayName(c)}</span></li>
                )}
              </ul>
            </div>
          ))}
        </div>
        <p class="dx-menu-foot t-micro t-ash">Avengers: Doomsday is in theaters 18 December 2026 &middot; Unofficial. Not affiliated with Marvel or Disney.</p>
      </div>
    </nav>

    <main id="main">
      <slot />
    </main>
    <footer class="dx-foot">
      <div class="wrap">
        <p class="t-label t-accent" style="margin-bottom: 14px">Unofficial fan site</p>
        <p><strong>Doomsday Dossier is an unofficial, non-commercial fan project.</strong> It is not affiliated with, endorsed by or sponsored by Marvel, Marvel Studios or The Walt Disney Company. All character names, related marks and images belong to their owners. {PHOTO_CREDIT} Any image will be removed on request: <a href="https://github.com/prejith77/doomsday-dossier/issues" rel="noopener" target="_blank">open an issue</a> and it comes down. No Marvel logos are used as design elements.</p>
        <p>Film facts come only from Marvel announcements. Character history comes from the Marvel Fandom wiki, the Marvel Cinematic Universe Wiki and the named films and comics, rewritten in our own words.</p>
        <p>Avengers: Doomsday is in theaters 18 December 2026. <a href={u('/about/')}>Sources and rules</a> &middot; <a href={u('/credits/')}>Image credits</a></p>
      </div>
    </footer>
    <script>
      import '../scripts/dossier/main';
    </script>
  </body>
</html>
